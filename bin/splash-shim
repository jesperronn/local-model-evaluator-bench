#!/usr/bin/env python3
"""
Buffering shim between Olla and splash.

Olla forwards request bodies with Transfer-Encoding: chunked; splash rejects
those with 400 "transfer encoding is not supported". This shim reads the full
request body (chunked or not), forwards it upstream with a plain Content-Length,
and streams the response back chunk by chunk (SSE stays unbuffered).

Usage: bin/splash-shim            (env: SPLASH_SHIM_PORT, SPLASH_PORT)
"""
import http.client
import os
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LISTEN_HOST = os.environ.get("SPLASH_SHIM_HOST", "127.0.0.1")
LISTEN_PORT = int(os.environ.get("SPLASH_SHIM_PORT", "8003"))
UP_HOST = os.environ.get("SPLASH_HOST", "127.0.0.1")
UP_PORT = int(os.environ.get("SPLASH_PORT", "8002"))
HOP = {"connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te",
       "trailer", "transfer-encoding", "upgrade", "content-length", "host"}


class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *a):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % a))

    def _read_body(self):
        if "chunked" in self.headers.get("Transfer-Encoding", "").lower():
            out = bytearray()
            while True:
                size = int(self.rfile.readline().split(b";")[0].strip() or b"0", 16)
                if size == 0:
                    while self.rfile.readline() not in (b"\r\n", b"\n", b""):
                        pass  # trailers
                    return bytes(out)
                out += self.rfile.read(size)
                self.rfile.readline()
        n = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(n) if n else b""

    def _proxy(self):
        body = self._read_body()
        hdrs = {k: v for k, v in self.headers.items() if k.lower() not in HOP}
        hdrs["Host"] = "%s:%d" % (UP_HOST, UP_PORT)
        if body or self.command in ("POST", "PUT", "PATCH"):
            hdrs["Content-Length"] = str(len(body))
        conn = http.client.HTTPConnection(UP_HOST, UP_PORT, timeout=1800)
        try:
            conn.request(self.command, self.path, body=body or None, headers=hdrs)
            r = conn.getresponse()
        except Exception as e:
            msg = ('{"error":{"message":"splash-shim upstream error: %s"}}' % e).encode()
            self.send_response(502)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(msg)))
            self.end_headers()
            self.wfile.write(msg)
            return
        self.send_response(r.status, r.reason)
        for k, v in r.getheaders():
            if k.lower() not in HOP:
                self.send_header(k, v)
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()
        try:
            while True:
                chunk = r.read1(65536)
                if not chunk:
                    break
                self.wfile.write(b"%x\r\n%s\r\n" % (len(chunk), chunk))
                self.wfile.flush()
            self.wfile.write(b"0\r\n\r\n")
            self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            self.close_connection = True
        finally:
            conn.close()

    do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_OPTIONS = do_HEAD = _proxy


if __name__ == "__main__":
    ThreadingHTTPServer.daemon_threads = True
    srv = ThreadingHTTPServer((LISTEN_HOST, LISTEN_PORT), H)
    print("splash-shim %s:%d -> %s:%d" % (LISTEN_HOST, LISTEN_PORT, UP_HOST, UP_PORT), flush=True)
    srv.serve_forever()
