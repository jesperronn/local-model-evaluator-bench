#!/usr/bin/env bash
# bin/lmstudio-context — verify/fix LM Studio's UI default context window.
#
# bin/smoke and bin/bench always pass an explicit `-c $SMOKE_CTX` to `lms load`,
# so scored runs are unaffected by this setting. It only matters when a model
# is loaded via the LM Studio app (e.g. its "New Chat" model picker), which
# falls back to ~/.lmstudio/settings.json's defaultContextLength. If that's
# left at LM Studio's factory default of a fixed 4096, large-context models
# (e.g. ornith-1.0-35b, 256k native) get silently truncated and error out on
# any prompt over ~4k tokens.
#
# Required setting: defaultContextLength.type == "max" ("Model maximum" in the
# LM Studio UI) — each model gets its own actual max context, never a fixed
# cap that's wrong for some models and wasteful for others.
#
# Usage:
#   bin/lmstudio-context verify   # check only, exit 1 if not set to "max"
#   bin/lmstudio-context fix      # set defaultContextLength.type to "max"
set -euo pipefail

SETTINGS_FILE="$HOME/.lmstudio/settings.json"

CMD="${1:-verify}"

[ -f "$SETTINGS_FILE" ] || { echo "Error: LM Studio settings not found at $SETTINGS_FILE" >&2; exit 1; }

current_type() { jq -r '.defaultContextLength.type // empty' "$SETTINGS_FILE"; }

case "$CMD" in
  verify)
    t="$(current_type)"
    if [ "$t" = "max" ]; then
      echo "✓ LM Studio defaultContextLength.type = max (Model maximum)"
    else
      echo "⚠️  LM Studio defaultContextLength.type = ${t:-not set} (expected: max)"
      echo "    models opened from the LM Studio UI (not via bin/smoke/bin/bench) will be"
      echo "    capped at a fixed context length instead of each model's real maximum."
      echo "    fix: bin/lmstudio-context fix"
      exit 1
    fi
    ;;
  fix)
    t="$(current_type)"
    echo "Current defaultContextLength.type: ${t:-not set}"
    cp "$SETTINGS_FILE" "$SETTINGS_FILE.backup"
    echo "Backed up to $SETTINGS_FILE.backup"
    jq '.defaultContextLength = {"type": "max"}' \
      "$SETTINGS_FILE" > "$SETTINGS_FILE.tmp" && mv "$SETTINGS_FILE.tmp" "$SETTINGS_FILE"
    echo "Updated defaultContextLength.type: $(current_type)"
    echo
    echo "✓ Restart LM Studio (or: lms daemon down && lms daemon up) for this to take effect."
    ;;
  *)
    echo "usage: $(basename "$0") verify|fix" >&2
    exit 2
    ;;
esac
