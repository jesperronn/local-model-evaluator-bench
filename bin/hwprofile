#!/usr/bin/env bash
# hwprofile — comprehensive hardware detection for local agent benchmarking.
#
# Detects machine specs to help participants understand their capacity for
# running local models. No elevated permissions required. Works on macOS,
# Linux, and Windows (Git Bash/WSL/Cygwin).
#
# Usage:
#   hwprofile              human-readable detailed specs
#   hwprofile --full       specs + installed models and disk usage
#   hwprofile --json       machine-readable JSON for tooling
#   hwprofile --minimal    compact one-liner
#
# Also buckets total RAM into benchmarked tiers (24/32/48/64/128 GB).
# When distributed as a gist: curl <url> | bash
#
set -uo pipefail

# Tiers: "benchmarked" tiers have real data; others are placeholders.
TIERS=(24 32 48 64 128)
BENCHMARKED_TIERS=(32 128)

# OS detection
_detect_os() {
  case "$(uname -s)" in
    Darwin)  echo "macos" ;;
    Linux)   echo "linux" ;;
    MINGW*|MSYS*|CYGWIN*)  echo "windows" ;;
    *)       echo "unknown" ;;
  esac
}

# RAM: total (GB)
_total_ram_gb() {
  local os="$1" bytes
  case "$os" in
    macos)
      bytes=$(sysctl -n hw.memsize 2>/dev/null) || return 1
      awk -v b="$bytes" 'BEGIN { printf "%.0f", b/1073741824 }'
      ;;
    linux)
      awk '/^MemTotal:/ {printf "%.0f", $2/1048576}' /proc/meminfo 2>/dev/null || return 1
      ;;
    windows)
      wmic OS get TotalVisibleMemorySize 2>/dev/null | tail -1 | awk '{printf "%.0f", $1/1048576}' || return 1
      ;;
    *)
      return 1
      ;;
  esac
}

# RAM: used (GB) - best-effort
_used_ram_gb() {
  local os="$1" total free
  case "$os" in
    macos)
      total=$(sysctl -n hw.memsize 2>/dev/null) || return 1
      free=$(vm_stat 2>/dev/null | awk '/Pages free:/ {print $3}' | tr -d '.')
      [[ -z "$free" ]] && return 1
      awk -v t="$total" -v f="$free" 'BEGIN {printf "%.0f", (t - f*4096)/1073741824}'
      ;;
    linux)
      awk '/^MemAvailable:/ {avail=$2} /^MemTotal:/ {total=$2} END {printf "%.0f", (total-avail)/1048576}' /proc/meminfo 2>/dev/null || return 1
      ;;
    windows)
      wmic OS get FreePhysicalMemory 2>/dev/null | tail -1 | awk -v total="$(wmic OS get TotalVisibleMemorySize 2>/dev/null | tail -1)" '{printf "%.0f", (total-$1)/1048576}' || return 1
      ;;
    *)
      return 1
      ;;
  esac
}

# CPU: model name
_cpu_model() {
  local os="$1"
  case "$os" in
    macos)
      sysctl -n machdep.cpu.brand_string 2>/dev/null || echo "Unknown"
      ;;
    linux)
      grep "^model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs || echo "Unknown"
      ;;
    windows)
      wmic CPU get Name 2>/dev/null | tail -1 | xargs || echo "Unknown"
      ;;
    *)
      echo "Unknown"
      ;;
  esac
}

# CPU: core count
_cpu_cores() {
  local os="$1"
  case "$os" in
    macos)
      sysctl -n hw.ncpu 2>/dev/null || echo "unknown"
      ;;
    linux)
      nproc 2>/dev/null || grep -c "^processor" /proc/cpuinfo 2>/dev/null || echo "unknown"
      ;;
    windows)
      wmic CPU get NumberOfCores 2>/dev/null | tail -1 | xargs || echo "unknown"
      ;;
    *)
      echo "unknown"
      ;;
  esac
}

# CPU: base frequency (GHz)
_cpu_freq_ghz() {
  local os="$1" freq
  case "$os" in
    macos)
      # Try hw.cpufrequency_max (Intel), then hw.cpufrequency
      freq=$(sysctl -n hw.cpufrequency_max 2>/dev/null)
      if [[ -z "$freq" ]] || [[ "$freq" == "0" ]]; then
        freq=$(sysctl -n hw.cpufrequency 2>/dev/null)
      fi
      # If still nothing, try extracting from system_profiler (Apple Silicon may have GHz in description)
      if [[ -z "$freq" ]] || [[ "$freq" == "0" ]]; then
        freq=$(system_profiler SPHardwareDataType 2>/dev/null | grep -i "cpu frequency" | grep -oE "[0-9.]+ GHz" | head -1 | awk '{print $1 * 1000000000}')
      fi
      [[ -n "$freq" && "$freq" != "0" ]] && awk -v f="$freq" 'BEGIN {printf "%.1f", f/1000000000}' || echo "N/A"
      ;;
    linux)
      grep "^cpu MHz" /proc/cpuinfo 2>/dev/null | head -1 | awk '{printf "%.1f", $2/1000}' || echo "N/A"
      ;;
    windows)
      wmic CPU get MaxClockSpeed 2>/dev/null | tail -1 | awk '{printf "%.1f", $1/1000}' || echo "N/A"
      ;;
    *)
      echo "N/A"
      ;;
  esac
}

# Disk: free space (human-readable)
_disk_free_human() {
  local os="$1" size
  case "$os" in
    macos|linux)
      df -h / 2>/dev/null | tail -1 | awk '{print $4}'
      ;;
    windows)
      local drive="${SYSTEMDRIVE:-C:}"
      wmic logicaldisk where "name='${drive}'" get FreeSpace 2>/dev/null | tail -1 | awk '{printf "%.0fGB", $1/1073741824}'
      ;;
    *)
      echo "unknown"
      ;;
  esac
}

# Username and hostname
_username() {
  echo "${USER:-$(whoami)}"
}

_hostname() {
  hostname 2>/dev/null || echo "unknown"
}

# Nearest tier by absolute distance; ties favor the smaller tier (conservative)
_nearest_tier() {
  local ram="$1" best="" best_dist=""
  for t in "${TIERS[@]}"; do
    local dist=$(( ram > t ? ram - t : t - ram ))
    if [[ -z "$best" || "$dist" -lt "$best_dist" ]]; then
      best="$t"; best_dist="$dist"
    fi
  done
  echo "$best"
}

_is_benchmarked() {
  local tier="$1"
  for t in "${BENCHMARKED_TIERS[@]}"; do
    [[ "$t" == "$tier" ]] && echo "true" && return
  done
  echo "false"
}

# Detect Apple Silicon (macOS + "Apple" in CPU model)
_is_apple_silicon() {
  local os="$1" cpu_model="$2"
  [[ "$os" == "macos" ]] && [[ "$cpu_model" =~ Apple ]] && echo "true" || echo "false"
}

# Compute recommended GPU wired memory cap (MB) for Apple Silicon
# Leaves 4 GB for the OS; only suggests if total RAM >= 16 GB
_gpu_wired_mem_cap_mb() {
  local ram_gb="$1"
  if [[ "$ram_gb" != "N/A" ]] && (( ram_gb >= 16 )); then
    awk -v gb="$ram_gb" 'BEGIN { printf "%.0f", (gb - 4) * 1024 }'
  else
    echo ""
  fi
}

# Model discovery: LMS
_lms_models_info() {
  # Returns: count total_gb (space-separated), or empty if LMS unavailable/no models
  local json
  json=$(command -v lms &>/dev/null && lms ls --json 2>/dev/null) || return 1
  [[ -z "$json" || "$json" == "[]" ]] && return 1

  local count total_gb
  # Use jq if available, else fall back to grep+awk
  if command -v jq &>/dev/null; then
    count=$(echo "$json" | jq 'length' 2>/dev/null)
    total_gb=$(echo "$json" | jq '[.[].sizeBytes] | add // 0' 2>/dev/null | awk '{printf "%.0f", $1/1073741824}')
  else
    count=$(echo "$json" | grep -o '"modelKey"' | wc -l)
    total_gb=$(echo "$json" | grep -o '"sizeBytes"[^,]*' | grep -o '[0-9]*' | awk '{sum+=$1} END {printf "%.0f", sum/1073741824}')
  fi

  [[ "$count" -gt 0 ]] && echo "$count $total_gb"
}

# Model discovery: Ollama
_ollama_models_info() {
  # Returns: count total_gb (space-separated), or empty if Ollama unavailable/no models
  local rows
  rows=$(command -v ollama &>/dev/null && ollama list 2>/dev/null | tail -n +2 | grep -v '^$') || return 1
  [[ -z "$rows" ]] && return 1

  local count total_gb
  count=$(echo "$rows" | wc -l | tr -d ' ')
  total_gb=$(echo "$rows" | awk '{
    v=$3; u=$4
    if (u=="GB") gb=v+0; else if (u=="MB") gb=v/1024; else gb=0
    t+=gb
  } END {printf "%.0f", t}')

  if [[ "$count" -gt 0 ]]; then
    echo "$count $total_gb"
  fi
}

# Model discovery: MLX (HuggingFace cache)
_mlx_models_info() {
  # Returns: "cached" if HF_HUB_CACHE exists with content, or empty
  local hf_cache="${HF_HUB_CACHE:-$HOME/.cache/huggingface/hub}"
  [[ -d "$hf_cache" && -n "$(find "$hf_cache" -type f 2>/dev/null | head -1)" ]] && echo "cached"
}

# Disk free space (GB)
_disk_free_gb_numeric() {
  local os="$1" size
  case "$os" in
    macos|linux)
      size=$(df -h / 2>/dev/null | tail -1 | awk '{print $4}' | sed 's/[GTM]i*//;s/[GTM]//')
      # Rough numeric extraction; return as-is for now
      echo "$size" | grep -o '^[0-9]*' || echo "?"
      ;;
    windows)
      wmic logicaldisk where "name='${SYSTEMDRIVE:-C:}'" get FreeSpace 2>/dev/null | tail -1 | awk '{printf "%.0f", $1/1073741824}' || echo "?"
      ;;
    *)
      echo "?"
      ;;
  esac
}

# RAM breakdown (macOS): total_gb used_gb free_gb wired_gb inactive_gb
_ram_gb_breakdown() {
  local os="$1"
  [[ "$os" != "macos" ]] && return 1

  local total page_size wired active speculative inactive free compressed
  total=$(sysctl -n hw.memsize 2>/dev/null) || return 1
  eval "$(vm_stat 2>/dev/null | awk '
    /page size of/              { ps = $8 }
    /Pages free:/               { gsub(/\./,"",$3); free=$3 }
    /Pages active:/             { gsub(/\./,"",$3); active=$3 }
    /Pages inactive:/           { gsub(/\./,"",$3); inactive=$3 }
    /Pages speculative/         { gsub(/\./,"",$3); spec=$3 }
    /Pages wired down/          { gsub(/\./,"",$4); wired=$4 }
    /Pages occupied by compressor/ { gsub(/\./,"",$5); comp=$5 }
    END { printf "page_size=%s wired=%s active=%s inactive=%s free=%s speculative=%s compressed=%s",
          ps, wired, active, inactive, free, spec, comp }')" || return 1

  local used=$(( (wired + active + compressed) * page_size ))
  local avail=$(( (free + speculative) * page_size ))
  local wired_b=$(( wired * page_size ))
  local inactive_b=$(( inactive * page_size ))
  awk -v tot="$total" -v used="$used" -v avail="$avail" \
      -v wired="$wired_b" -v inactive="$inactive_b" \
    'BEGIN { printf "%.0f %.0f %.0f %.0f %.0f",
             tot/1073741824, used/1073741824, avail/1073741824,
             wired/1073741824, inactive/1073741824 }'
}

# Runtime detection
_lms_up() {
  command -v lms &>/dev/null && lms_loaded_models &>/dev/null 2>&1
}

_lms_loaded_models() {
  command -v lms &>/dev/null && lms ps --json 2>/dev/null | grep -o '"identifier":"[^"]*' | cut -d'"' -f4
}

_ollama_up() {
  curl -fsS --max-time 2 http://localhost:11434/api/tags >/dev/null 2>&1
}

_ollama_loaded() {
  command -v ollama &>/dev/null && ollama ps 2>/dev/null | awk 'NR>1 && NF { print $1 }' || true
}

_mlx_up() {
  curl -fsS --max-time 2 http://localhost:8080/v1/models >/dev/null 2>&1
}

_mlx_loaded() {
  curl -fsS --max-time 2 http://localhost:8080/v1/models 2>/dev/null | grep -o '"id":"[^"]*' | head -1 | cut -d'"' -f4
}

# JSON output
_output_json() {
  local os="$1" ram_total ram_used cpu_model cpu_cores cpu_ghz disk_free tier benchmarked hostname username

  ram_total=$(_total_ram_gb "$os") || ram_total="N/A"
  ram_used=$(_used_ram_gb "$os") || ram_used="N/A"
  cpu_model=$(_cpu_model "$os")
  cpu_cores=$(_cpu_cores "$os")
  cpu_ghz=$(_cpu_freq_ghz "$os")
  disk_free=$(_disk_free_human "$os")
  hostname=$(_hostname)
  username=$(_username)

  [[ "$ram_total" != "N/A" ]] && tier=$(_nearest_tier "$ram_total") || tier="N/A"
  [[ "$tier" != "N/A" ]] && benchmarked=$(_is_benchmarked "$tier") || benchmarked="false"

  # Escape quotes in strings
  cpu_model="${cpu_model//\"/\\\"}"

  printf '{'
  printf '"os":"%s",' "$os"
  printf '"hostname":"%s",' "$hostname"
  printf '"username":"%s",' "$username"
  printf '"ram_gb":"%s",' "$ram_total"
  printf '"ram_used_gb":"%s",' "$ram_used"
  printf '"cpu":"%s",' "$cpu_model"
  printf '"cpu_cores":%s,' "$cpu_cores"
  printf '"cpu_ghz":"%s",' "$cpu_ghz"
  printf '"disk_free":"%s",' "$disk_free"
  printf '"ram_tier_gb":"%s",' "$tier"
  printf '"tier_benchmarked":%s' "$benchmarked"
  printf '}\n'
}

# Human-readable output
_output_human() {
  local os="$1" ram_total ram_used cpu_model cpu_cores cpu_ghz disk_free tier benchmarked hostname username is_apple_silicon gpu_cap_mb

  ram_total=$(_total_ram_gb "$os") || ram_total="N/A"
  ram_used=$(_used_ram_gb "$os") || ram_used="N/A"
  cpu_model=$(_cpu_model "$os")
  cpu_cores=$(_cpu_cores "$os")
  cpu_ghz=$(_cpu_freq_ghz "$os")
  disk_free=$(_disk_free_human "$os")
  hostname=$(_hostname)
  username=$(_username)

  [[ "$ram_total" != "N/A" ]] && tier=$(_nearest_tier "$ram_total") || tier="N/A"
  [[ "$tier" != "N/A" ]] && benchmarked=$(_is_benchmarked "$tier") || benchmarked="no"
  [[ "$benchmarked" == "true" ]] && benchmarked="yes" || benchmarked="no"

  echo "════════════════════════════════════════════════════"
  echo "Hardware Profile — Local Model Agent Benchmarking"
  echo "════════════════════════════════════════════════════"
  echo ""
  echo "Machine Identity:"
  printf "  Hostname:            %s\n" "$hostname"
  printf "  Username:            %s\n" "$username"
  printf "  OS:                  %s\n" "$(uname -s)"
  echo ""
  echo "Memory:"
  printf "  Total RAM:           %s GB\n" "$ram_total"
  printf "  RAM Used:            %s GB\n" "$ram_used"
  echo ""
  echo "Processor:"
  printf "  Model:               %s\n" "$cpu_model"
  printf "  Cores:               %s\n" "$cpu_cores"
  if [[ "$cpu_ghz" == "N/A" ]]; then
    printf "  Base Frequency:      %s (not available on this architecture)\n" "$cpu_ghz"
  else
    printf "  Base Frequency:      %s GHz\n" "$cpu_ghz"
  fi
  echo ""
  echo "Storage:"
  printf "  Free Space:          %s\n" "$disk_free"
  echo ""
  echo "Benchmark Tier:"
  printf "  Nearest RAM Tier:    %s GB\n" "$tier"
  printf "  Data Available:      %s (see docs/HARDWARE-RECOMMENDATIONS.md)\n" "$benchmarked"
  echo ""

  # Apple Silicon tuning tip
  is_apple_silicon=$(_is_apple_silicon "$os" "$cpu_model")
  if [[ "$is_apple_silicon" == "true" ]]; then
    gpu_cap_mb=$(_gpu_wired_mem_cap_mb "$ram_total")
    if [[ -n "$gpu_cap_mb" ]]; then
      echo "Tuning Tip (Apple Silicon):"
      echo "  Raise GPU memory cap for larger models/contexts (resets on reboot):"
      printf "    sudo sysctl iogpu.wired_mem_breakpoint_cap=%s\n" "$gpu_cap_mb"
      echo "  Close memory-heavy apps (Chrome, Docker) before deep agent loops."
    fi
  fi

  echo "════════════════════════════════════════════════════"
}

# Minimal one-liner output
_output_minimal() {
  local os="$1" ram_total cpu_cores cpu_ghz disk_free tier

  ram_total=$(_total_ram_gb "$os") || ram_total="N/A"
  cpu_cores=$(_cpu_cores "$os")
  cpu_ghz=$(_cpu_freq_ghz "$os")
  disk_free=$(_disk_free_human "$os")
  [[ "$ram_total" != "N/A" ]] && tier=$(_nearest_tier "$ram_total") || tier="N/A"

  printf "%s | %s GB RAM | %s cores @ %s GHz | %s free | Tier: %s GB\n" \
    "$(uname -s)" "$ram_total" "$cpu_cores" "$cpu_ghz" "$disk_free" "$tier"
}

# Full output: hardware + installed models
_output_full() {
  local os="$1" ram_total cpu_cores disk_free_human disk_free_gb lms_info ollama_info mlx_info

  ram_total=$(_total_ram_gb "$os") || ram_total="N/A"
  cpu_cores=$(_cpu_cores "$os")
  disk_free_human=$(_disk_free_human "$os")
  disk_free_gb=$(_disk_free_gb_numeric "$os")

  # Show hardware (like human output)
  _output_human "$os"

  # RAM breakdown (macOS only)
  if [[ "$os" == "macos" ]]; then
    echo ""
    echo "════════════════════════════════════════════════════"
    echo "Memory Breakdown"
    echo "════════════════════════════════════════════════════"
    local total_ram used_ram free_ram wired_ram inactive_ram active_ram
    read total_ram used_ram free_ram wired_ram inactive_ram < <(_ram_gb_breakdown "$os" || echo "")
    if [[ -n "$total_ram" ]]; then
      active_ram=$(( used_ram - wired_ram ))
      printf "  %-14s %4s GB  %s\n" "wired" "$wired_ram" "(model weights + kernel)"
      printf "  %-14s %4s GB  %s\n" "active" "$active_ram" "(process working sets)"
      printf "  %-14s %4s GB  %s\n" "inactive" "$inactive_ram" "(reclaimable disk cache)"
      printf "  %-14s %4s GB  %s\n" "free" "$free_ram" "(immediately available)"
      printf "  %s\n" "──────────────────────"
      printf "  %-14s %4s GB\n" "used" "$used_ram"
      printf "  %-14s %4s GB\n" "available" "$(( free_ram + inactive_ram ))"
    fi
  fi

  # Runtime status
  echo ""
  echo "════════════════════════════════════════════════════"
  echo "Installed Models & Runtime Environments"
  echo "════════════════════════════════════════════════════"
  echo ""

  # Runtime status section
  if _lms_up 2>/dev/null; then
    lms_models=$(_lms_loaded_models 2>/dev/null)
    if [[ -n "$lms_models" ]]; then
      printf "  LMS:     up  loaded: %s\n" "$lms_models"
    else
      printf "  LMS:     up  (no model loaded)\n"
    fi
  else
    printf "  LMS:     down\n"
  fi

  if _ollama_up 2>/dev/null; then
    ollama_models=$(_ollama_loaded 2>/dev/null)
    if [[ -n "$ollama_models" ]]; then
      printf "  Ollama:  up  loaded: %s\n" "$(echo "$ollama_models" | tr '\n' ',' | sed 's/,$//')"
    else
      printf "  Ollama:  up  (no model loaded)\n"
    fi
  else
    printf "  Ollama:  down\n"
  fi

  if _mlx_up 2>/dev/null; then
    mlx_model=$(_mlx_loaded 2>/dev/null)
    if [[ -n "$mlx_model" ]]; then
      printf "  MLX:     up  loaded: %s\n" "$mlx_model"
    else
      printf "  MLX:     up  (no model loaded)\n"
    fi
  else
    printf "  MLX:     down\n"
  fi

  echo ""

  # LMS models
  lms_info=$(_lms_models_info 2>/dev/null) || lms_info=""
  if [[ -n "$lms_info" ]]; then
    local lms_count lms_gb
    read lms_count lms_gb <<< "$lms_info"
    printf "LM Studio:     %s models  %s GB used\n" "$lms_count" "$lms_gb"
  else
    printf "LM Studio:     %s\n" "(not installed or no models)"
  fi

  # Ollama models
  ollama_info=$(_ollama_models_info 2>/dev/null) || ollama_info=""
  if [[ -n "$ollama_info" ]]; then
    local ollama_count ollama_gb
    read ollama_count ollama_gb <<< "$ollama_info"
    printf "Ollama:        %s models  %s GB used\n" "$ollama_count" "$ollama_gb"
  else
    printf "Ollama:        %s\n" "(not installed or no models)"
  fi

  # MLX models (HF cache)
  mlx_info=$(_mlx_models_info 2>/dev/null) || mlx_info=""
  if [[ -n "$mlx_info" ]]; then
    printf "MLX:           %s\n" "HuggingFace models cached locally"
  else
    printf "MLX:           %s\n" "(no HuggingFace cache)"
  fi

  echo ""
  printf "Disk available for models:  %s GB free\n" "$disk_free_gb"
  echo "════════════════════════════════════════════════════"
}

main() {
  local mode="human" os

  case "${1:-}" in
    --json)    mode="json" ;;
    --full)    mode="full" ;;
    --minimal) mode="minimal" ;;
    -h|--help)
      printf '%s\n' "hwprofile — comprehensive hardware detection for local agent benchmarking"
      echo ""
      printf '%s\n' "USAGE"
      printf '  %s\n' "hwprofile [OPTIONS]"
      echo ""
      printf '%s\n' "DESCRIPTION"
      printf '  %s\n' "Detects machine specs to help participants understand their capacity"
      printf '  %s\n' "for running local models. Works on macOS, Linux, and Windows."
      printf '  %s\n' "No elevated permissions required. When distributed as gist: curl <url> | bash"
      echo ""
      printf '%s\n' "OPTIONS"
      printf '  %-28s%s\n' "(default)" "human-readable detailed specs"
      printf '  %-28s%s\n' "--full" "specs + installed models and disk usage"
      printf '  %-28s%s\n' "--json" "machine-readable JSON for tooling"
      printf '  %-28s%s\n' "--minimal" "compact one-liner"
      printf '  %-28s%s\n' "-h, --help" "show this help and exit"
      echo ""
      printf '%s\n' "EXAMPLES"
      printf '  %s\n' "Show detailed specs:"
      printf '  $ %s\n' "hwprofile"
      printf '  %s\n' ""
      printf '  %s\n' "Get machine-readable output for scripting:"
      printf '  $ %s\n' "hwprofile --json"
      printf '  %s\n' ""
      printf '  %s\n' "Get compact one-liner:"
      printf '  $ %s\n' "hwprofile --minimal"
      exit 0
      ;;
    *)
      ;;
  esac

  os=$(_detect_os)

  if [[ "$os" == "unknown" ]]; then
    echo "hwprofile: Unable to detect OS. macOS, Linux, or Windows (Git Bash/WSL/Cygwin) required." >&2
    exit 1
  fi

  case "$mode" in
    json)    _output_json "$os" ;;
    full)    _output_full "$os" ;;
    minimal) _output_minimal "$os" ;;
    human)   _output_human "$os" ;;
  esac
}

main "$@"
