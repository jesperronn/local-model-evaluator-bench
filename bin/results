#!/usr/bin/env bash
# bin/results — grouped entry point for results-dir hygiene.
# Thin dispatcher: delegates to bin/stale and bin/cleanup. See
# docs/PLAN-CLI-UNIFICATION.md.
#
# Usage:
#   bin/results stale [--adapter/-model/-case filters ...]   = bin/stale
#   bin/results clean [--logs --scratch --sandboxes N --empty]  = bin/cleanup
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

usage() { sed -n '2,8p' "$0"; exit 0; }

SUB="${1:-}"; shift 2>/dev/null || true
case "$SUB" in
  stale) exec "$HERE/stale" "$@";;
  clean) exec "$HERE/cleanup" "$@";;
  -h|--help|"") usage;;
  *) echo "unknown subcommand: $SUB (valid: stale clean)" >&2; exit 1;;
esac
