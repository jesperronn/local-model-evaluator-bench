#!/usr/bin/env bash
# bin/guardrails-test — Test guardrails functionality with LiteLLM proxy
#
# Takes a text prompt on stdin, sends it to LiteLLM with guardrails enabled,
# and shows masked output. Compares with/without guardrails to demonstrate
# PII masking (PERSON, EMAIL_ADDRESS, PHONE_NUMBER, CREDIT_CARD).
#
# Usage:
#   echo "My name is John Doe, email john@example.com" | bin/guardrails-test
#   echo "My name is John Doe, email john@example.com" | bin/guardrails-test --model lms/qwen2.5-coder-7b
#
# Prerequisites:
#   - bin/litellm-proxy must be running: bin/litellm-proxy start
#
# Output shows:
#   [BEFORE] Original unguarded response
#   [AFTER]  Response with guardrails masking (PII replaced with <PERSON>, <EMAIL_ADDRESS>, etc.)
#
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
cd "$HERE"

# Source configuration (includes LITELLM_BASE_URL, API_KEY setup)
source "$HERE/config.sh"

# Color output (disabled with NO_COLOR)
if [ -z "${NO_COLOR:-}" ]; then
  C_BLU=$'\033[34m'
  C_GRN=$'\033[32m'
  C_RED=$'\033[31m'
  C_YEL=$'\033[33m'
  C_BLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_RST=$'\033[0m'
else
  C_BLU=; C_GRN=; C_RED=; C_YEL=; C_BLD=; C_DIM=; C_RST=
fi

# Defaults
MODEL_ID="${MODEL_ID:-lms/$PREFERRED_MODEL_ID}"
TIMEOUT="${TIMEOUT:-30}"
VERBOSE=0

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model)
      MODEL_ID="$2"
      shift 2
      ;;
    --timeout)
      TIMEOUT="$2"
      shift 2
      ;;
    -v|--verbose)
      VERBOSE=1
      shift
      ;;
    -h|--help)
      echo "Usage: bin/guardrails-test [OPTIONS]"
      echo ""
      echo "Read prompt from stdin and test guardrails masking via LiteLLM proxy."
      echo ""
      echo "Options:"
      echo "  --model MODEL_ID        Use specified model (default: lms/$PREFERRED_MODEL_ID)"
      echo "  --timeout SECONDS       API call timeout (default: 30)"
      echo "  -v, --verbose           Show detailed HTTP headers/timing"
      echo "  -h, --help              Show this help"
      echo ""
      echo "Prerequisites:"
      echo "  bin/litellm-proxy start   Start the proxy before running this"
      echo ""
      echo "Example:"
      echo "  echo 'My name is John Doe, email john@example.com' | bin/guardrails-test"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

# Read prompt from stdin
PROMPT=$(cat)
if [ -z "$PROMPT" ]; then
  echo "Error: No input provided. Pipe text on stdin." >&2
  exit 1
fi

# Verify LiteLLM proxy is running
check_proxy_running() {
  if ! curl -sf --max-time 2 "$LITELLM_BASE_URL/health" >/dev/null 2>&1; then
    echo "${C_RED}Error:${C_RST} LiteLLM proxy not running at $LITELLM_BASE_URL" >&2
    echo "Start it with: ${C_BLD}bin/litellm-proxy start${C_RST}" >&2
    return 1
  fi
  return 0
}

if ! check_proxy_running; then
  exit 1
fi

# Verify guardrails are available (check proxy status)
if ! bin/litellm-proxy guardrails config >/dev/null 2>&1; then
  echo "${C_YEL}Warning:${C_RST} Cannot fetch guardrails config. Proxy may need updating." >&2
fi

# Helper: Make API call to LiteLLM
make_api_call() {
  local prompt="$1"
  local enable_guardrails="${2:-true}"
  local verbose="${3:-0}"

  # Build request headers
  local -a curl_opts=(
    --silent
    --show-error
    --max-time "$TIMEOUT"
    -H "Content-Type: application/json"
  )

  # Add auth header if key is set
  if [ -n "${LITELLM_API_KEY:-}" ]; then
    curl_opts+=(-H "Authorization: Bearer $LITELLM_API_KEY")
  fi

  # Add verbose flag if requested
  if [ "$verbose" -eq 1 ]; then
    curl_opts+=(--verbose)
  fi

  # Build JSON payload
  local payload
  payload=$(cat <<EOF
{
  "model": "$MODEL_ID",
  "messages": [
    {"role": "user", "content": "$prompt"}
  ],
  "max_tokens": 500,
  "temperature": 0.7
}
EOF
  )

  # Make the request
  local response
  response=$(curl "${curl_opts[@]}" \
    -X POST \
    "$LITELLM_BASE_URL/chat/completions" \
    -d "$payload" 2>&1) || {
    echo "${C_RED}Error:${C_RST} API call failed (timeout or connection error)" >&2
    return 1
  }

  # Extract content from response
  if ! command -v jq >/dev/null 2>&1; then
    echo "$response"
  else
    echo "$response" | jq -r '.choices[0].message.content // .error.message // .' 2>/dev/null || echo "$response"
  fi
}

# Display header
echo "${C_BLD}━━━ Guardrails Test ━━━${C_RST}"
echo "Model:  ${C_DIM}$MODEL_ID${C_RST}"
echo "Prompt: ${C_DIM}$PROMPT${C_RST}"
echo ""

# Get guardrails status
echo "${C_BLD}Proxy Status:${C_RST}"
if GUARD_STATUS=$(bin/litellm-proxy guardrails status 2>/dev/null); then
  echo "  $GUARD_STATUS"
else
  echo "  ${C_YEL}(unable to fetch)${C_RST}"
fi
echo ""

# Test 1: Get response WITHOUT guardrails (disable first)
echo "${C_BLD}[1/2] Disabling guardrails...${C_RST}"
if bin/litellm-proxy guardrails off >/dev/null 2>&1; then
  echo "  ${C_GRN}✓ Guardrails disabled${C_RST}"
else
  echo "  ${C_YEL}⚠ Could not disable guardrails${C_RST}"
fi

echo ""
echo "${C_BLU}${C_BLD}[BEFORE] Response WITHOUT guardrails:${C_RST}"
echo "─────────────────────────────────────"
if RESPONSE_BEFORE=$(make_api_call "$PROMPT" false "$VERBOSE"); then
  echo "$RESPONSE_BEFORE"
else
  echo "${C_RED}Failed to get response${C_RST}"
fi
echo ""

# Test 2: Get response WITH guardrails (enable)
echo "${C_BLD}[2/2] Enabling guardrails...${C_RST}"
if bin/litellm-proxy guardrails on >/dev/null 2>&1; then
  echo "  ${C_GRN}✓ Guardrails enabled${C_RST}"
else
  echo "  ${C_YEL}⚠ Could not enable guardrails${C_RST}"
fi

echo ""
echo "${C_BLU}${C_BLD}[AFTER] Response WITH guardrails:${C_RST}"
echo "───────────────────────────────────"
if RESPONSE_AFTER=$(make_api_call "$PROMPT" true "$VERBOSE"); then
  echo "$RESPONSE_AFTER"
else
  echo "${C_RED}Failed to get response${C_RST}"
fi
echo ""

# Show masking summary
echo "${C_BLD}Masking Summary:${C_RST}"
if [ "$RESPONSE_BEFORE" != "$RESPONSE_AFTER" ]; then
  echo "  ${C_GRN}✓ PII masking detected${C_RST}"
  # Try to identify what was masked
  if echo "$RESPONSE_AFTER" | grep -q "<PERSON>"; then
    echo "    • PERSON names masked"
  fi
  if echo "$RESPONSE_AFTER" | grep -q "<EMAIL_ADDRESS>"; then
    echo "    • Email addresses masked"
  fi
  if echo "$RESPONSE_AFTER" | grep -q "<PHONE_NUMBER>"; then
    echo "    • Phone numbers masked"
  fi
  if echo "$RESPONSE_AFTER" | grep -q "<CREDIT_CARD>"; then
    echo "    • Credit card numbers masked"
  fi
else
  echo "  ${C_YEL}⚠ No differences detected (no PII in responses, or guardrails not working)${C_RST}"
fi

echo ""
echo "${C_BLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RST}"

# Leave guardrails in a known state (disabled by default)
bin/litellm-proxy guardrails off >/dev/null 2>&1 || true
