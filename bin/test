#!/usr/bin/env bash
set -euo pipefail

pushd "$(dirname "$0")/.." > /dev/null || exit 1

HERE="."
source "$HERE/lib/common.sh"
source "$HERE/bin/lib/help.sh"

usage() {
  help_header "test" "run colocated shell test scripts (*.test.sh)"

  help_section "USAGE"
  help_line "  test [--verbose] [test-file ...]"

  help_section "DESCRIPTION"
  help_line "  Run colocated shell test scripts. With no arguments, all '*.test.sh'"
  help_line "  files under 'bin/' and 'lib/' are run."

  help_section "OPTIONS"
  help_flag "--verbose" "" "show per-test RUN lines from test files that support it"
  help_flag "-h, --help" "" "show this help and exit"

  help_section "EXAMPLES"
  help_line "  Run all tests:"
  help_line "    \$ test"
  help_line ""
  help_line "  Run a specific test file:"
  help_line "    \$ test lib/versions.test.sh"
  help_line ""
  help_line "  Run all tests with verbose output:"
  help_line "    \$ test --verbose"
}

collect_test_files() {
  if [[ $# -gt 0 ]]; then
    printf '%s\n' "$@"
    return 0
  fi

  find bin lib -name '*.test.sh' -type f 2>/dev/null | sort
}

run_test_file() {
  local test_file="${1}"
  local verbose="${2:-0}"

  if [[ -z "${NO_COLOR:-}" ]]; then
    printf '\033[1;36m==> %s\033[0m\n' "${test_file}"
  else
    printf '==> %s\n' "${test_file}"
  fi

  if [[ ! -x "${test_file}" ]]; then
    printf 'Test file is not executable: %s\n' "${test_file}" >&2
    return 1
  fi

  BASH_TEST_VERBOSE="${verbose}" "${test_file}"
}

run_main() {
  local verbose=0
  local -a requested=()
  local arg

  for arg in "$@"; do
    case "${arg}" in
      -h|--help)
        usage
        return 0
        ;;
      --verbose)
        verbose=1
        ;;
      *)
        requested+=("${arg}")
        ;;
    esac
  done

  local -a test_files=()
  mapfile -t test_files < <(collect_test_files "${requested[@]}")

  if [[ ${#test_files[@]} -eq 0 ]]; then
    printf 'No test files found.\n' >&2
    return 1
  fi

  local -a failed_files=()
  local test_file
  for test_file in "${test_files[@]}"; do
    if ! run_test_file "${test_file}" "${verbose}"; then
      failed_files+=("${test_file}")
    fi
    echo
  done

  if [[ ${#failed_files[@]} -eq 0 ]]; then
    if [[ -z "${NO_COLOR:-}" ]]; then
      printf '\033[1;32mTEST SUMMARY: all %d test file(s) passed\033[0m\n' "${#test_files[@]}"
    else
      printf 'TEST SUMMARY: all %d test file(s) passed\n' "${#test_files[@]}"
    fi
    return 0
  fi

  if [[ -z "${NO_COLOR:-}" ]]; then
    printf '\033[1;31mTEST SUMMARY: %d of %d test file(s) failed\033[0m\n' "${#failed_files[@]}" "${#test_files[@]}" >&2
  else
    printf 'TEST SUMMARY: %d of %d test file(s) failed\n' "${#failed_files[@]}" "${#test_files[@]}" >&2
  fi

  printf 'Failed test files:\n' >&2
  local failed_file
  for failed_file in "${failed_files[@]}"; do
    printf '  bin/test %s\n' "${failed_file}" >&2
  done

  return 2
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  run_main "$@"
fi
