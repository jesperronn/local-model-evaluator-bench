#!/usr/bin/env bash
# bin/debug — unified debugging tool (consolidates trace-edit, trace-tool-calls, investigate)
#
# Debug tool calls, transcripts, and failures across adapters and models.
# Covers three key workflows:
#   1. Run one (adapter, model, case) triple and capture full transcript
#   2. Inspect tool calls in transcripts (flags mangled XML/JSON)
#   3. Triage all failures from a benchmark run
#
# Subcommands:
#   <adapter> <model> [case]  Run one triple, capture transcript
#   --calls [--latest]        Inspect tool calls in transcripts
#   --failures <run-id>       Triage all failures from a run
#   --compare <run1> <run2>   Compare two runs
#
set -uo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
source "$HERE/config.sh"
source "$HERE/lib/common.sh"
source "$HERE/bin/lib/help.sh"

show_help() {
  help_header "debug" "run single cases, inspect transcripts, triage failures"
  help_section "USAGE"
  help_line "  debug <adapter> <model> [case]  — Run one triple, capture transcript"
  help_line "  debug --calls [--latest]         — Inspect tool calls in transcripts"
  help_line "  debug --failures <run-id>        — Triage all failures from a run"
  help_line "  debug --compare <run1> <run2>    — Compare two runs"

  help_section "DESCRIPTION"
  help_line "  Debug and triage issues with adapters and models."
  help_line ""
  help_line "  Run a single test case and get full transcript:"
  help_line "    debug aider qwen/qwen3.6-35b js-01-slugify-bug"
  help_line ""
  help_line "  Inspect tool calls in transcripts (flags mangled XML/JSON):"
  help_line "    debug --calls --latest"
  help_line ""
  help_line "  Classify all failures from a benchmark run:"
  help_line "    debug --failures 20260816-123456"

  help_section "EXAMPLES"
  help_line "  Run one case with transcript capture:"
  help_line "    \$ debug aider qwen/qwen3.5-9b js-01-slugify"
  help_line ""
  help_line "  Show tool calls from latest run:"
  help_line "    \$ debug --calls --latest"
  help_line ""
  help_line "  Triage failures:"
  help_line "    \$ debug --failures 20260816-123456"

  help_section "OUTPUT"
  help_line "  Transcripts saved to: results/<timestamp>/sandbox/<adapter>/.../"
  help_line "  Tool calls: inspect for mangled XML, missing fields, etc."
  help_line "  Failures: classified as signature, clean, or no-transcript"
}

# ── Subcommand: run one triple with transcript ───────────────────────────────
cmd_run_triple() {
  local adapter="$1" model="$2" case="${3:-smoke-01-edit-file}"

  info "Running single triple with transcript capture"
  info "  Adapter: $adapter"
  info "  Model: $model"
  info "  Case: $case"
  echo ""

  # Use bin/bench with single case
  "$HERE/bin/bench" \
    --agent "$adapter" \
    --models "$model" \
    --cases "$case" \
    --trials 1 \
    --verbose

  echo ""

  # Find and show transcript location
  RESULT_DIR=$(ls -dt "$RESULTS_DIR"/*/sandbox 2>/dev/null | head -1)
  if [ -d "$RESULT_DIR" ]; then
    TRANSCRIPT=$(find "$RESULT_DIR" -name ".bench.log" | head -1)
    if [ -f "$TRANSCRIPT" ]; then
      echo ""
      info "Transcript saved to:"
      echo "  ${TRANSCRIPT#"$HERE"/}"
      echo ""
      help_next_steps_section \
        "View full transcript|less '$TRANSCRIPT'" \
        "Inspect tool calls|debug --calls --latest" \
        "Run again with different model|debug aider <other-model> $case"
    fi
  fi
}

# ── Subcommand: inspect tool calls ───────────────────────────────────────────
cmd_calls() {
  local latest=0
  [ "$1" = "--latest" ] && latest=1 && shift

  info "Inspecting tool calls in transcripts..."

  # Find transcript(s)
  if [ "$latest" = 1 ]; then
    TRANSCRIPT=$(find "$RESULTS_DIR" -name ".bench.log" -type f | sort -r | head -1)
    if [ -z "$TRANSCRIPT" ]; then
      err "No transcripts found"
      exit 1
    fi
    info "Using latest transcript: ${TRANSCRIPT#"$HERE"/}"
  else
    err "Please specify --latest or provide transcript path"
    exit 1
  fi

  echo ""
  echo "${C_BLD}Tool Call Analysis${C_RST}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  # Extract and analyze tool calls
  if grep -q "tool_call" "$TRANSCRIPT" 2>/dev/null; then
    info "Found tool calls in transcript"

    # Check for common issues
    if grep -q 'MANGLED\|parse error\|invalid XML\|invalid JSON' "$TRANSCRIPT" 2>/dev/null; then
      warn "⚠ Tool calls appear mangled!"
      echo ""
      warn "Mangled signatures detected:"
      grep -E 'MANGLED|parse error|invalid' "$TRANSCRIPT" 2>/dev/null | head -5
      echo ""
      help_next_steps_section \
        "Apply Qwen edit shim|bin/patch qwen3-edit-shim" \
        "Re-run the case|debug aider qwen3.6 js-01" \
        "Check adapter|less bin/adapters/aider.sh"
    else
      ok "Tool calls look clean"
      echo ""
      echo "Sample tool calls:"
      grep 'tool_call' "$TRANSCRIPT" 2>/dev/null | head -5 | sed 's/^/  /'
      echo ""
      help_next_steps_section \
        "Document failure|docs/tools/aider.md" \
        "Try different model|debug aider <model> <case>" \
        "Compare successful runs|bin/report --all"
    fi
  else
    warn "No tool calls found in transcript"
  fi
}

# ── Subcommand: triage failures ──────────────────────────────────────────────
cmd_failures() {
  local run_id="$1"
  [ -n "$run_id" ] || { err "debug --failures: missing run-id"; exit 1; }

  local run_dir="$RESULTS_DIR/$run_id"
  [ -d "$run_dir" ] || { err "Run not found: $run_dir"; exit 1; }

  local results_csv="$run_dir/results.csv"
  [ -f "$results_csv" ] || { err "Results not found: $results_csv"; exit 1; }

  info "Triaging failures from run: $run_id"
  echo ""

  echo "${C_BLD}Failure Classification${C_RST}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  local signature_count=0 clean_count=0 no_transcript_count=0

  # Parse results and classify each failure
  while IFS=, read -r adapter model case pass total score seconds status _rest; do
    [ "$adapter" = "adapter" ] && continue
    [ "$status" = "ok" ] && continue

    echo ""
    warn "FAIL: $adapter × $model × $case ($status)"

    # Check for transcript
    transcript="$run_dir/sandbox/$adapter/$(printf '%s' "$model" | tr '/:' '__')/$case/.bench.log"

    if [ ! -f "$transcript" ]; then
      err "  → no-transcript (can't diagnose)"
      ((no_transcript_count++))
      continue
    fi

    # Check for signature (mangled tool calls)
    if grep -q 'MANGLED\|parse error\|invalid' "$transcript" 2>/dev/null; then
      warn "  → signature (mangled tool calls — fixable)"
      echo "     Apply: bin/patch qwen3-edit-shim"
      ((signature_count++))
    else
      ok "  → clean (real model failure)"
      echo "     Document: docs/tools/$adapter.md"
      ((clean_count++))
    fi
  done < "$results_csv"

  echo ""
  echo "${C_BLD}Summary${C_RST}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  Signature issues (fixable): $signature_count"
  echo "  Clean failures (real): $clean_count"
  echo "  No transcript: $no_transcript_count"

  echo ""
  help_next_steps_section \
    "Fix signatures|bin/patch qwen3-edit-shim && bin/bench --resume $run_id" \
    "Re-triage|debug --failures $run_id" \
    "Document findings|docs/tools/ or docs/models/" \
    "Check linting|bin/lint --cards"
}

# ── Subcommand: compare two runs ─────────────────────────────────────────────
cmd_compare() {
  local run1="$1" run2="$2"
  [ -n "$run1" ] && [ -n "$run2" ] || { err "debug --compare: missing run ids"; exit 1; }

  info "Comparing runs..."
  info "  Run 1: $run1"
  info "  Run 2: $run2"

  # TODO: implement run comparison
  err "Compare subcommand not yet implemented"
  exit 1
}

# ── Main dispatch ────────────────────────────────────────────────────────────
if [ $# -eq 0 ] || [[ "$1" == -h ]] || [[ "$1" == --help ]]; then
  show_help
  exit 0
fi

case "$1" in
  --calls)    shift; cmd_calls "$@" ;;
  --failures) shift; cmd_failures "$@" ;;
  --compare)  shift; cmd_compare "$@" ;;
  *)          cmd_run_triple "$@" ;;
esac
