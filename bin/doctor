#!/usr/bin/env bash
# bin/doctor — verify the environment: server up, CLIs installed, models present.
set -uo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
source "$HERE/config.sh"; source "$HERE/lib/common.sh"; source "$HERE/bin/lib/help.sh"
source "$HERE/bin/lib/model-profiles.sh"

# ── Hardware detection ───────────────────────────────────────────────────────
detect_system_ram_gb() {
  # Return system RAM in GB (rounded down)
  case "$(uname -s)" in
    Darwin) sysctl -n hw.memsize 2>/dev/null | awk '{printf "%d", $1 / 1024 / 1024 / 1024}';;
    Linux)  grep MemTotal /proc/meminfo 2>/dev/null | awk '{printf "%d", $2 / 1024 / 1024}';;
    *)      echo "0";;
  esac
}

suggest_profile_for_ram() {
  local ram_gb="$1"
  # Suggest based on available RAM
  if [ "$ram_gb" -ge 128 ]; then
    echo "128gb"
  elif [ "$ram_gb" -ge 64 ]; then
    echo "64gb"
  elif [ "$ram_gb" -ge 32 ]; then
    echo "32gb"
  elif [ "$ram_gb" -ge 24 ]; then
    echo "24gb"
  else
    echo ""
  fi
}

# ── Help ─────────────────────────────────────────────────────────────────────
show_help() {
  help_header "doctor" "verify the environment: server, CLIs, models, adapters"
  help_section "USAGE"
  help_line "  doctor [OPTIONS]"
  help_section "DESCRIPTION"
  help_line "  Checks LM Studio connectivity, CLI tools (aider, cline, etc),"
  help_line "  model availability, test cases, and reports missing coverage gaps."
  help_section "OPTIONS"
  help_flag "-h, --help" "" "show this help and exit"
}

# Parse args
for arg in "$@"; do
  case "$arg" in
    -h|--help) show_help; exit 0;;
    *) die "unknown option: $arg";;
  esac
done

info "LM Studio server: $LMS_BASE_URL"
if lms_up; then
  ok "reachable"
  loaded="$(lms_loaded_models)"
  if [ -n "$loaded" ]; then
    echo "  loaded model ids:"; printf '    %s\n' $loaded
  else
    warn "no model currently loaded — load one in LM Studio or run: lms load <id>"
  fi
else
  err "not reachable. Start it with:  lms server start"
fi

echo
info "Model management CLIs:"
if command -v hf >/dev/null 2>&1; then
  ok "hf -> $(command -v hf)"
else
  warn "hf not found — bin/lms_update needs it: brew install hf"
fi

echo
info "Coding CLIs (adapters in $ADAPTERS_DIR):"
# Adapter files are named <tool>-<runtime>.sh (e.g. aider-lms.sh); the binary
# to check for on PATH is just <tool>. Dedupe so each tool is checked once
# regardless of how many runtime variants it has.
for name in $(for a in "$ADAPTERS_DIR"/*.sh; do
  n="$(basename "$a" .sh)"
  # Repeatedly strip trailing runtime/routing tokens (order in filenames is
  # <tool>[-proxy]-<runtime>, e.g. codex-proxy-ollama.sh -> codex).
  while [[ "$n" =~ -(lms|ollama|mlx|proxy)$ ]]; do n="${n%-*}"; done
  echo "$n"
done | sort -u); do
  if command -v "$name" >/dev/null 2>&1; then ok "$name -> $(command -v "$name")"
  else warn "$name not on PATH (adapter present, tool missing)"; fi
done

echo
info "hermes readiness (its tools run in a sandbox that must reach the cwd):"
if command -v hermes >/dev/null 2>&1; then
  cfg="$HOME/.hermes/config.yaml"
  backend="$(grep -A1 '^terminal:' "$cfg" 2>/dev/null | sed -nE 's/^[[:space:]]*backend:[[:space:]]*([a-z]+).*/\1/p' | head -1)"
  mount="$(grep -E 'docker_mount_cwd_to_workspace:' "$cfg" 2>/dev/null | sed -nE 's/.*:[[:space:]]*([a-z]+).*/\1/p' | head -1)"
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then dkr=up; else dkr=down; fi
  if [ "$backend" = local ]; then
    ok "backend=local (runs on host, no sandbox) — edits reach the cwd"
  elif [ "$backend" = docker ] && [ "$mount" = true ] && [ "$dkr" = up ]; then
    ok "backend=docker + cwd mounted + docker up — ready (isolation kept)"
  else
    warn "NOT ready: backend=${backend:-?} mount=${mount:-?} docker=$dkr"
    echo "    In $cfg under 'terminal:' set ONE of:"
    echo "      backend: docker   AND   docker_mount_cwd_to_workspace: true   (safe: keeps container isolation; needs Docker running + image)"
    echo "      backend: local                                                (runs --yolo tools directly on the host — no sandbox)"
    echo "    Then add 'hermes' to DEFAULT_ADAPTERS in config.sh."
  fi
else
  echo "    hermes not installed — skipping"
fi

echo
info "Models under test ($MODELS_FILE):"
read_list "$MODELS_FILE" | sed 's/^/    /'

echo
info "Test cases ($CASES_DIR):"
for d in "$CASES_DIR"/*/; do
  [ -f "$d/meta.json" ] || continue
  id="$(basename "$d")"
  lang="$(grep -oE '"lang"\s*:\s*"[^"]+"' "$d/meta.json" | sed -E 's/.*"([^"]+)"$/\1/')"
  printf '    %-26s [%s]\n' "$id" "$lang"
done

echo
info "Hung predictions (stuck runs with in-flight predictions):"
# Scan recent trial sandboxes for unbalanced input/output events that suggest
# hung predictions. These are trials that stalled with predictions still in-flight.
stuck_count=0
for lmslog in $(find "$RESULTS_DIR" -name '.lms-stream.log' -type f -mtime -1 2>/dev/null | head -50); do
  [ ! -f "$lmslog" ] && continue
  _inputs="$(grep -c '"type":"llm.prediction.input"' "$lmslog" 2>/dev/null)" || _inputs=0
  _inputs="${_inputs##[[:space:]]}"; _inputs="${_inputs%%[[:space:]]}"  # trim
  [ -z "$_inputs" ] && _inputs=0
  _outputs="$(grep -c '"type":"llm.prediction.output"' "$lmslog" 2>/dev/null)" || _outputs=0
  _outputs="${_outputs##[[:space:]]}"; _outputs="${_outputs%%[[:space:]]}"  # trim
  [ -z "$_outputs" ] && _outputs=0
  _inflight=$(( _inputs - _outputs ))
  if [ "$_inflight" -gt 0 ]; then
    _sandbox_dir="$(dirname "$lmslog")"
    _trial_path="${_sandbox_dir#$RESULTS_DIR/}"
    printf '    %s — %d in-flight (inputs=%d outputs=%d)\n' "$_trial_path" "$_inflight" "$_inputs" "$_outputs"
    stuck_count=$((stuck_count + 1))
  fi
done
if [ "$stuck_count" -eq 0 ]; then
  ok "no hung predictions detected"
else
  warn "$stuck_count trial(s) with stuck predictions. Run 'bin/bench --resume' to retry."
fi

echo
info "Model profiles and availability:"
ram_gb="$(detect_system_ram_gb)"
if [ -n "$ram_gb" ] && [ "$ram_gb" -gt 0 ]; then
  suggested_profile="$(suggest_profile_for_ram "$ram_gb")"
  if [ -n "$suggested_profile" ]; then
    printf '  System RAM: %sGB  →  Profile: %s\n' "$ram_gb" "$suggested_profile"

    # Check if primary model for this profile is available
    primary="$(profile_primary "$suggested_profile")"
    if [ -n "$primary" ]; then
      lms_id="$(alias_ids "$primary" lms 2>/dev/null || echo "")"
      if [ -n "$lms_id" ] && [ "$lms_id" != "-" ]; then
        if lms_up 2>/dev/null && printf '%s\n' "$(lms_loaded_models 2>/dev/null || true)" | grep -qxF "$lms_id"; then
          ok "  $primary is loaded in LM Studio"
        else
          warn "  $primary (LMS) not installed"
          printf '  Next step: bin/setup --model %s\n' "$suggested_profile"
        fi
      fi
    fi
  fi
else
  warn "Could not detect system RAM"
fi

echo
info "Coverage gaps (missing adapter × model × case combos):"
RESULTS_DIR="$RESULTS_DIR" python3 - << 'PYEOF'
import glob, csv, os, sys
from collections import defaultdict

results_dir = os.environ['RESULTS_DIR']
latest = {}
for path in sorted(glob.glob(results_dir + '/*/results.csv')):
    run = os.path.basename(os.path.dirname(path))
    try:
        with open(path) as f:
            for row in csv.DictReader(f):
                k = (row['adapter'], row['model'], row['case'])
                if k not in latest or run > latest[k]['run']:
                    latest[k] = {**row, 'run': run}
    except Exception:
        pass

if not latest:
    print('  no results found yet')
    sys.exit(0)

adapters = sorted(set(k[0] for k in latest))
models   = sorted(set(k[1] for k in latest))
cases    = sorted(set(k[2] for k in latest))

# track runtime per (adapter, model)
runtime_for = {}
for (adapter, model, case), row in latest.items():
    runtime_for[(adapter, model)] = row.get('runtime', 'lms')

missing = defaultdict(lambda: defaultdict(list))
for adapter in adapters:
    for model in models:
        has_any = any((adapter, model, c) in latest for c in cases)
        if not has_any:
            continue
        for case in cases:
            if (adapter, model, case) not in latest:
                missing[adapter][model].append(case)

total = sum(len(cs) for m in missing.values() for cs in m.values())
if total == 0:
    print('  all combinations complete!')
else:
    print(f'  {total} missing. Commands to fill the gaps:\n')
    for adapter in sorted(missing):
        for model in sorted(missing[adapter]):
            cases_list = ','.join(missing[adapter][model])
            runtime = runtime_for.get((adapter, model), 'lms')
            print(f'  bin/bench --runtime {runtime} --agent {adapter} --model {model} --cases {cases_list}')
        print()
PYEOF
