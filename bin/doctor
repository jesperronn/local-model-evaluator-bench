#!/usr/bin/env bash
# bin/doctor — verify the environment: server up, CLIs installed, models present.
set -uo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
source "$HERE/config.sh"; source "$HERE/lib/common.sh"; source "$HERE/bin/lib/help.sh"
source "$HERE/bin/lib/model-profiles.sh"

# ── Hardware detection ───────────────────────────────────────────────────────
detect_system_ram_gb() {
  # Return system RAM in GB (rounded down)
  case "$(uname -s)" in
    Darwin) sysctl -n hw.memsize 2>/dev/null | awk '{printf "%d", $1 / 1024 / 1024 / 1024}';;
    Linux)  grep MemTotal /proc/meminfo 2>/dev/null | awk '{printf "%d", $2 / 1024 / 1024}';;
    *)      echo "0";;
  esac
}

suggest_profile_for_ram() {
  local ram_gb="$1"
  # Suggest based on available RAM
  if [ "$ram_gb" -ge 128 ]; then
    echo "128gb"
  elif [ "$ram_gb" -ge 64 ]; then
    echo "64gb"
  elif [ "$ram_gb" -ge 32 ]; then
    echo "32gb"
  elif [ "$ram_gb" -ge 24 ]; then
    echo "24gb"
  else
    echo ""
  fi
}

# ── Help ─────────────────────────────────────────────────────────────────────
show_help() {
  help_header "doctor" "verify the environment: server, CLIs, models, adapters"
  help_section "USAGE"
  help_line "  doctor [OPTIONS]"
  help_section "DESCRIPTION"
  help_line "  Checks LM Studio connectivity, CLI tools (aider, cline, etc),"
  help_line "  model availability, test cases, and reports missing coverage gaps."
  help_section "OPTIONS"
  help_flag "-h, --help" "" "show this help and exit"
  help_flag "--gaps" "" "print the full list of missing adapter x model x case combos"
}

# Parse args
show_gaps=0
for arg in "$@"; do
  case "$arg" in
    -h|--help) show_help; exit 0;;
    --gaps) show_gaps=1;;
    *) die "unknown option: $arg";;
  esac
done

# Track problems found during checks
declare -a problems_found

info "LM Studio server: $LMS_BASE_URL"
if lms_up; then
  ok "reachable"
  loaded="$(lms_loaded_models)"
  if [ -n "$loaded" ]; then
    echo "  loaded model ids:"; printf '    %s\n' $loaded
  else
    warn "no model currently loaded — load one in LM Studio or run: lms load <id>"
    problems_found+=("no_model_loaded")
  fi
else
  err "not reachable. Start it with:  lms server start"
  problems_found+=("lms_not_reachable")
fi

_lms_settings="$HOME/.lmstudio/settings.json"
if [ -f "$_lms_settings" ]; then
  _ctx_type="$(jq -r '.defaultContextLength.type // empty' "$_lms_settings" 2>/dev/null)"
  if [ "$_ctx_type" = "max" ]; then
    ok "default context length: Model maximum"
  else
    warn "default context length: ${_ctx_type:-not set} (expected: max) — models opened from the" \
      "LM Studio UI get capped at a fixed context instead of their real maximum"
    problems_found+=("lms_context_not_max")
  fi
fi

echo
info "LM Studio runtime engines:"
if command -v lms >/dev/null 2>&1; then
  _runtimes_err=""
  if ! _runtimes="$(lms runtime ls 2>&1)" || [ -z "$_runtimes" ]; then
    # Check for common error patterns
    if printf '%s\n' "$_runtimes" | grep -qi "dylib\|library not loaded"; then
      warn "detected broken dynamic library dependencies (likely macOS update issue)"
      echo "  error: ${_runtimes}" | head -1
      problems_found+=("runtime_dylib_broken")
    elif printf '%s\n' "$_runtimes" | grep -qi "no runtime found\|no llm runtime"; then
      warn "detected corrupted or missing runtime cache"
      problems_found+=("runtime_cache_corrupted")
    else
      warn "could not query runtime engines"
      problems_found+=("runtime_query_failed")
    fi
  else
    # Check for selected runtime (marked with ✓)
    _selected="$(printf '%s\n' "$_runtimes" | grep '✓' | awk '{print $1}' | head -1)"
    if [ -n "$_selected" ]; then
      ok "selected: $_selected"
      # Extract format info for selected runtime
      _format="$(printf '%s\n' "$_runtimes" | grep '✓' | awk '{for(i=NF;i>=1;i--) print $i}' | grep -E 'GGUF|safetensors|mlx|etc' | head -1)"
      if [ -n "$_format" ]; then
        echo "  format: $_format"
      fi
    fi
    # Show all available runtimes
    if [ "$(printf '%s\n' "$_runtimes" | wc -l)" -gt 2 ]; then
      echo "  available engines:"
      printf '%s\n' "$_runtimes" | tail -n +2 | sed 's/^/    /'
    fi
  fi
else
  warn "lms CLI not installed — runtime management unavailable"
  problems_found+=("lms_cli_missing")
fi

echo
info "Model management CLIs:"
if command -v hf >/dev/null 2>&1; then
  ok "hf -> $(command -v hf)"
else
  warn "hf not found — bin/lms_update needs it: brew install hf"
  problems_found+=("hf_missing")
fi

echo
info "Coding CLIs (adapters in $ADAPTERS_DIR):"
# Adapter files are named <tool>-<runtime>.sh (e.g. aider-lms.sh); the binary
# to check for on PATH is just <tool>. Dedupe so each tool is checked once
# regardless of how many runtime variants it has.
for name in $(for a in "$ADAPTERS_DIR"/*.sh; do
  n="$(basename "$a" .sh)"
  # Repeatedly strip trailing runtime/routing tokens (order in filenames is
  # <tool>[-proxy]-<runtime>, e.g. codex-proxy-ollama.sh -> codex).
  while [[ "$n" =~ -(lms|ollama|mlx|proxy)$ ]]; do n="${n%-*}"; done
  echo "$n"
done | sort -u); do
  if command -v "$name" >/dev/null 2>&1; then ok "$name -> $(command -v "$name")"
  else warn "$name not on PATH (adapter present, tool missing)"; problems_found+=("adapter_missing:$name"); fi
done

echo
info "hermes readiness (its tools run in a sandbox that must reach the cwd):"
if command -v hermes >/dev/null 2>&1; then
  cfg="$HOME/.hermes/config.yaml"
  backend="$(grep -A1 '^terminal:' "$cfg" 2>/dev/null | sed -nE 's/^[[:space:]]*backend:[[:space:]]*([a-z]+).*/\1/p' | head -1)"
  mount="$(grep -E 'docker_mount_cwd_to_workspace:' "$cfg" 2>/dev/null | sed -nE 's/.*:[[:space:]]*([a-z]+).*/\1/p' | head -1)"
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then dkr=up; else dkr=down; fi
  if [ "$backend" = local ]; then
    ok "backend=local (runs on host, no sandbox) — edits reach the cwd"
  elif [ "$backend" = docker ] && [ "$mount" = true ] && [ "$dkr" = up ]; then
    ok "backend=docker + cwd mounted + docker up — ready (isolation kept)"
  else
    warn "NOT ready: backend=${backend:-?} mount=${mount:-?} docker=$dkr"
    echo "    In $cfg under 'terminal:' set ONE of:"
    echo "      backend: docker   AND   docker_mount_cwd_to_workspace: true   (safe: keeps container isolation; needs Docker running + image)"
    echo "      backend: local                                                (runs --yolo tools directly on the host — no sandbox)"
    echo "    Then add 'hermes' to DEFAULT_ADAPTERS in config.sh."
    problems_found+=("hermes_not_ready")
  fi
else
  echo "    hermes not installed — skipping"
fi

echo
info "Agent config wired to config.sh (endpoint/api key/model):"
# Delegates to bin/agents-config --verify, but only for agents actually on PATH
# so uninstalled agents don't show as drift. This is the config-level check;
# reachability is proven separately by bin/smoke.
_cfg_agents=()
for _a in aider opencode pi; do command -v "$_a" >/dev/null 2>&1 && _cfg_agents+=("$_a"); done
if [ "${#_cfg_agents[@]}" -eq 0 ]; then
  echo "    no configurable agents installed — skipping"
else
  _csv="$(IFS=,; echo "${_cfg_agents[*]}")"
  _vout="$("$HERE/bin/agents-config" --verify --agent "$_csv" 2>&1)"; _vrc=$?
  printf '%s\n' "$_vout" | sed 's/^/    /'
  [ "$_vrc" -eq 0 ] || problems_found+=("agent_config_drift")
fi

echo
info "Models under test ($MODELS_FILE):"
read_list "$MODELS_FILE" | sed 's/^/    /'

echo
info "Test cases ($CASES_DIR):"
for d in "$CASES_DIR"/*/; do
  [ -f "$d/meta.json" ] || continue
  id="$(basename "$d")"
  lang="$(grep -oE '"lang"\s*:\s*"[^"]+"' "$d/meta.json" | sed -E 's/.*"([^"]+)"$/\1/')"
  printf '    %-26s [%s]\n' "$id" "$lang"
done

echo
info "Hung predictions (stuck runs with in-flight predictions):"
# Scan recent trial sandboxes for unbalanced input/output events that suggest
# hung predictions. These are trials that stalled with predictions still in-flight.
stuck_count=0
for lmslog in $(find "$RESULTS_DIR" -name '.lms-stream.log' -type f -mtime -1 2>/dev/null | head -50); do
  [ ! -f "$lmslog" ] && continue
  _inputs="$(grep -c '"type":"llm.prediction.input"' "$lmslog" 2>/dev/null)" || _inputs=0
  _inputs="${_inputs##[[:space:]]}"; _inputs="${_inputs%%[[:space:]]}"  # trim
  [ -z "$_inputs" ] && _inputs=0
  _outputs="$(grep -c '"type":"llm.prediction.output"' "$lmslog" 2>/dev/null)" || _outputs=0
  _outputs="${_outputs##[[:space:]]}"; _outputs="${_outputs%%[[:space:]]}"  # trim
  [ -z "$_outputs" ] && _outputs=0
  _inflight=$(( _inputs - _outputs ))
  if [ "$_inflight" -gt 0 ]; then
    _sandbox_dir="$(dirname "$lmslog")"
    _trial_path="${_sandbox_dir#$RESULTS_DIR/}"
    printf '    %s — %d in-flight (inputs=%d outputs=%d)\n' "$_trial_path" "$_inflight" "$_inputs" "$_outputs"
    stuck_count=$((stuck_count + 1))
  fi
done
if [ "$stuck_count" -eq 0 ]; then
  ok "no hung predictions detected"
else
  warn "$stuck_count trial(s) with stuck predictions. Run 'bin/bench --resume' to retry."
  problems_found+=("stuck_predictions")
fi

echo
info "Model profiles and availability:"
ram_gb="$(detect_system_ram_gb)"
if [ -n "$ram_gb" ] && [ "$ram_gb" -gt 0 ]; then
  suggested_profile="$(suggest_profile_for_ram "$ram_gb")"
  if [ -n "$suggested_profile" ]; then
    printf '  System RAM: %sGB  →  Profile: %s\n' "$ram_gb" "$suggested_profile"

    # Check if primary model for this profile is available
    primary="$(profile_primary "$suggested_profile")"
    if [ -n "$primary" ]; then
      lms_id="$(alias_ids "$primary" lms 2>/dev/null || echo "")"
      if [ -n "$lms_id" ] && [ "$lms_id" != "-" ]; then
        if lms_up 2>/dev/null && printf '%s\n' "$(lms_loaded_models 2>/dev/null || true)" | grep -qxF "$lms_id"; then
          ok "  $primary is loaded in LM Studio"
        else
          warn "  $primary (LMS) not installed"
          printf '  Next step: bin/setup --model %s\n' "$suggested_profile"
          problems_found+=("model_not_installed:$suggested_profile")
        fi
      fi
    fi
  fi
else
  warn "Could not detect system RAM"
  problems_found+=("cannot_detect_ram")
fi

echo
info "Coverage gaps (missing adapter × model × case combos):"
RESULTS_DIR="$RESULTS_DIR" SHOW_GAPS="$show_gaps" python3 - << 'PYEOF'
import glob, csv, os, sys
from collections import defaultdict

results_dir = os.environ['RESULTS_DIR']
latest = {}
for path in sorted(glob.glob(results_dir + '/*/results.csv')):
    run = os.path.basename(os.path.dirname(path))
    try:
        with open(path) as f:
            for row in csv.DictReader(f):
                k = (row['adapter'], row['model'], row['case'])
                if k not in latest or run > latest[k]['run']:
                    latest[k] = {**row, 'run': run}
    except Exception:
        pass

if not latest:
    print('  no results found yet')
    sys.exit(0)

adapters = sorted(set(k[0] for k in latest))
models   = sorted(set(k[1] for k in latest))
cases    = sorted(set(k[2] for k in latest))

# track runtime per (adapter, model)
runtime_for = {}
for (adapter, model, case), row in latest.items():
    runtime_for[(adapter, model)] = row.get('runtime', 'lms')

missing = defaultdict(lambda: defaultdict(list))
for adapter in adapters:
    for model in models:
        has_any = any((adapter, model, c) in latest for c in cases)
        if not has_any:
            continue
        for case in cases:
            if (adapter, model, case) not in latest:
                missing[adapter][model].append(case)

total = sum(len(cs) for m in missing.values() for cs in m.values())
show_gaps = os.environ.get('SHOW_GAPS') == '1'
if total == 0:
    print('  all combinations complete!')
elif not show_gaps:
    combo_count = sum(len(m) for m in missing.values())
    print(f'  {total} missing across {combo_count} adapter/model combos. Run `bin/doctor --gaps` for fill commands.')
else:
    print(f'  {total} missing. Commands to fill the gaps:\n')
    for adapter in sorted(missing):
        for model in sorted(missing[adapter]):
            cases_list = ','.join(missing[adapter][model])
            runtime = runtime_for.get((adapter, model), 'lms')
            print(f'  bin/bench --runtime {runtime} --agent {adapter} --model {model} --cases {cases_list}')
        print()
PYEOF

# ── Next Steps ──────────────────────────────────────────────────────────────
# Only show if there are problems to fix
if [ ${#problems_found[@]} -gt 0 ]; then
  echo
  help_section "NEXT STEPS"

  # Build unique list of issues (dedup, handle special cases like adapter_missing:name)
  declare -A unique_problems
  for problem in "${problems_found[@]}"; do
    # For "adapter_missing:name" style, track adapter name separately
    if [[ "$problem" =~ ^adapter_missing: ]]; then
      adapter="${problem#adapter_missing:}"
      unique_problems["adapter_missing_${adapter}"]=1
    elif [[ "$problem" =~ ^model_not_installed: ]]; then
      profile="${problem#model_not_installed:}"
      unique_problems["model_not_installed_${profile}"]=1
    else
      unique_problems["$problem"]=1
    fi
  done

  step=1

  # Problem: LM Studio not reachable
  if [ -n "${unique_problems[lms_not_reachable]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Start LM Studio server${C_RST}"
    help_line "     ${C_GRN}\$ lms server start${C_RST}"
    ((step++))
  fi

  # Problem: No model loaded
  if [ -n "${unique_problems[no_model_loaded]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Load a model into LM Studio${C_RST}"
    help_line "     ${C_GRN}\$ lms load <model-id>${C_RST}"
    help_line "     ${C_DIM}Or browse available models:${C_RST} ${C_GRN}\$ lms ps${C_RST}"
    help_line "     ${C_DIM}Note: if model fails to load, check runtime compatibility:${C_RST}"
    help_line "     ${C_GRN}\$ lms runtime ls${C_RST}  ${C_DIM}(shows supported formats per engine)${C_RST}"
    ((step++))
  fi

  # Problem: LM Studio default context length not set to Model maximum
  if [ -n "${unique_problems[lms_context_not_max]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Set LM Studio's default context length to Model maximum${C_RST}"
    help_line "     ${C_GRN}\$ bin/lmstudio-context fix${C_RST}"
    help_line "     ${C_DIM}bin/smoke/bin/bench always pass an explicit -c and are unaffected;${C_RST}"
    help_line "     ${C_DIM}this only matters for models loaded via the LM Studio UI.${C_RST}"
    ((step++))
  fi

  # Problem: Missing adapters
  has_adapter_missing=false
  adapters_to_install=()
  for key in "${!unique_problems[@]}"; do
    if [[ "$key" =~ ^adapter_missing_ ]]; then
      has_adapter_missing=true
      adapter="${key#adapter_missing_}"
      adapters_to_install+=("$adapter")
    fi
  done
  if [ "$has_adapter_missing" = true ]; then
    adapters_str="$(IFS=,; echo "${adapters_to_install[*]}")"
    help_line "  ${step}. ${C_BLD}Install missing CLI adapters${C_RST}"
    help_line "     ${C_GRN}\$ bin/setup --agent $adapters_str${C_RST}"
    ((step++))
  fi

  # Problem: agent configs drifted from config.sh
  if [ -n "${unique_problems[agent_config_drift]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Wire agent configs to config.sh (endpoint/api key/model)${C_RST}"
    help_line "     ${C_GRN}\$ bin/agents-config --write${C_RST}"
    ((step++))
  fi

  # Problem: hf missing
  if [ -n "${unique_problems[hf_missing]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Install HuggingFace CLI (required for model downloads)${C_RST}"
    help_line "     ${C_GRN}\$ brew install huggingface-cli${C_RST}"
    ((step++))
  fi

  # Problem: Model not installed for detected profile
  profiles_to_install=()
  for key in "${!unique_problems[@]}"; do
    if [[ "$key" =~ ^model_not_installed_ ]]; then
      profile="${key#model_not_installed_}"
      profiles_to_install+=("$profile")
    fi
  done
  if [ ${#profiles_to_install[@]} -gt 0 ]; then
    help_line "  ${step}. ${C_BLD}Download and load the model for your hardware profile${C_RST}"
    for profile in "${profiles_to_install[@]}"; do
      help_line "     ${C_GRN}\$ bin/setup --model $profile${C_RST}"
    done
    ((step++))
  fi

  # Problem: LMS CLI missing
  if [ -n "${unique_problems[lms_cli_missing]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Install LM Studio CLI${C_RST}"
    help_line "     Needed to manage runtimes and models from the command line"
    help_line "     ${C_GRN}\$ npm install -g lm-cli${C_RST}"
    ((step++))
  fi

  # Problem: Runtime dylib broken (macOS security/update issue)
  if [ -n "${unique_problems[runtime_dylib_broken]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Recover from corrupted LM Studio runtime (macOS update issue)${C_RST}"
    help_line "     This typically happens after macOS updates tighten security policies."
    help_line "     Run the automated recovery:"
    help_line ""
    help_line "     ${C_GRN}\$ bin/recover-lms${C_RST}"
    help_line ""
    help_line "     ${C_DIM}Or manually:${C_RST}"
    help_line "     ${C_GRN}\$ lms daemon down && pkill -f 'LM Studio' && pkill -f lms || true${C_RST}"
    help_line "     ${C_GRN}\$ rm -rf ~/.lmstudio/extensions/backends ~/.lmstudio/cache${C_RST}"
    help_line "     ${C_GRN}\$ lms daemon up && lms runtime get default${C_RST}"
    help_line "     ${C_GRN}\$ lms load <model-id>${C_RST}"
    help_line ""
    help_line "     ${C_DIM}If symlink issues persist (dotfiles setup), move ~/.lmstudio out of${C_RST}"
    help_line "     ${C_DIM}symlinked directories temporarily during recovery.${C_RST}"
    ((step++))
  fi

  # Problem: Runtime cache corrupted
  if [ -n "${unique_problems[runtime_cache_corrupted]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Clear corrupted LM Studio cache${C_RST}"
    help_line "     ${C_GRN}\$ rm -rf ~/.lmstudio/extensions/backends${C_RST}"
    help_line "     ${C_GRN}\$ rm -rf ~/.lmstudio/cache${C_RST}"
    help_line "     ${C_GRN}\$ lms daemon down && lms daemon up${C_RST}"
    help_line "     ${C_GRN}\$ lms runtime ls${C_RST}  ${C_DIM}(verify runtimes recovered)${C_RST}"
    ((step++))
  fi

  # Problem: Runtime query failed (generic)
  if [ -n "${unique_problems[runtime_query_failed]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Check and manage LM Studio runtime engines${C_RST}"
    help_line "     ${C_GRN}\$ lms runtime ls${C_RST}          ${C_DIM}# list installed engines${C_RST}"
    help_line "     ${C_GRN}\$ lms runtime get${C_RST}         ${C_DIM}# download additional runtimes${C_RST}"
    help_line "     ${C_GRN}\$ lms runtime select${C_RST}      ${C_DIM}# switch between engines${C_RST}"
    help_line "     Different runtimes support different model formats (GGUF, safetensors, MLX, etc)"
    ((step++))
  fi

  # Problem: Hermes not ready
  if [ -n "${unique_problems[hermes_not_ready]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Configure Hermes sandbox settings${C_RST}"
    help_line "     Edit ${C_DIM}$HOME/.hermes/config.yaml${C_RST} to set up terminal backend:"
    help_line "     ${C_GRN}\$ nano $HOME/.hermes/config.yaml${C_RST}"
    help_line "     Then choose one configuration below:"
    help_line "       ${C_DIM}Option A:${C_RST} ${C_GRN}backend: local${C_RST} ${C_DIM}(runs on host, no sandbox)${C_RST}"
    help_line "       ${C_DIM}Option B:${C_RST} ${C_GRN}backend: docker${C_RST} + ${C_GRN}docker_mount_cwd_to_workspace: true${C_RST}"
    ((step++))
  fi

  # Problem: Stuck predictions
  if [ -n "${unique_problems[stuck_predictions]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Retry benchmarks with stuck predictions${C_RST}"
    help_line "     ${C_GRN}\$ bin/bench --resume${C_RST}"
    ((step++))
  fi

  # Problem: Cannot detect RAM
  if [ -n "${unique_problems[cannot_detect_ram]:-}" ]; then
    help_line "  ${step}. ${C_BLD}Manually set hardware profile in config.sh or environment${C_RST}"
    help_line "     ${C_GRN}\$ export PREFERRED_PROFILE=32gb${C_RST}"
    ((step++))
  fi

  # If step is still 1, no recognizable problems (shouldn't happen, but just in case)
  if [ "$step" -eq 1 ]; then
    help_line "  ${C_DIM}(problems detected, but detailed fixes not yet defined for this scenario)${C_RST}"
  fi

  echo ""
  help_section "NEXT STEPS"
  help_line "If all checks pass above:"
  help_line "  ${C_GRN}\$ bin/smoke${C_RST}                    # Quick L0 test (2 min)"
  help_line "  ${C_GRN}\$ bin/bench --agent aider --trials 1${C_RST}  # Try one adapter (5-10 min)"
  help_line ""
  help_line "For troubleshooting:"
  help_line "  ${C_GRN}\$ bin/debug${C_RST}                    # Advanced diagnostics"
  help_line "  ${C_GRN}\$ bin/recover-lms${C_RST}              # Recover corrupted LM Studio"
  help_line "  ${C_GRN}\$ bin/lms_gc${C_RST}                  # Free memory from idle models"
fi
