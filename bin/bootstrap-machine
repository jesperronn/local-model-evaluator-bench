#!/usr/bin/env bash
# bin/bootstrap-machine — propose or apply per-tier hardware profile edits.
#
# Reads machine hardware via bin/hwprofile, looks up the detected tier in
# profile.json, then generates models.txt + config.sh edits to match that tier.
#
# Usage:
#   bin/bootstrap-machine              show proposed changes (dry-run)
#   bin/bootstrap-machine --write       apply proposed changes
#   bin/bootstrap-machine --tier 64     override detected tier (for testing)
#
# Command Boundary Pattern (enforced across all bin/* scripts):
#   - Each script has ONE clear purpose and clean dependencies
#   - Output always includes "Next steps:" section listing exact next commands
#   - This ensures CLI discoverability: when a command finishes, the user knows
#     what to run next without reading docs. See bin/bench, bin/stale for examples.
#   - Scripts that mutate state (--write) show next steps after the mutation
#   - Dry-run/preview modes still show next steps so the flow is learnable
#
set -uo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
source "$HERE/lib/common.sh"
source "$HERE/bin/lib/help.sh" 2>/dev/null || true
[ -f "$HERE/config.sh" ] && source "$HERE/config.sh" || true

show_help() {
  help_header "bootstrap-machine" "propose or apply per-tier hardware profile edits"

  help_section "USAGE"
  help_line "  bootstrap-machine [OPTIONS]"

  help_section "DESCRIPTION"
  help_line "  Detects machine hardware via bin/hwprofile, looks up the detected"
  help_line "  tier in profile.json, then generates models.txt and config.sh edits"
  help_line "  to match that tier."

  help_section "OPTIONS"
  help_flag "--write" "" "apply proposed changes (default: dry-run preview only)"
  help_flag "--tier" "GB" "override detected tier (for testing)"
  help_flag "-h, --help" "" "show this help and exit"

  help_section "EXAMPLES"
  help_line "  Preview proposed changes for your detected tier:"
  help_line "  \$ bootstrap-machine"
  help_line ""
  help_line "  Apply the proposed changes:"
  help_line "  \$ bootstrap-machine --write"
  help_line ""
  help_line "  Test with a specific tier:"
  help_line "  \$ bootstrap-machine --tier 128"

  exit 0
}

WRITE=0
TIER_OVERRIDE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --write) WRITE=1; shift;;
    --tier) TIER_OVERRIDE="$2"; shift 2;;
    -h|--help) show_help;;
    *) die "unknown option: $1";;
  esac
done

# Detect machine tier via hwprofile
detect_tier() {
  [ -x "$HERE/bin/hwprofile" ] || die "bin/hwprofile not found"
  "$HERE/bin/hwprofile" --json | jq -r '.ram_tier_gb // "unknown"'
}

# Load profile.json and extract tier config
get_tier_config() {
  local tier="$1"
  [ -f "$HERE/profile.json" ] || die "profile.json not found"
  jq --arg t "$tier" '.tiers[$t] // empty' "$HERE/profile.json"
}

# Generate models.txt content from tier's primary (and secondary if present)
generate_models_txt() {
  local tier_config="$1" tier="$2"
  echo "# Generated by bin/bootstrap-machine for tier $tier GB"
  echo "# Source: $(echo "$tier_config" | jq -r '.primary.model') [primary]"
  if echo "$tier_config" | jq -e '.secondary' >/dev/null 2>&1; then
    echo "#        $(echo "$tier_config" | jq -r '.secondary.model') [secondary]"
  fi
  echo "# To restore manual edits, revert this file from git."
  echo ""
  echo "$tier_config" | jq -r '.primary.model'
  if echo "$tier_config" | jq -e '.secondary' >/dev/null 2>&1; then
    echo "$tier_config" | jq -r '.secondary.model'
  fi
}

# Generate config.sh edits from tier's primary config
generate_config_edits() {
  local tier_config="$1"
  local context parallel adapters ttl
  context=$(echo "$tier_config" | jq -r '.primary.context')
  parallel=$(echo "$tier_config" | jq -r '.primary.parallel')
  ttl=$(echo "$tier_config" | jq -r '.primary.ttl_minutes')
  adapters=$(echo "$tier_config" | jq -r '.primary.adapters | join(",")')

  cat <<EOF
export BENCH_CONTEXT="$context"
export BENCH_PARALLEL="$parallel"
export BENCH_TTL_MINUTES="$ttl"
export DEFAULT_ADAPTERS="$adapters"
EOF
}

main() {
  local tier tier_config new_models_txt new_config_edits

  # Detect or override tier
  if [ -n "$TIER_OVERRIDE" ]; then
    tier="$TIER_OVERRIDE"
    info "tier override: $tier GB"
  else
    tier="$(detect_tier)"
    [ "$tier" != "unknown" ] || die "failed to detect hardware tier"
    info "detected tier: $tier GB"
  fi

  # Get tier config from profile.json
  tier_config="$(get_tier_config "$tier")" || die "tier $tier not found in profile.json"

  benchmarked=$(echo "$tier_config" | jq -r '.benchmarked')
  [ "$benchmarked" = "true" ] && data_note="(benchmarked)" || data_note="(placeholder—awaits bin/qualify)"
  echo "Tier $tier GB — $data_note"
  echo ""

  # Generate new files
  new_models_txt="$(generate_models_txt "$tier_config" "$tier")"
  new_config_edits="$(generate_config_edits "$tier_config")"

  # Show diff for models.txt
  echo "────────────────────────────────────────────────────"
  echo "models.txt diff:"
  echo "────────────────────────────────────────────────────"
  diff -u "$HERE/models.txt" <(echo "$new_models_txt") || true
  echo ""

  # Show proposed config.sh edits
  echo "────────────────────────────────────────────────────"
  echo "config.sh edits:"
  echo "────────────────────────────────────────────────────"
  echo "$new_config_edits" | sed 's/^/  /'
  echo ""

  if [ "$WRITE" = 1 ]; then
    echo "Applying changes..."
    echo "$new_models_txt" > "$HERE/models.txt"

    # Update config.sh: preserve file structure, replace only the three key vars
    {
      grep -v '^export BENCH_CONTEXT\|^export BENCH_PARALLEL\|^export DEFAULT_ADAPTERS' "$HERE/config.sh"
      echo ""
      echo "$new_config_edits"
    } > "$HERE/config.sh.tmp"
    mv "$HERE/config.sh.tmp" "$HERE/config.sh"

    ok "bootstrap complete — models.txt and config.sh updated"
    echo ""
    echo "Next steps:"
    echo "  1. Download the primary model for your tier:"
    primary_model=$(echo "$tier_config" | jq -r '.primary.model')
    echo "     lms get $primary_model"
    echo "  2. Verify the config:"
    echo "     bin/bench --list"
    echo "  3. Start benchmarking:"
    echo "     bin/bench --runtime lms"
  else
    echo "${C_DIM}To apply these changes, run:${C_RST}"
    echo "  bin/bootstrap-machine --write"
  fi
}

main "$@"
