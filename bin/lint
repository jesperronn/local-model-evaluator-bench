#!/usr/bin/env bash
# bin/lint — unified linting tool (consolidates lint-adapters, lint-cards)
#
# Static checks for shell scripts, adapters, and documentation cards.
#
# Subcommands:
#   lint                  run all checks (scripts + adapters + cards)
#   lint --scripts        check shell scripts only (bash -n, shellcheck)
#   lint --adapters       check adapter scripts (bypass flags, agent recognition)
#   lint --cards          validate model/tool/runtime cards against CARD-SPEC.md
#   lint --fix            auto-fix fixable issues (cards)
#
# Exit 0 = clean, non-zero = lint errors.
set -uo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
cd "$HERE"

# Colors (disabled if NO_COLOR is set).
if [ -z "${NO_COLOR:-}" ]; then
  C_GRN=$'\033[32m'; C_RED=$'\033[31m'; C_YEL=$'\033[33m'
  C_BLD=$'\033[1m'; C_DIM=$'\033[2m'; C_RST=$'\033[0m'
else
  C_GRN=; C_RED=; C_YEL=; C_BLD=; C_DIM=; C_RST=
fi

LINT_VERBOSE=0
DO_SCRIPTS=0
DO_ADAPTERS=0
DO_CARDS=0
DO_FIX=0

source "$HERE/lib/common.sh"
source "$HERE/bin/lib/help.sh"

show_help() {
  help_header "lint" "unified validation tool for scripts, adapters, and cards"
  help_section "USAGE"
  help_line "  lint [OPTIONS]"

  help_section "DESCRIPTION"
  help_line "  Run all checks by default, or select specific ones with flags."

  help_section "OPTIONS"
  help_flag "--scripts" "" "check shell scripts (bash -n, shellcheck)"
  help_flag "--adapters" "" "check adapter scripts (bypass flags, registration)"
  help_flag "--cards" "" "validate model/tool/runtime cards"
  help_flag "--fix" "" "auto-fix fixable issues (cards)"
  help_flag "--verbose, -v" "" "show detailed output"
  help_flag "-h, --help" "" "show this help and exit"

  help_section "EXAMPLES"
  help_line "  Run all checks:"
  help_line "    \$ lint"
  help_line ""
  help_line "  Check only shell scripts:"
  help_line "    \$ lint --scripts"
  help_line ""
  help_line "  Fix card issues:"
  help_line "    \$ lint --cards --fix"
}

usage() {
  cat <<'EOF'
Usage: bin/lint [OPTIONS]

Run validation checks on scripts, adapters, and cards.
With no flags, runs all checks.

Use --help for full options.
EOF
}

# ── Parse flags ─────────────────────────────────────────────────────────────
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) show_help; exit 0;;
    --scripts) DO_SCRIPTS=1; shift;;
    --adapters) DO_ADAPTERS=1; shift;;
    --cards) DO_CARDS=1; shift;;
    --fix) DO_FIX=1; shift;;
    --verbose|-v) LINT_VERBOSE=1; shift;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2;;
  esac
done

# If no specific checks requested, do all
if [ "$DO_SCRIPTS" -eq 0 ] && [ "$DO_ADAPTERS" -eq 0 ] && [ "$DO_CARDS" -eq 0 ]; then
  DO_SCRIPTS=1
  DO_ADAPTERS=1
  DO_CARDS=1
fi

overall_fail=0

# ── SCRIPTS CHECK ────────────────────────────────────────────────────────────
if [ "$DO_SCRIPTS" -eq 1 ]; then
  info "Checking shell scripts..."

  # Emit the list of shell scripts to lint.
  collect_shell_files() {
    {
      find bin -type f -not -name '*.test.sh'
      find lib -type f -name '*.sh'
      [ -f config.sh ] && printf '%s\n' config.sh
    } | sort -u
  }

  is_shell_file() {
    local f="$1"
    case "$f" in
      *.sh) return 0;;
    esac
    [ -f "$f" ] && head -1 "$f" 2>/dev/null | grep -qE '^#!.*\b(ba)?sh\b'
  }

  local -a files=()
  local f fail=0
  for f in $(collect_shell_files); do
    is_shell_file "$f" && files+=("$f")
  done

  if [ "${#files[@]}" -eq 0 ]; then
    warn "No shell files found"
  else
    # Syntax check
    for f in "${files[@]}"; do
      if bash -n "$f" 2>/tmp/lint_syntax.$$; then
        :
      else
        echo "${C_RED}[FAIL]${C_RST} syntax: $f"
        sed 's/^/    /' /tmp/lint_syntax.$$ || true
        fail=1
      fi
    done
    rm -f /tmp/lint_syntax.$$

    # shellcheck
    if command -v shellcheck >/dev/null 2>&1; then
      [ "$LINT_VERBOSE" -eq 1 ] && printf '%s shellcheck %d files\n' "${C_DIM}==>${C_RST}" "${#files[@]}"
      if ! shellcheck -x -e SC1091 "${files[@]}" 2>/dev/null; then
        fail=1
      fi
    else
      warn "shellcheck not installed; syntax checks only"
    fi

    if [ "$fail" -eq 0 ]; then
      ok "$((${#files[@]})) shell scripts clean"
    else
      echo "${C_RED}[FAIL]${C_RST} script lint errors found" >&2
      overall_fail=1
    fi
  fi
  echo ""
fi

# ── ADAPTERS CHECK ───────────────────────────────────────────────────────────
if [ "$DO_ADAPTERS" -eq 1 ]; then
  info "Checking adapter scripts..."

  BYPASS_PATTERN='--yes-always|--dangerously-bypass-approvals-and-sandbox|--allow-dangerously-skip-permissions|--auto-approve|--yolo|--no-git\b|--no-auto-commits|--no-dirty-commits|--no-ask-user|--allow-all-tools|--allow-all-paths'

  local adapter_fail=0
  for adapter in "$HERE/adapters"/*.sh; do
    name="$(basename "$adapter")"

    # Syntax check
    if ! bash -n "$adapter" 2>/tmp/lint-syntax-err; then
      echo "${C_RED}[FAIL]${C_RST} $name  syntax error: $(cat /tmp/lint-syntax-err)"
      adapter_fail=1
      continue
    fi

    # Bypass flags at top-level
    toplevel="$(awk '
      /if \[ ! -t 0 \]/ { depth++; next }
      depth > 0 && /^[[:space:]]*fi[[:space:]]*(#.*)?$/ { depth--; next }
      depth > 0 { next }
      { print }
    ' "$adapter")"

    if echo "$toplevel" | grep -qE -e "$BYPASS_PATTERN"; then
      bad_lines="$(echo "$toplevel" | grep -nE -e "$BYPASS_PATTERN")"
      echo "${C_RED}[FAIL]${C_RST} $name  bypass flag outside non-interactive branch:"
      echo "$bad_lines" | while IFS= read -r line; do
        printf '         %s%s%s\n' "${C_DIM}" "$line" "${C_RST}"
      done
      adapter_fail=1
    fi
  done

  # Check agent registration
  known_agents="$(awk '
    /^get_agent_cli_cmd\(\)/ { in_fn=1; next }
    in_fn && /^\}/ { exit }
    in_fn { print }
  ' "$HERE/bin/setup" | grep -oE '^[[:space:]]*[a-z0-9_-]+\)' | tr -d ') ')"

  for agent in $(cd "$HERE/adapters" && ls -1 *.sh 2>/dev/null | sed -E 's/-(proxy-ollama|lms|mlx|omlx|ollama)\.sh$//; s/\.sh$//' | sort -u); do
    if ! echo "$known_agents" | grep -qxF "$agent"; then
      echo "${C_RED}[FAIL]${C_RST} agent '$agent' has an adapter but is missing from bin/setup"
      adapter_fail=1
    fi
  done

  if [ "$adapter_fail" -eq 0 ]; then
    ok "adapters clean"
  else
    overall_fail=1
  fi
  echo ""
fi

# ── CARDS CHECK ──────────────────────────────────────────────────────────────
if [ "$DO_CARDS" -eq 1 ]; then
  info "Checking documentation cards..."

  if [ "$DO_FIX" -eq 1 ]; then
    # Call bin/fix-card with --loop (if available)
    if [ -x "$HERE/bin/fix-card" ]; then
      "$HERE/bin/fix-card" || overall_fail=1
    else
      warn "bin/fix-card not found; cannot auto-fix"
    fi
  else
    # Call bin/lint-cards (preserves existing behavior)
    if [ -x "$HERE/bin/lint-cards" ]; then
      "$HERE/bin/lint-cards" || overall_fail=1
    else
      warn "bin/lint-cards not found"
    fi
  fi
  echo ""
fi

# ── Summary and next steps ───────────────────────────────────────────────────
if [ "$overall_fail" -eq 0 ]; then
  ok "all checks passed"
  echo ""
  help_next_steps_section \
    "Run full benchmark|bin/bench --agent aider" \
    "Run overnight validation|bin/bench-overnight --stale" \
    "Commit changes|git add . && git commit"
else
  echo "${C_RED}[FAIL]${C_RST} lint errors found" >&2
  exit 1
fi
