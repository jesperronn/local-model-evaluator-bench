#!/usr/bin/env bash
# bin/setup — check and install tools used by the bench.
#
# With no flags: prints a status table for every tool (read-only).
# With tool flags: installs/configures those tools.
# --dry-run always safe — prints what would run, touches nothing.
#
# Flags:
#   --dry-run          show commands without running them
#   --verbose          extra output during installs
#   --interactive      use fzf pickers where applicable
#   --agent <names>    comma-separated agents (e.g., --agent aider,hermes)
#
# Tool flags (combine freely, or use --all):
#   --all              every tool below
#   --lms              LM Studio CLI (lms)
#   --hermes-cli       Hermes agent CLI
#   --codex-cli        OpenAI Codex CLI
#   --opencode-cli     OpenCode CLI
#   --aider-cli        Aider CLI
#   --caveman-cli      Caveman (pi-based coding agent)
#   --mlx-server       mlx-lm Python package (mlx_lm.server)
#   --omlx             oMLX multi-model MLX server (checks install, reports models)
#   --ollama           Ollama runtime
#   --fzf              fzf (required for --interactive pickers)
#   --hf               HuggingFace CLI (required for bin/lms_update)
#   --litellm          uv, prerequisite for the optional bin/rt litellm proxy
#
# Model flags:
#   --model            show model status across runtimes
#   --runtime lms|ollama|mlx|omlx  filter --model to one runtime
#   --sync-models      regenerate opencode/pi model configs from installed
#                      models (bin/agents-config --write); status-only
#                      runs and --opencode-cli/--caveman-cli always show a
#                      one-line drift warning even without this flag
set -uo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
source "$HERE/config.sh"; source "$HERE/lib/common.sh"; source "$HERE/bin/lib/help.sh"
source "$HERE/bin/lib/model-profiles.sh"

# ── Hardware detection ───────────────────────────────────────────────────────
detect_system_ram_gb() {
  case "$(uname -s)" in
    Darwin) sysctl -n hw.memsize 2>/dev/null | awk '{printf "%d", $1 / 1024 / 1024 / 1024}';;
    Linux)  grep MemTotal /proc/meminfo 2>/dev/null | awk '{printf "%d", $2 / 1024 / 1024}';;
    *)      echo "0";;
  esac
}

suggest_profile_for_ram() {
  local ram_gb="$1"
  if [ "$ram_gb" -ge 128 ]; then
    echo "128gb"
  elif [ "$ram_gb" -ge 64 ]; then
    echo "64gb"
  elif [ "$ram_gb" -ge 32 ]; then
    echo "32gb"
  elif [ "$ram_gb" -ge 24 ]; then
    echo "24gb"
  else
    echo ""
  fi
}

# ── Help ─────────────────────────────────────────────────────────────────────
get_available_agents() {
  # Extract unique agent names from adapters/ directory. Strips the trailing
  # -<runtime>.sh suffix rather than everything after the first hyphen, so
  # multi-word agent names (e.g. mini-swe-agent) survive intact.
  (cd "$HERE/adapters" && ls -1 *.sh 2>/dev/null | sed -E 's/-(proxy-ollama|lms|mlx|omlx|ollama)\.sh$//; s/\.sh$//' | sort -u)
}

show_help() {
  help_header "setup" "check and install tools used by the bench"

  help_section "USAGE"
  help_line "  setup [OPTIONS] [TOOL_FLAGS]"

  help_section "DESCRIPTION"
  help_line "  With no flags: prints a status table for every tool (read-only)."
  help_line "  With tool flags: installs/configures those tools."
  help_line "  With --model <profile>: downloads recommended models for that hardware tier."

  help_section "OPTIONS"
  help_flag "--dry-run" "" "show commands without running them"
  help_flag "--verbose" "" "extra output during installs"
  help_flag "--interactive" "" "use fzf pickers where applicable"
  help_flag "--force" "" "actually install (without --force, shows what would change)"
  help_flag "--agent" "<names>" "comma-separated agents (e.g., aider,hermes,cline)"

  help_section "TOOL FLAGS"
  help_flag "--all" "" "install every tool below"
  help_flag "--lms" "" "LM Studio CLI (lms)"
  help_flag "--hermes-cli" "" "Hermes agent CLI"
  help_flag "--codex-cli" "" "OpenAI Codex CLI"
  help_flag "--opencode-cli" "" "OpenCode CLI"
  help_flag "--aider-cli" "" "Aider CLI"
  help_flag "--caveman-cli" "" "Caveman (pi-based coding agent)"
  help_flag "--mlx-server" "" "mlx-lm Python package (mlx_lm.server)"
  help_flag "--omlx" "" "oMLX multi-model MLX server"
  help_flag "--ollama" "" "Ollama runtime"
  help_flag "--fzf" "" "fzf (required for --interactive pickers)"
  help_flag "--litellm" "" "uv, prerequisite for the optional bin/rt litellm proxy"
  help_flag "--hf" "" "HuggingFace CLI (required for bin/lms_update)"

  help_section "MODEL FLAGS"
  help_flag "--model" "[PROFILE]" "show model status (or download PROFILE if specified)"
  help_flag "--runtime" "lms|ollama|mlx|omlx" "filter --model to one runtime"
  help_flag "--sync-models" "" "regenerate opencode/pi model configs"

  help_section "AVAILABLE AGENTS"
  help_line "  $(get_available_agents | tr '\n' ' ')"

  help_section "EXAMPLES"
  help_line "  setup --agent aider        # show status for aider agent"
  help_line "  setup --agent aider,hermes --dry-run  # status for multiple agents"
  help_line "  setup --all --force        # install all tools"

  help_section "TROUBLESHOOTING"
  help_line "  If LM Studio fails with 'library not loaded' or format errors after"
  help_line "  a macOS update, run the recovery script to clear corrupted cache:"
  help_line "    bin/recover-lms"

  help_section "OPTIONS"
  help_flag "-h, --help" "" "show this help and exit"
}

# ── Parse flags ──────────────────────────────────────────────────────────────
DRY_RUN=0; VERBOSE=0; INTERACTIVE=0; FORCE=0
NEEDS_FORCE=0; STATUS_ONLY=0
DO_ALL=0
DO_LMS=0; DO_HERMES=0; DO_CODEX=0; DO_OPENCODE=0; DO_AIDER=0
DO_CAVEMAN=0; DO_MLX=0; DO_OMLX=0; DO_OLLAMA=0; DO_FZF=0; DO_HF=0; DO_LITELLM=0
DO_MODEL=0; MODEL_PROFILE=""; RUNTIME=""
DO_SYNC=0
AGENT_FILTER=""; DO_AGENT=0

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)        DRY_RUN=1; shift;;
    --verbose)        VERBOSE=1; shift;;
    --interactive)    INTERACTIVE=1; shift;;
    --force)          FORCE=1; shift;;
    --all)            DO_ALL=1; shift;;
    --lms)            DO_LMS=1; shift;;
    --hermes-cli)     DO_HERMES=1; shift;;
    --codex-cli)      DO_CODEX=1; shift;;
    --opencode-cli)   DO_OPENCODE=1; shift;;
    --aider-cli)      DO_AIDER=1; shift;;
    --caveman-cli)    DO_CAVEMAN=1; shift;;
    --mlx-server)     DO_MLX=1; shift;;
    --omlx)           DO_OMLX=1; shift;;
    --ollama)         DO_OLLAMA=1; shift;;
    --fzf)            DO_FZF=1; shift;;
    --litellm)        DO_LITELLM=1; shift;;
    --hf)             DO_HF=1; shift;;
    --agent)          DO_AGENT=1; AGENT_FILTER="$2"; shift 2;;
    --model)          DO_MODEL=1; MODEL_PROFILE="${2:-}"; shift; [ -n "$MODEL_PROFILE" ] && shift || true;;
    --sync-models)    DO_SYNC=1; shift;;
    --runtime)        RUNTIME="$2"; shift 2;;
    -h|--help) show_help; exit 0;;
    *) die "unknown option: $1";;
  esac
done

if [ "$DO_ALL" = 1 ]; then
  DO_LMS=1; DO_HERMES=1; DO_CODEX=1; DO_OPENCODE=1; DO_AIDER=1
  DO_CAVEMAN=1; DO_MLX=1; DO_OMLX=1; DO_OLLAMA=1; DO_FZF=1; DO_HF=1; DO_LITELLM=1
fi

# ── Helpers ───────────────────────────────────────────────────────────────────
step() { printf '\n%s\n' "${C_BLD}$*${C_RST}"; }

NEEDS_FORCE=0

run_or_dry() {
  # In STATUS_ONLY mode without --force, act like dry-run
  local effective_dry_run=$DRY_RUN
  if [ "$STATUS_ONLY" = 1 ] && [ "$FORCE" = 0 ]; then
    effective_dry_run=1
    NEEDS_FORCE=1
  fi

  if [ "$effective_dry_run" = 1 ]; then
    printf '  %s%s%s\n' "$C_DIM" "would run: $*" "$C_RST"
  else
    [ "$VERBOSE" = 1 ] && info "running: $*"
    "$@"
  fi
}

# check_cmd NAME CMD INSTALL_CMD [NOTES]
# Prints ok/warn; returns 0 if installed, 1 if not.
# In STATUS_ONLY mode, tracks missing items for --force suggestion.
check_cmd() {
  local name="$1" cmd="$2" install="$3" notes="${4:-}"
  if command -v "$cmd" >/dev/null 2>&1; then
    local ver; ver="$(command -v "$cmd")"
    ok "$name  ${C_DIM}$(command -v "$cmd")${C_RST}"
    return 0
  else
    warn "$name  ${C_DIM}not found${C_RST}"
    printf '    install: %s\n' "$install"
    [ -n "$notes" ] && printf '    %s\n' "$notes"
    if [ "$STATUS_ONLY" = 1 ]; then
      NEEDS_FORCE=1
    fi
    return 1
  fi
}

# do_install NAME CMD BREW_PKG [NPM_PKG|pip:PKG|manual:URL]
do_install() {
  local name="$1" cmd="$2" pkg="$3"
  command -v "$cmd" >/dev/null 2>&1 && { ok "$name already installed"; return 0; }
  info "installing $name..."
  case "$pkg" in
    pip:*)   run_or_dry pip3 install "${pkg#pip:}";;
    npm:*)   run_or_dry npm install --global "${pkg#npm:}";;
    manual:*) warn "$name must be installed manually: ${pkg#manual:}"; return 1;;
    *)       run_or_dry brew install "$pkg";;
  esac
}

# ── Tool definitions ──────────────────────────────────────────────────────────

show_lms_runtimes() {
  step "LM Studio runtime engines"
  if ! command -v lms >/dev/null 2>&1; then
    warn "lms CLI not installed — install with: bin/setup --lms"
    return
  fi

  if ! _runtimes="$(lms runtime ls 2>/dev/null)" || [ -z "$_runtimes" ]; then
    warn "could not query runtime engines"
    return
  fi

  # Find selected runtime
  _selected="$(printf '%s\n' "$_runtimes" | grep '✓' | head -1)"
  if [ -n "$_selected" ]; then
    _name="$(printf '%s' "$_selected" | awk '{print $1}')"
    ok "selected: $_name"
    echo "  available:"
    printf '%s\n' "$_runtimes" | tail -n +2 | sed 's/^/    /'
    echo
    echo "  ${C_DIM}Manage runtimes:${C_RST}"
    echo "    ${C_GRN}\$ lms runtime get${C_RST}      ${C_DIM}download additional runtime${C_RST}"
    echo "    ${C_GRN}\$ lms runtime select${C_RST}   ${C_DIM}switch to a different runtime${C_RST}"
    echo "    ${C_GRN}\$ lms runtime update${C_RST}   ${C_DIM}update installed runtimes${C_RST}"
  else
    warn "could not detect selected runtime"
  fi
}

setup_lms() {
  step "LM Studio (lms)"
  if ! check_cmd "lms CLI" lms "brew install --cask lm-studio" \
       "or download from https://lmstudio.ai"; then
    [ "$DO_LMS" = 1 ] && do_install "LM Studio" lms "manual:https://lmstudio.ai"
    return
  fi
  [ "$DO_LMS" = 0 ] && return
  # Config: start server
  if lms_up; then
    ok "server reachable at $LMS_BASE_URL"
  else
    warn "server not running"
    printf '    start with: lms server start\n'
    run_or_dry lms server start
  fi
}

setup_hermes() {
  step "Hermes agent CLI"
  if ! check_cmd "hermes" hermes "brew install hermes-agent"; then
    [ "$DO_HERMES" = 1 ] && do_install "hermes" hermes "hermes-agent"
    return
  fi
  [ "$DO_HERMES" = 0 ] && return
  # Config: ~/.hermes/config.yaml
  local cfg="$HOME/.hermes/config.yaml"
  local backend approvals
  backend="$(grep -A1 '^terminal:' "$cfg" 2>/dev/null | sed -nE 's/^[[:space:]]*backend:[[:space:]]*([a-z]+).*/\1/p' | head -1)"
  approvals="$(grep -A1 '^approvals:' "$cfg" 2>/dev/null | sed -nE 's/^[[:space:]]*mode:[[:space:]]*([a-z]+).*/\1/p' | head -1)"
  if [ "${backend:-}" = local ] && [ "${approvals:-}" = smart ]; then
    ok "config  ${C_DIM}backend=local approvals=smart${C_RST}"
  else
    warn "config needs update  ${C_DIM}backend=${backend:-?} approvals=${approvals:-?}${C_RST}"
    printf '    In %s set:\n' "$cfg"
    printf '      terminal:\n        backend: local\n      approvals:\n        mode: smart\n'
    if [ "$DRY_RUN" = 0 ]; then
      # Idempotent: only append what's missing
      if [ "${backend:-}" != local ]; then
        run_or_dry bash -c "printf '\nterminal:\n  backend: local\n' >> '$cfg'"
      fi
      if [ "${approvals:-}" != smart ]; then
        run_or_dry bash -c "printf '\napprovals:\n  mode: smart\n' >> '$cfg'"
      fi
    else
      run_or_dry true  # show dry-run marker
    fi
  fi
}

# Runs bin/agents-config against installed models. Dry-run shows a
# one-line drift status; with --sync-models (or DO_SYNC=1) applies it.
_sync_status() {
  local label="$1"; shift
  [ -x "$HERE/bin/agents-config" ] || return 0
  if [ "$DO_SYNC" = 1 ] && [ "$DRY_RUN" = 0 ]; then
    "$@" --write | sed "s/^/    [$label] /"
  else
    local out; out="$("$@" 2>&1)"
    if printf '%s\n' "$out" | grep -q "up to date"; then
      ok "agent model config in sync  ${C_DIM}(bin/agents-config)${C_RST}"
    else
      warn "agent model config drifted from installed models"
      printf '    run: bin/agents-config --write\n'
    fi
  fi
}

setup_codex() {
  step "Codex CLI"
  if ! check_cmd "codex" codex "npm install --global @openai/codex"; then
    [ "$DO_CODEX" = 1 ] && do_install "codex" codex "npm:@openai/codex"
    return
  fi
  [ "$DO_CODEX" = 0 ] && return
  ok "no persistent config needed (inline -c flags in adapter)"
}

setup_opencode() {
  step "OpenCode CLI"
  if ! check_cmd "opencode" opencode "brew install opencode"; then
    [ "$DO_OPENCODE" = 1 ] && do_install "opencode" opencode "opencode"
    return
  fi
  _sync_status opencode "$HERE/bin/agents-config" --opencode-only
  [ "$DO_OPENCODE" = 0 ] && return
  ok "endpoint/api key wired from config.sh (bin/agents-config, applied below)"
}

setup_aider() {
  step "Aider CLI"
  if ! check_cmd "aider" aider "brew install aider  # or: pip install aider-chat"; then
    [ "$DO_AIDER" = 1 ] && do_install "aider" aider "aider"
    return
  fi
  [ "$DO_AIDER" = 0 ] && return
  ok "~/.aider.conf.yaml wired from config.sh (bin/agents-config, applied below)"
}

setup_caveman() {
  step "Caveman (pi-based agent)"
  if ! check_cmd "caveman" caveman "npm install --global @juliusbrussee/caveman-code"; then
    [ "$DO_CAVEMAN" = 1 ] && do_install "caveman" caveman "npm:@juliusbrussee/caveman-code"
    return
  fi
  _sync_status pi "$HERE/bin/agents-config" --pi-only
  [ "$DO_CAVEMAN" = 0 ] && return
  # Config: ~/.pi/agent/models.json
  local models_json="$HOME/.pi/agent/models.json"
  if [ -f "$models_json" ]; then
    ok "provider config  ${C_DIM}$models_json${C_RST}"
  else
    warn "provider config missing: $models_json"
    local tmpl="$HERE/config-templates/pi-agent-models.json"
    if [ -f "$tmpl" ]; then
      printf '    copy template: cp %s %s\n' "$tmpl" "$models_json"
      if [ "$DRY_RUN" = 0 ]; then
        run_or_dry mkdir -p "$(dirname "$models_json")"
        run_or_dry cp "$tmpl" "$models_json"
      else
        run_or_dry true
      fi
    else
      printf '    create %s with lmstudio provider — see docs/SETUP.md\n' "$models_json"
    fi
  fi
}

setup_mlx() {
  step "MLX-LM server (mlx_lm.server)"
  if ! check_cmd "mlx_lm.server" mlx_lm.server "pip install mlx-lm"; then
    [ "$DO_MLX" = 1 ] && do_install "mlx-lm" mlx_lm.server "mlx-lm"
    return
  fi
  [ "$DO_MLX" = 0 ] && return
  ok "start with: mlx_lm.server --model mlx-community/<model-name>"
  local mlx_models="$HERE/models-mlx.txt"
  if [ -f "$mlx_models" ]; then
    ok "models file: $mlx_models"
  else
    warn "models-mlx.txt not found — create it with HuggingFace model ids (mlx-community/...)"
  fi
}

setup_omlx() {
  step "oMLX server (multi-model MLX)"
  local cli="${OMLX_CLI:-/Applications/oMLX.app/Contents/MacOS/omlx-cli}"
  if [ ! -x "$cli" ]; then
    warn "oMLX not installed — download it from https://omlx.app (or set OMLX_CLI)"
    return
  fi
  ok "installed: $(/usr/bin/defaults read /Applications/oMLX.app/Contents/Info CFBundleShortVersionString 2>/dev/null || echo present)"
  if omlx_up; then
    ok "running at $OMLX_BASE_URL — $(omlx_models | wc -l | tr -d ' ') models served"
  else
    warn "not running — start with: bin/omlx start"
  fi
  [ "$DO_OMLX" = 0 ] && return
  ok "models directory: $OMLX_MODELS_DIR"
  ok "bench with: bin/bench --runtime omlx --model <id>   (ids: bin/omlx models)"
}

setup_ollama() {
  step "Ollama runtime"
  if ! check_cmd "ollama" ollama "brew install ollama"; then
    [ "$DO_OLLAMA" = 1 ] && do_install "ollama" ollama "ollama"
    return
  fi
  [ "$DO_OLLAMA" = 0 ] && return
  # Check if running
  if curl -fsS --max-time 3 "http://localhost:11434/api/version" >/dev/null 2>&1; then
    local ver; ver="$(curl -fsS http://localhost:11434/api/version 2>/dev/null | grep -oE '"version":"[^"]+"' | cut -d'"' -f4)"
    ok "server running  ${C_DIM}v${ver}${C_RST}"
  else
    warn "server not running"
    printf '    start with: ollama serve\n'
    [ "$DRY_RUN" = 0 ] && info "run 'ollama serve' in a separate terminal to start"
  fi
  local ollama_models="$HERE/models-ollama.txt"
  if [ -f "$ollama_models" ]; then
    ok "models file: $ollama_models"
    info "installed Ollama models:"
    ollama list 2>/dev/null | tail -n +2 | sed 's/^/    /'
  else
    warn "models-ollama.txt not found — create it with Ollama model ids"
  fi
}

setup_fzf() {
  step "fzf (interactive pickers)"
  check_cmd "fzf" fzf "brew install fzf" || \
    { [ "$DO_FZF" = 1 ] && do_install "fzf" fzf "fzf"; }
}

setup_hf() {
  step "HuggingFace CLI (hf)"
  check_cmd "hf" hf "brew install hf  # required for bin/lms_update" || \
    { [ "$DO_HF" = 1 ] && do_install "hf" hf "hf"; }
}

setup_litellm() {
  # Optional: bin/rt litellm proxy runs litellm via uvx, so uv is the only real
  # prerequisite — nothing to install up front.
  step "LiteLLM proxy (optional, via uvx)"
  check_cmd "uv" uv "brew install uv  # required by bin/rt litellm proxy" || \
    { [ "$DO_LITELLM" = 1 ] && do_install "uv" uv "uv"; }
}

# ── Agent configuration ───────────────────────────────────────────────────────

# Map common agent names to CLI commands
get_agent_cli_cmd() {
  local agent="$1"
  case "$agent" in
    aider)     echo "aider";;
    hermes)    echo "hermes";;
    codex)     echo "codex";;
    opencode)  echo "opencode";;
    caveman)   echo "caveman";;
    cline)     echo "cline";;
    claude)    echo "claude";;
    copilot)   echo "copilot";;
    goose)     echo "goose";;
    gptme)     echo "gptme";;
    interpreter) echo "interpreter";;
    cn)        echo "cn";;
    openhands) echo "openhands";;
    pi)        echo "pi";;
    forge)     echo "forge";;
    mini-swe-agent) echo "mini-swe-agent";;
    nanocoder) echo "nanocoder";;
    qwen)      echo "qwen";;
    *) return 1;;
  esac
}

# Get brew/npm/pip install command for agent
get_agent_install_cmd() {
  local agent="$1"
  case "$agent" in
    aider)     echo "brew install aider  # or: pip install aider-chat";;
    hermes)    echo "brew install hermes-agent";;
    codex)     echo "npm install --global @openai/codex";;
    opencode)  echo "brew install opencode";;
    caveman)   echo "npm install --global @juliusbrussee/caveman-code";;
    cline)     echo "npm install --global cline";;
    claude)    echo "npm install --global claude";;
    copilot)   echo "npm install --global @github-copilot/copilot-cli";;
    goose)     echo "brew install goose  # or: pip install goose-code";;
    gptme)     echo "pip install gpt-me";;
    interpreter) echo "pip install open-interpreter";;
    cn)        echo "npm install --global cn";;
    openhands) echo "npm install --global @openhands/agent-canvas";;
    pi)        echo "npm install --global @earendil-works/pi-coding-agent";;
    forge)     echo "npm install --global @hoangsonw/forge";;
    mini-swe-agent) echo "python3 -m pip install --break-system-packages mini-swe-agent";;
    nanocoder) echo "npm install --global @nanocollective/nanocoder";;
    qwen)      echo "npm install --global @qwen-code/qwen-code";;
    *) return 1;;
  esac
}

# Get configuration guidance for agent
get_agent_config_guidance() {
  local agent="$1"
  case "$agent" in
    aider)
      printf "  Configuration file: ~/.aider.conf.yaml (openai-api-base, model)\n"
      printf "  Wired from config.sh by: bin/agents-config --agent aider --write\n"
      ;;
    hermes)
      printf "  Configuration file: ~/.hermes/config.yaml\n"
      printf "  Required settings:\n"
      printf "    terminal:\n      backend: local\n    approvals:\n      mode: smart\n"
      ;;
    codex)
      printf "  Codex uses -c flags inline (no persistent config needed).\n"
      printf "  Configure API key via environment variables.\n"
      ;;
    opencode)
      printf "  Configuration file: ~/.config/opencode/opencode.jsonc\n"
      printf "  Model list + endpoint wired by: bin/agents-config --opencode-only --write\n"
      ;;
    caveman)
      printf "  Configuration file: ~/.pi/agent/models.json\n"
      printf "  Template: config-templates/pi-agent-models.json\n"
      printf "  Generated by: bin/agents-config --pi-only\n"
      ;;
    cline)
      printf "  Cline stores settings in VSCode/IDE settings.\n"
      printf "  Configure API endpoint and model in IDE settings.\n"
      ;;
    claude)
      printf "  Claude CLI configuration stored in ~/.claude/settings.json\n"
      printf "  Configure default model and API endpoint.\n"
      ;;
    goose)
      printf "  Goose uses configuration files in ~/.goose/\n"
      printf "  Configure API endpoint and model settings.\n"
      ;;
    pi)
      printf "  pi requires a model ID at runtime (no persistent config).\n"
      printf "  Available models in LM Studio:\n"
      printf "    \$ lms ls           (list all models)\n"
      printf "    \$ lms loaded       (show currently loaded model)\n"
      printf "\n"
      printf "  To evaluate with pi, use:\n"
      printf "    \$ bin/eval-agent --via lms --model <model-id>\n"
      printf "\n"
      printf "  Example:\n"
      printf "    \$ lms ls          # find a model ID like qwen/qwen3.6-35b\n"
      printf "    \$ bin/eval-agent --via lms --model qwen/qwen3.6-35b\n"
      ;;
    forge)
      printf "  Forge uses OPENAI_API_BASE / OPENAI_API_KEY env vars (no persistent config).\n"
      ;;
    mini-swe-agent)
      printf "  Routes through LiteLLM via OPENAI_API_BASE / OPENAI_API_KEY env vars.\n"
      ;;
    nanocoder)
      printf "  No config file: provider JSON is passed via the NANOCODER_PROVIDERS env var.\n"
      ;;
    qwen)
      printf "  No settings.json needed — Qwen Code's \"openai\" auth type is selected by\n"
      printf "  OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL alone.\n"
      printf "  Calls home to Alibaba by default on 3 separate paths (telemetry, a\n"
      printf "  startup preconnect, an update check) unless suppressed — see\n"
      printf "  adapters/qwen-omlx.sh and docs/HANDOFF-phone-home-audit.md.\n"
      ;;
    *)
      printf "  See adapter: adapters/%s-*.sh for configuration details.\n" "$agent"
      ;;
  esac
}

# Show agent status and configuration
show_agent_status() {
  local agent="$1"
  local cmd; cmd="$(get_agent_cli_cmd "$agent")"

  if [ -z "$cmd" ]; then
    warn "Agent '$agent' not recognized"
    return 1
  fi

  step "Agent: $agent"

  if ! check_cmd "$agent" "$cmd" "$(get_agent_install_cmd "$agent")"; then
    return 1
  fi

  # Show configuration guidance
  echo
  info "Configuration guidance:"
  get_agent_config_guidance "$agent"

  # Show next steps
  echo
  info "Next steps:"
  printf "  1. Configure the agent per guidance above\n"
  printf "  2. Test with: bin/smoke --agent %s --dry-run\n" "$agent"
  printf "  3. Run evaluation: bin/eval-agent --via lms --model <model-id>\n"
}

# ── Model status ──────────────────────────────────────────────────────────────

setup_model_profile() {
  local profile="$1"
  source "$HERE/bin/lib/model-profiles.sh"

  step "Models for profile: $profile"

  if ! profile_exists "$profile"; then
    die "Profile '$profile' not found. Available: $(profiles_list)"
  fi

  local desc; desc="$(profile_description "$profile")"
  ok "$desc"

  local aliases; aliases="$(profile_aliases "$profile")"
  [ -z "$aliases" ] && { warn "no aliases in profile"; return 0; }

  local primary; primary="$(profile_primary "$profile")"
  info "Recommended models for $profile (primary: $primary)"

  # For each alias in profile, check all runtimes and show what to download
  local to_download_lms=() to_download_ollama=() to_download_mlx=()

  for alias in $aliases; do
    # LM Studio models
    local lms_id; lms_id="$(alias_ids "$alias" lms)"
    if [ "$lms_id" != "-" ] && [ -n "$lms_id" ]; then
      # Check if already loaded in LM Studio
      if lms_up 2>/dev/null; then
        local loaded; loaded="$(lms_loaded_models)"
        if ! printf '%s\n' "$loaded" | grep -qxF "$lms_id"; then
          to_download_lms+=("$lms_id")
        else
          ok "  $alias ($lms_id) — already loaded in LM Studio"
        fi
      else
        to_download_lms+=("$lms_id")
      fi
    fi

    # Ollama models
    local ollama_id; ollama_id="$(alias_ids "$alias" ollama)"
    if [ "$ollama_id" != "-" ] && [ -n "$ollama_id" ] && command -v ollama >/dev/null 2>&1; then
      local installed; installed="$(ollama list 2>/dev/null | tail -n +2 | awk '{print $1}')"
      if ! printf '%s\n' "$installed" | grep -qxF "$ollama_id"; then
        to_download_ollama+=("$ollama_id")
      else
        ok "  $alias ($ollama_id) — already installed in Ollama"
      fi
    fi

    # MLX models (local paths or HF models)
    local mlx_id; mlx_id="$(alias_ids "$alias" mlx)"
    if [ "$mlx_id" != "-" ] && [ -n "$mlx_id" ]; then
      if [ -d "$mlx_id" ]; then
        ok "  $alias — already present at $mlx_id"
      elif [ -f "$HERE/models-mlx.txt" ] && grep -qF "$mlx_id" "$HERE/models-mlx.txt"; then
        info "  $alias ($mlx_id) — referenced in models-mlx.txt (downloads on first use)"
      else
        to_download_mlx+=("$mlx_id")
      fi
    fi
  done

  # Print next-steps: copy-paste commands
  echo
  local have_cmds=0

  if [ ${#to_download_lms[@]} -gt 0 ]; then
    have_cmds=1
    echo "# LM Studio models (download in LM Studio GUI or via lms):"
    for lms_id in "${to_download_lms[@]}"; do
      echo "lms get $lms_id"
    done
    echo
  fi

  if [ ${#to_download_ollama[@]} -gt 0 ]; then
    have_cmds=1
    echo "# Ollama models (requires Ollama installed):"
    for ollama_id in "${to_download_ollama[@]}"; do
      echo "ollama pull $ollama_id"
    done
    echo
  fi

  if [ ${#to_download_mlx[@]} -gt 0 ]; then
    have_cmds=1
    echo "# MLX models (download via HuggingFace CLI or on first use):"
    for mlx_id in "${to_download_mlx[@]}"; do
      if [[ "$mlx_id" == /* ]]; then
        echo "# MLX local: $mlx_id"
      else
        echo "huggingface-cli download $mlx_id"
      fi
    done
    echo
  fi

  if [ "$have_cmds" = 1 ]; then
    if [ "$STATUS_ONLY" = 1 ]; then
      NEEDS_FORCE=1
    fi
    info "Next step: copy and run the commands above, then re-run:"
    printf '  %s\n' "bin/setup --model $profile"
  else
    ok "All models for $profile are ready!"
  fi
}

show_models() {
  step "Model status"

  local show_lms=1 show_ollama=1 show_mlx=1 show_omlx=1
  case "$RUNTIME" in
    lms)    show_ollama=0; show_mlx=0; show_omlx=0;;
    ollama) show_lms=0;    show_mlx=0; show_omlx=0;;
    mlx)    show_lms=0;    show_ollama=0; show_omlx=0;;
    omlx)   show_lms=0;    show_ollama=0; show_mlx=0;;
  esac

  if [ "$show_lms" = 1 ]; then
    info "LM Studio (models.txt → $LMS_BASE_URL)"
    if lms_up; then
      local loaded; loaded="$(lms_loaded_models)"
      while IFS= read -r m; do
        if printf '%s\n' "$loaded" | grep -qxF "$m"; then
          ok "  $m  ${C_DIM}[loaded]${C_RST}"
        else
          printf '    %s\n' "$m"
        fi
      done < <(read_list "$MODELS_FILE")
    else
      warn "LM Studio not running — run: lms server start"
      read_list "$MODELS_FILE" | sed 's/^/    /'
    fi
  fi

  if [ "$show_ollama" = 1 ] && command -v ollama >/dev/null 2>&1; then
    echo
    info "Ollama models"
    local ollama_file="$HERE/models-ollama.txt"
    if [ -f "$ollama_file" ]; then
      local installed; installed="$(ollama list 2>/dev/null | tail -n +2 | awk '{print $1}')"
      while IFS= read -r m; do
        if printf '%s\n' "$installed" | grep -qxF "$m"; then
          ok "  $m  ${C_DIM}[installed]${C_RST}"
        else
          warn "  $m  ${C_DIM}not installed — run: ollama pull $m${C_RST}"
        fi
      done < <(read_list "$ollama_file")
    else
      warn "models-ollama.txt not found"
      info "installed Ollama models:"
      ollama list 2>/dev/null | sed 's/^/  /'
    fi
  fi

  if [ "$show_mlx" = 1 ] && command -v mlx_lm.server >/dev/null 2>&1; then
    echo
    info "MLX models (~/.lmstudio/models or HuggingFace cache)"
    local mlx_file="$HERE/models-mlx.txt"
    if [ -f "$mlx_file" ]; then
      read_list "$mlx_file" | sed 's/^/  /'
    else
      warn "models-mlx.txt not found"
    fi
  fi

  if [ "$show_omlx" = 1 ] && omlx_up; then
    echo
    info "oMLX models (models-omlx.txt → $OMLX_BASE_URL)"
    # oMLX serves everything under its model dir, so anything in models-omlx.txt
    # that it doesn't list is a real miss — a stale entry or a pending rescan.
    local served; served="$(omlx_models)"
    local omlx_file="$HERE/models-omlx.txt"
    if [ -f "$omlx_file" ]; then
      while IFS= read -r m; do
        if printf '%s\n' "$served" | grep -qxF "$m"; then
          ok "  $m  ${C_DIM}[served]${C_RST}"
        else
          warn "  $m  ${C_DIM}not served — add it under $OMLX_MODELS_DIR, then: bin/omlx reload${C_RST}"
        fi
      done < <(read_list "$omlx_file")
    else
      warn "models-omlx.txt not found"
      printf '%s\n' "$served" | sed 's/^/    /'
    fi
  fi

  # Interactive: fzf to pick a model and show pull command
  if [ "$INTERACTIVE" = 1 ]; then
    command -v fzf >/dev/null 2>&1 || die "fzf not installed (brew install fzf)"
    echo
    info "Interactive model picker"
    local candidates=""
    # Gather LM Studio models not yet in models.txt
    if lms_up 2>/dev/null; then
      candidates="$(lms ls 2>/dev/null | awk '$1 ~ /\// {print "lms:" $1}')"
    fi
    # Gather Ollama models
    candidates="$candidates
$(ollama list 2>/dev/null | tail -n +2 | awk '{print "ollama:" $1}')"
    # Gather any from models-mlx.txt
    [ -f "$HERE/models-mlx.txt" ] && \
      candidates="$candidates
$(read_list "$HERE/models-mlx.txt" | sed 's/^/mlx:/')"

    candidates="$(printf '%s\n' "$candidates" | grep -v '^$' | sort -u)"
    [ -z "$candidates" ] && die "no models found to pick from"

    local sel
    sel="$(printf '%s\n' "$candidates" | \
           fzf --multi \
               --prompt='Models > ' \
               --header='TAB = multi-select  ENTER = confirm  (runtime:model-id)')"
    [ -z "$sel" ] && { info "nothing selected"; return 0; }

    echo
    info "Selected — commands to add/pull:"
    while IFS= read -r entry; do
      local rt="${entry%%:*}" mid="${entry#*:}"
      case "$rt" in
        lms)    printf '  echo "%s" >> models.txt\n' "$mid";;
        ollama) printf '  ollama pull %s\n' "$mid"
                printf '  echo "%s" >> models-ollama.txt\n' "$mid";;
        mlx)    printf '  # already in models-mlx.txt\n';;
      esac
    done <<< "$sel"
  fi
}

# ── Handle model profile setup ────────────────────────────────────────────────
if [ -n "$MODEL_PROFILE" ]; then
  [ "$DRY_RUN" = 1 ] && info "dry-run mode — showing commands only"
  setup_model_profile "$MODEL_PROFILE"
  exit 0
fi

# ── Handle agent setup ─────────────────────────────────────────────────────────
if [ "$DO_AGENT" = 1 ]; then
  [ "$DRY_RUN" = 1 ] && info "dry-run mode — showing commands only"

  # Split comma-separated agents using sed instead of local array
  (
    IFS=',' read -ra agents_to_show <<< "$AGENT_FILTER"
    for agent in "${agents_to_show[@]}"; do
      agent="$(printf '%s' "$agent" | xargs)"  # trim whitespace
      show_agent_status "$agent" || {
        warn "Failed to show status for agent: $agent"
      }
      echo
    done
  )

  # Wire (and verify) native configs for the named agents that agents-config
  # manages. This is what makes `bin/setup --agent aider` actually configure the
  # agent, not just print guidance. Idempotent; respects --dry-run.
  if [ -x "$HERE/bin/agents-config" ]; then
    _wire=()
    IFS=',' read -ra _named <<< "$AGENT_FILTER"
    for _a in "${_named[@]}"; do
      _a="$(printf '%s' "$_a" | xargs)"
      case "$_a" in
        aider|opencode|pi|hermes) command -v "$_a" >/dev/null 2>&1 && _wire+=("$_a");;
      esac
    done
    if [ "${#_wire[@]}" -gt 0 ]; then
      _wire_csv="$(IFS=,; echo "${_wire[*]}")"
      echo
      if [ "$DRY_RUN" = 1 ]; then
        info "would wire configs: bin/agents-config --settings-only --agent $_wire_csv --write"
      else
        info "Wiring agent configs to config.sh (endpoint/api key)"
        "$HERE/bin/agents-config" --settings-only --agent "$_wire_csv" --write | sed 's/^/    /'
        echo
        info "Verifying agent configs:"
        "$HERE/bin/agents-config" --verify --agent "$_wire_csv" | sed 's/^/    /' || true
      fi
    fi
  fi

  exit 0
fi

# ── Status-only (no flags given, or --force alone) ───────────────────────────
STATUS_ONLY=0
if [ "$DO_ALL$DO_LMS$DO_HERMES$DO_CODEX$DO_OPENCODE$DO_AIDER$DO_CAVEMAN$DO_MLX$DO_OLLAMA$DO_FZF$DO_HF$DO_MODEL" = "000000000000" ]; then
  STATUS_ONLY=1
fi

# ── Run ───────────────────────────────────────────────────────────────────────
[ "$DRY_RUN" = 1 ] && info "dry-run mode — no changes will be made"

if [ "$STATUS_ONLY" = 1 ]; then
  info "Tool status (read-only check; pass --force to install)"
  setup_lms
  show_lms_runtimes
  echo
  setup_hermes
  setup_codex
  setup_opencode
  setup_aider
  setup_caveman
  setup_mlx
  setup_omlx
  setup_ollama
  setup_fzf
  setup_hf
  setup_litellm
  echo
  show_models
  echo

  # Detect hardware and suggest a profile
  info "Quick start — hardware-aware model setup"
  ram_gb="$(detect_system_ram_gb)"
  if [ -n "$ram_gb" ] && [ "$ram_gb" -gt 0 ]; then
    suggested_profile="$(suggest_profile_for_ram "$ram_gb")"
    if [ -n "$suggested_profile" ]; then
      printf '  System RAM: %sGB  →  Profile: %s\n' "$ram_gb" "$suggested_profile"
      desc="$(profile_description "$suggested_profile")"
      printf '  %s\n' "$desc"
      echo
      printf '  Next step: bin/setup --model %s\n' "$suggested_profile"
      echo "    (shows which models to download, then run again to verify)"
    fi
  fi

  # If anything needs changes, offer interactive re-run with --force
  echo
  if [ "$NEEDS_FORCE" = 1 ] && [ "$FORCE" = 0 ]; then
    warn "Changes needed (tools/models missing)"
    echo
    printf '%s' "Install now? (y/n, auto-exit in 5s): "

    # Read with 5-second timeout
    if read -t 5 -r -n 1 response 2>/dev/null; then
      echo  # newline after single char input
      case "$response" in
        [yY])
          echo "Installing..."
          # Re-exec with --force added
          exec "$0" "$@" --force
          ;;
        *)
          echo "Skipped. To install later, run: bin/setup --force"
          exit 0
          ;;
      esac
    else
      # Timeout: exit without installing
      echo  # newline after timeout
      echo "Skipped. To install later, run: bin/setup --force"
      exit 0
    fi
  elif [ "$FORCE" = 1 ]; then
    ok "Running with --force (changes will be applied)"
    # Enable all tools for installation
    DO_ALL=1
  else
    # No changes needed, exit cleanly
    exit 0
  fi
fi

if [ "$DO_ALL" = 1 ]; then
  DO_LMS=1; DO_HERMES=1; DO_CODEX=1; DO_OPENCODE=1; DO_AIDER=1
  DO_CAVEMAN=1; DO_MLX=1; DO_OMLX=1; DO_OLLAMA=1; DO_FZF=1; DO_HF=1; DO_LITELLM=1
fi

[ "$DO_LMS" = 1 ]     && setup_lms
[ "$DO_HERMES" = 1 ]  && setup_hermes
[ "$DO_CODEX" = 1 ]   && setup_codex
[ "$DO_OPENCODE" = 1 ] && setup_opencode
[ "$DO_AIDER" = 1 ]   && setup_aider
[ "$DO_CAVEMAN" = 1 ] && setup_caveman
[ "$DO_MLX" = 1 ]     && setup_mlx
[ "$DO_OMLX" = 1 ]    && setup_omlx
[ "$DO_OLLAMA" = 1 ]  && setup_ollama
[ "$DO_FZF" = 1 ]     && setup_fzf
[ "$DO_HF" = 1 ]      && setup_hf
[ "$DO_LITELLM" = 1 ] && setup_litellm
[ "$DO_MODEL" = 1 ]   && show_models

# ── Wire agent native configs to config.sh (endpoint / api key / aider model) ─
# Runs only for agents we just set up that are actually on PATH. Idempotent, so
# re-running setup is a clean no-op when configs already match.
if [ "$DRY_RUN" != 1 ]; then
  _wire=()
  [ "$DO_AIDER" = 1 ]    && command -v aider    >/dev/null 2>&1 && _wire+=(aider)
  [ "$DO_OPENCODE" = 1 ] && command -v opencode >/dev/null 2>&1 && _wire+=(opencode)
  [ "$DO_CAVEMAN" = 1 ]  && command -v pi       >/dev/null 2>&1 && _wire+=(pi)
  [ "$DO_HERMES" = 1 ]   && command -v hermes   >/dev/null 2>&1 && _wire+=(hermes)
  if [ "${#_wire[@]}" -gt 0 ] && [ -x "$HERE/bin/agents-config" ]; then
    echo
    info "Wiring agent configs to config.sh (endpoint/api key)"
    _wire_csv="$(IFS=,; echo "${_wire[*]}")"
    "$HERE/bin/agents-config" --settings-only --agent "$_wire_csv" --write | sed 's/^/    /'
  fi
fi

echo
[ "$DRY_RUN" = 1 ] && info "dry-run complete — nothing was changed" || info "setup complete"

if [ "$DRY_RUN" != 1 ]; then
  echo ""
  echo "Next:"
  echo "  Verify setup:             bin/doctor"
  echo "  Find unregistered models: bin/scout"
  echo "  Test adapters (L0):       bin/smoke"
fi
