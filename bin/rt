#!/usr/bin/env bash
# bin/rt — unified runtime control (consolidates omlx, litellm-proxy, lmstudio-context)
#
# Control and monitor local LLM inference runtimes: LM Studio, Ollama, MLX, oMLX, LiteLLM.
#
# Core Commands:
#   bin/rt [status] [-v]     show snapshot: RAM, runtimes, running bench
#   bin/rt ram               RAM breakdown (total / used / free / wired / inactive)
#   bin/rt log [N]           tail most recent bench log (default 40 lines)
#   bin/rt watch [N]         live-tail bench log (follow mode)
#   bin/rt watch --metrics   unified real-time metrics view with colors
#   bin/rt stop TARGET       stop: bench, mlx, omlx, ollama, lms, litellm, all
#   bin/rt who [RUNTIME]     show which processes are connected to a runtime
#
# oMLX Commands (formerly: bin/omlx):
#   bin/rt omlx status       check if oMLX is up, what's loaded
#   bin/rt omlx start        start the oMLX server
#   bin/rt omlx stop         stop it
#   bin/rt omlx models       list all served models
#   bin/rt omlx reload       rescan model directory for new models
#   bin/rt omlx unload ID    evict one model from memory
#   bin/rt omlx aider-metadata  regenerate adapter metadata for aider
#
# LiteLLM Commands (formerly: bin/litellm-proxy):
#   bin/rt litellm proxy     start LiteLLM proxy (optional, on $LITELLM_PORT)
#   bin/rt litellm check     verify proxy is reachable
#   bin/rt litellm models    list models the proxy resolves
#
# LM Studio Context (formerly: bin/lmstudio-context):
#   bin/rt lms-context verify  check defaultContextLength is set to "max"
#   bin/rt lms-context fix     set it to "max"
#
set -uo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
source "$HERE/config.sh"; source "$HERE/lib/common.sh"

# ── helpers ──────────────────────────────────────────────────────────────────

_ram_gb() {
  # Returns: total_gb used_gb free_gb wired_gb inactive_gb
  # used  = wired + active + compressed (non-reclaimable pressure)
  # free  = free + speculative (immediately available)
  # wired = model weights / kernel (non-swappable — the key signal on Apple Silicon)
  # inactive = reclaimable disk cache (macOS reclaims this before swapping)
  local total page_size wired active speculative inactive free compressed
  total=$(sysctl -n hw.memsize)
  eval "$(vm_stat | awk '
    /page size of/              { ps = $8 }
    /Pages free:/               { gsub(/\./,"",$3); free=$3 }
    /Pages active:/             { gsub(/\./,"",$3); active=$3 }
    /Pages inactive:/           { gsub(/\./,"",$3); inactive=$3 }
    /Pages speculative/         { gsub(/\./,"",$3); spec=$3 }
    /Pages wired down/          { gsub(/\./,"",$4); wired=$4 }
    /Pages occupied by compressor/ { gsub(/\./,"",$5); comp=$5 }
    END { printf "page_size=%s wired=%s active=%s inactive=%s free=%s speculative=%s compressed=%s",
          ps, wired, active, inactive, free, spec, comp }')"
  local used=$(( (wired + active + compressed) * page_size ))
  local avail=$(( (free + speculative) * page_size ))
  local wired_b=$(( wired * page_size ))
  local inactive_b=$(( inactive * page_size ))
  awk -v tot="$total" -v used="$used" -v avail="$avail" \
      -v wired="$wired_b" -v inactive="$inactive_b" \
    'BEGIN { printf "%.0f %.0f %.0f %.0f %.0f",
             tot/1073741824, used/1073741824, avail/1073741824,
             wired/1073741824, inactive/1073741824 }'
}

_ollama_loaded() {
  # List models currently loaded in Ollama (via ps)
  ollama ps 2>/dev/null | awk 'NR>1 && NF { print $1 }' || true
}

_mlx_up() {
  curl -fsS --max-time 2 http://localhost:8080/v1/models >/dev/null 2>&1
}

_ollama_up() {
  curl -fsS --max-time 2 http://localhost:11434/api/tags >/dev/null 2>&1
}

_bench_pids() {
  # PIDs of bench processes (the bench shell script and its run_timeout child)
  pgrep -f "bash.*/bin/bench" 2>/dev/null || true
}

_codex_pids() {
  pgrep -f "codex exec.*--dangerously-bypass" 2>/dev/null || true
}

_latest_log() {
  # Path to most recent results.csv (exists as soon as bench starts)
  ls -1dt "$HERE"/results/*/results.csv 2>/dev/null | head -1
}

_latest_bench_log() {
  # Most recent .bench.log written (i.e. the case currently running / last run)
  local run
  run=$(ls -1dt "$HERE"/results/*/ 2>/dev/null | grep -v "_bad_runs" | head -1)
  [ -z "$run" ] && return
  find "$run/sandbox" -name ".bench.log" -print0 2>/dev/null \
    | xargs -0 ls -1t 2>/dev/null | head -1
}

_model_count_color() {
  local n=$1
  if   [ "$n" -le 4 ]; then printf '%s' "$C_GRN"
  elif [ "$n" -le 7 ]; then printf '%s' "$C_YEL"
  else                       printf '%s' "$C_RED"
  fi
}

# ── subcommands ───────────────────────────────────────────────────────────────

cmd_ram() {
  local total used avail wired inactive
  read total used avail wired inactive < <(_ram_gb)
  local active=$(( used - wired ))  # approximate: used - wired ≈ active+compressed
  printf '%s\n' "${C_BLU}==> RAM (${total}GB total)${C_RST}"
  printf '  %-14s %4s GB  %s\n' "wired"    "$wired"    "${C_DIM}model weights + kernel (non-reclaimable)${C_RST}"
  printf '  %-14s %4s GB  %s\n' "active"   "$active"   "${C_DIM}process working sets${C_RST}"
  printf '  %-14s %4s GB  %s\n' "inactive" "$inactive" "${C_DIM}reclaimable disk cache${C_RST}"
  printf '  %-14s %4s GB  %s\n' "free"     "$avail"    "${C_DIM}immediately available${C_RST}"
  printf '  %s\n' "──────────────────────"
  printf '  %-14s %4s GB  %s\n' "used"     "$used"     "${C_DIM}(wired + active)${C_RST}"
  printf '  %-14s %4s GB  %s\n' "available" "$(( avail + inactive ))" \
    "${C_DIM}(free + inactive)${C_RST}"
  # Top RAM consumers
  printf '\n%s\n' "${C_BLU}==> Top processes by RSS${C_RST}"
  ps aux | sort -k4 -rn | awk 'NR<=8 {
    pct=$4; rss=$6/1048576
    cmd=$11; sub(/.*\//,"",cmd)
    printf "  %5.1f%%  %5.1fGB  %s\n", pct, rss, cmd
  }'
}

cmd_status() {
  local verbose=0
  [[ "${1:-}" == "-v" || "${1:-}" == "--verbose" ]] && verbose=1

  local total used avail wired inactive
  read total used avail wired inactive < <(_ram_gb)

  printf '%s  %sGB total — %sGB used (%sGB wired) — %sGB free  %s\n' \
    "${C_BLU}RAM${C_RST}" "$total" "$used" "$wired" "$avail" \
    "${C_DIM}${inactive}GB reclaimable${C_RST}"
  echo

  # ── bench detection (used in next steps) ──────────────────────────────────────
  local bpids; bpids=$(_bench_pids)

  # ── runtimes ─────────────────────────────────────────────────────────────────
  local lms_up_flag=0 lms_models=""
  local ollama_up_flag=0 ollama_loaded=""
  local mlx_up_flag=0 mlx_model=""
  local omlx_up_flag=0

  printf '%s     ' "${C_BLU}LMS${C_RST}"
  if lms_up 2>/dev/null; then
    lms_up_flag=1
    lms_models=$(lms_loaded_models 2>/dev/null || true)
    if [ -n "$lms_models" ]; then
      local csv; csv=$(echo "$lms_models" | tr '\n' ',' | sed 's/,$//' | sed 's/,/, /g')
      printf '%s  %sloaded:%s %s\n' "${C_GRN}up${C_RST}" "${C_DIM}" "${C_RST}" "$csv"
    else
      printf '%s  %s(no model loaded)%s\n' "${C_GRN}up${C_RST}" "${C_DIM}" "${C_RST}"
    fi
  else
    printf '%s\n' "${C_DIM}down${C_RST}"
  fi

  printf '%s  ' "${C_BLU}Ollama${C_RST}"
  if _ollama_up; then
    ollama_up_flag=1
    ollama_loaded=$(_ollama_loaded)
    if [ -n "$ollama_loaded" ]; then
      local csv; csv=$(echo "$ollama_loaded" | tr '\n' ',' | sed 's/,$//' | sed 's/,/, /g')
      printf '%s  %sloaded:%s %s\n' "${C_GRN}up${C_RST}" "${C_DIM}" "${C_RST}" "$csv"
    else
      printf '%s  %s(no model loaded)%s\n' "${C_GRN}up${C_RST}" "${C_DIM}" "${C_RST}"
    fi
  else
    printf '%s\n' "${C_DIM}down${C_RST}"
  fi

  printf '%s     ' "${C_BLU}MLX${C_RST}"
  if _mlx_up; then
    mlx_up_flag=1
    mlx_model=$(curl -fsS --max-time 2 http://localhost:8080/v1/models 2>/dev/null \
      | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['data'][0]['id'])" 2>/dev/null)
    if [ -z "$mlx_model" ] || [ "$mlx_model" = "?" ]; then
      mlx_model=$(ps aux | grep 'mlx_lm.server' | grep -v grep \
        | grep -o -- '--model [^ ]*' | awk '{print $2}' | xargs basename 2>/dev/null || echo "?")
    fi
    printf '%s  %sloaded:%s %s\n' "${C_GRN}up (port 8080)${C_RST}" "${C_DIM}" "${C_RST}" "$mlx_model"
  else
    printf '%s\n' "${C_DIM}down${C_RST}"
  fi

  printf '%s    ' "${C_BLU}oMLX${C_RST}"
  if omlx_up; then
    omlx_up_flag=1
    # oMLX is multi-model: "served" is what it can answer for, "loaded" is what
    # is resident right now (it loads on first request, evicts LRU).
    local _served _loaded
    _served=$(omlx_models | wc -l | tr -d ' ')
    _loaded=$(omlx_loaded_models | tr '\n' ',' | sed 's/,$//' | sed 's/,/, /g')
    if [ -n "$_loaded" ]; then
      printf '%s  %sloaded:%s %s  %s(%s served)%s\n' "${C_GRN}up${C_RST}" \
        "${C_DIM}" "${C_RST}" "$_loaded" "${C_DIM}" "$_served" "${C_RST}"
    else
      printf '%s  %s(no model resident, %s served)%s\n' "${C_GRN}up${C_RST}" "${C_DIM}" "$_served" "${C_RST}"
    fi
  else
    printf '%s\n' "${C_DIM}down${C_RST}"
  fi

  # Optional layer — only surface it when running, so the default (adapters
  # talking to runtimes directly) stays uncluttered.
  if curl -fsS --max-time 2 "${LITELLM_BASE_URL%/v1}/health/readiness" >/dev/null 2>&1; then
    printf '%s ' "${C_BLU}LiteLLM${C_RST}"
    printf '%s  %sport %s, routes:%s lms/ ollama/ mlx/ omlx/\n' \
      "${C_GRN}up${C_RST}" "${C_DIM}" "$LITELLM_PORT" "${C_RST}"
  fi

  # ── next steps ───────────────────────────────────────────────────────────────
  # Show whenever any runtime is up — these are the key operations users forget.
  if [ "$lms_up_flag" = 1 ] || [ "$ollama_up_flag" = 1 ] || [ "$mlx_up_flag" = 1 ] || [ "$omlx_up_flag" = 1 ]; then
    # Fetch LMS sizes once for use in unload hints
    local lms_json_sizes="[]"
    [ "$lms_up_flag" = 1 ] && lms_json_sizes=$(lms ls --json 2>/dev/null || echo "[]")

    echo
    printf '%s\n' "${C_BLU}Next steps${C_RST}"

    # If bench is running, add watch command at the top
    if [ -n "$bpids" ]; then
      printf '  %s\n' "${C_DIM}watch live test progress:${C_RST}"
      printf '    bin/rt watch\n'
      echo
    fi

    # Reclaim reclaimable RAM (inactive disk cache)
    printf '  %s\n' "${C_DIM}reclaim reclaimable RAM (inactive disk cache):${C_RST}"
    printf '    sudo purge\n'

    # Unload model from RAM (server stays up)
    printf '  %s\n' "${C_DIM}unload model from RAM (server stays up):${C_RST}"
    if [ "$lms_up_flag" = 1 ]; then
      if [ -n "$lms_models" ]; then
        while IFS= read -r m; do
          local sz; sz=$(echo "$lms_json_sizes" \
            | jq -r --arg k "$m" '.[] | select(.modelKey==$k) | .sizeBytes' 2>/dev/null \
            | awk '{printf "%.0f", $1/1073741824}')
          local sz_note=""; [ -n "$sz" ] && sz_note=" (~${sz}GB freed)"
          printf '    bin/rt stop lms       %s\n' "${C_DIM}${m}${sz_note}${C_RST}"
        done <<< "$lms_models"
      else
        printf '    bin/rt stop lms       %s\n' "${C_DIM}(nothing loaded)${C_RST}"
      fi
    fi
    if [ "$ollama_up_flag" = 1 ]; then
      if [ -n "$ollama_loaded" ]; then
        while IFS= read -r om; do
          printf '    bin/rt stop ollama    %s\n' "${C_DIM}${om}${C_RST}"
        done <<< "$ollama_loaded"
      else
        printf '    bin/rt stop ollama    %s\n' "${C_DIM}(nothing loaded)${C_RST}"
      fi
    fi
    [ "$mlx_up_flag" = 1 ] && \
      printf '    bin/rt stop mlx       %s\n' "${C_DIM}${mlx_model:-MLX model}${C_RST}"
    if [ "$omlx_up_flag" = 1 ]; then
      local _ol; _ol="$(omlx_loaded_models)"
      if [ -n "$_ol" ]; then
        while IFS= read -r _m; do
          # Per-model eviction; `bin/rt stop omlx` unloads all and stops the server.
          printf '    bin/omlx unload       %s\n' "${C_DIM}${_m}${C_RST}"
        done <<< "$_ol"
      else
        printf '    bin/omlx unload       %s\n' "${C_DIM}(nothing resident)${C_RST}"
      fi
    fi

    # Stop server entirely
    printf '  %s\n' "${C_DIM}stop server entirely:${C_RST}"
    [ "$lms_up_flag"    = 1 ] && printf '    lms server stop\n'
    [ "$ollama_up_flag" = 1 ] && printf '    bin/rt stop ollama\n'
    [ "$mlx_up_flag"    = 1 ] && printf '    bin/rt stop mlx\n'
    [ "$omlx_up_flag"   = 1 ] && printf '    bin/rt stop omlx\n'

    # Delete from disk — verbose only
    if [ "$verbose" = 1 ]; then
      local any_models=0
      [ -n "$lms_models" ] && any_models=1
      [ -n "$ollama_loaded" ] && any_models=1
      if [ "$any_models" = 1 ]; then
        printf '  %s\n' "${C_DIM}delete model from disk:${C_RST}"
        [ -n "$lms_models"    ] && printf '    rm -rf ~/.lmstudio/models/<publisher>/<model>/\n'
        [ -n "$ollama_loaded" ] && printf '    ollama rm <model-name>\n'
      fi
    fi
  fi

  echo

  # ── bench ────────────────────────────────────────────────────────────────────
  # lms_activity: pulls status/queued/lastUsedTime from lms ps for the bench model.
  # Returns "<status> <queued> <last_used_ms>" or empty if no model loaded.
  _lms_activity() {
    lms ps --json 2>/dev/null \
      | python3 -c "
import json,sys,time
rows=json.load(sys.stdin)
if not rows: sys.exit(0)
m=rows[0]
status=m.get('status','?')
queued=m.get('queued',0)
last_ms=m.get('lastUsedTime',0)
age=int(time.time()*1000)-last_ms if last_ms else -1
print(status,queued,age)
" 2>/dev/null
  }

  printf '%s  ' "${C_BLU}Bench${C_RST}"
  if [ -n "$bpids" ]; then
    local latest_csv; latest_csv=$(_latest_log)
    local results_count=0
    [ -n "$latest_csv" ] && results_count=$(tail -n +2 "$latest_csv" 2>/dev/null | grep -c "." || echo 0)

    local num_bench_pids; num_bench_pids=$(echo "$bpids" | wc -w)
    printf '%s  %s\n' "${C_YEL}RUNNING${C_RST}" "${C_GRN}${num_bench_pids} test(s)${C_RST}"

    # Show each bench process
    local bench_count=0
    for pid in $bpids; do
      [ $bench_count -ge 3 ] && break
      local bench_cmd; bench_cmd=$(ps -p "$pid" -o args= 2>/dev/null)
      if [ -z "$bench_cmd" ]; then continue; fi

      # Extract model from command for cleaner display
      local model_label=""
      if [[ "$bench_cmd" =~ --model[s]?[=[:space:]]([^[:space:]]+) ]]; then
        model_label="${BASH_REMATCH[1]}"
      fi

      # Extract cases count
      local count_cases=1
      if [[ "$bench_cmd" =~ --cases[=[:space:]]([^[:space:]]+) ]]; then
        count_cases=$(( $(echo "${BASH_REMATCH[1]}" | grep -o ',' | wc -l) + 1 ))
      fi

      local note="${C_DIM}${count_cases} cases${C_RST}"
      [ -n "$model_label" ] && note="${C_DIM}${model_label} • ${count_cases} cases${C_RST}"
      printf '    %s\n' "$note"
      bench_count=$((bench_count + 1))
    done

    [ "$num_bench_pids" -gt 3 ] && printf '    %s\n' "${C_DIM}... and $((num_bench_pids - 3)) more${C_RST}"

    [ -n "$latest_csv" ] && printf '  results so far: %s\n' "$results_count"
    # Heartbeat: time since last CSV row was written
    if [ -n "$latest_csv" ]; then
      local csv_age_s; csv_age_s=$(( $(date +%s) - $(stat -f %m "$latest_csv" 2>/dev/null || echo 0) ))
      if [ "$csv_age_s" -gt 300 ]; then
        printf '  %slast result written %ss ago — may be stuck%s\n' "${C_YEL}" "$csv_age_s" "${C_RST}"
      else
        printf '  last result written %ss ago\n' "${C_DIM}$csv_age_s${C_RST}"
      fi
    fi
    local act; act=$(_lms_activity)
    if [ -n "$act" ]; then
      local mstatus mqueued mage_ms mage_s
      read mstatus mqueued mage_ms <<< "$act"
      mage_s=$(( mage_ms / 1000 ))
      if [ "$mstatus" = "generating" ]; then
        printf '  model: %sgenerating%s' "${C_GRN}" "${C_RST}"
        [ "$mqueued" -gt 0 ] && printf '  (%s queued)' "$mqueued"
        printf '\n'
      else
        printf '  model: %sidle%s  last active %ss ago\n' "${C_DIM}" "${C_RST}" "$mage_s"
        [ "$mage_s" -gt 60 ] && printf '  %s(no generation for >1min — may be stuck or between cases)%s\n' "${C_YEL}" "${C_RST}"
      fi
    fi
  else
    printf '%s\n' "${C_DIM}idle${C_RST}"
    local latest_csv; latest_csv=$(_latest_log)
    if [ -n "$latest_csv" ]; then
      local run; run=$(basename "$(dirname "$latest_csv")")
      local count; count=$(tail -n +2 "$latest_csv" 2>/dev/null | grep -c "." || echo 0)
      # Show per-adapter breakdown from the CSV
      local breakdown
      breakdown=$(tail -n +2 "$latest_csv" 2>/dev/null \
        | awk -F, '{cases[$1]++} END {for (a in cases) printf "    %-14s %s cases\n", a, cases[a]}' \
        | sort)
      # Get last modified time of any file in the test folders (most recent test activity)
      local run_dir; run_dir=$(dirname "$(dirname "$latest_csv")")
      local last_modified_ts; last_modified_ts=$(find "$run_dir/sandbox" -type f -print0 2>/dev/null \
        | xargs -0 stat -f %m 2>/dev/null | sort -rn | head -1)

      # If no files found, parse timestamp from directory name (format: YYYYMMDD-HHMMSS)
      if [ -z "$last_modified_ts" ]; then
        local dir_name; dir_name=$(basename "$run_dir")
        if [[ $dir_name =~ ^([0-9]{4})([0-9]{2})([0-9]{2})-([0-9]{2})([0-9]{2})([0-9]{2})$ ]]; then
          local ts_str="${BASH_REMATCH[1]}${BASH_REMATCH[2]}${BASH_REMATCH[3]}${BASH_REMATCH[4]}${BASH_REMATCH[5]}${BASH_REMATCH[6]}"
          last_modified_ts=$(date -j -f "%Y%m%d%H%M%S" "$ts_str" +%s 2>/dev/null)
        fi
      fi

      # Final fallback if timestamp extraction failed
      [ -z "$last_modified_ts" ] && last_modified_ts=$(stat -f %m "$run_dir" 2>/dev/null || echo 0)

      local now; now=$(date +%s)
      local elapsed=$((now - last_modified_ts))
      local rel_time
      if [ "$elapsed" -lt 60 ]; then
        rel_time=$(printf "%ds ago" "$elapsed")
      elif [ "$elapsed" -lt 3600 ]; then
        local mins=$((elapsed / 60))
        rel_time=$(printf "%dm ago" "$mins")
      elif [ "$elapsed" -lt 86400 ]; then
        local hours=$((elapsed / 3600))
        rel_time=$(printf "%dh ago" "$hours")
      elif [ "$elapsed" -lt 604800 ]; then
        local days=$((elapsed / 86400))
        rel_time=$(printf "%dd ago" "$days")
      else
        rel_time="long ago"
      fi
      printf '  last run: %s  (%s results)  —  %s\n' "${C_DIM}$run${C_RST}" "$count" "${C_DIM}$rel_time${C_RST}"
      [ -n "$breakdown" ] && printf '%s\n' "${C_DIM}$breakdown${C_RST}"
      # Show time since model last generated (even when bench is idle)
      local act; act=$(_lms_activity)
      if [ -n "$act" ]; then
        local mstatus mqueued mage_ms mage_s
        read mstatus mqueued mage_ms <<< "$act"
        mage_s=$(( mage_ms / 1000 ))
        printf '  model last active: %ss ago\n' "${C_DIM}$mage_s${C_RST}"
      fi
    fi
  fi

  # ── verbose: suggest bin/hwprofile --full for model details ──────────────────
  if [ "$verbose" = 1 ]; then
    echo
    printf '%s\n' "${C_BLU}For detailed model inventory and disk usage:${C_RST}"
    printf '  %s\n' "bin/hwprofile --full"
  fi
}

_port_clients() {
  # List ESTABLISHED connections to a port, excluding the listening server process.
  # Output: PID COMMAND CONNECTION  (one line per unique PID)
  local port=$1
  local server_pid; server_pid=$(lsof -i :"$port" 2>/dev/null | awk '/LISTEN/ {print $2}' | head -1)
  lsof -i :"$port" 2>/dev/null \
    | awk -v spid="${server_pid:-NONE}" \
        'NR>1 && /ESTABLISHED/ && $2 != spid { print $2, $1, $9 }' \
    | sort -u
}

_lms_ps_info() {
  # Returns "<model_id> <status> <queued>" or empty if nothing is loaded.
  lms ps --json 2>/dev/null \
    | python3 -c "
import json,sys
rows=json.load(sys.stdin)
if not rows: sys.exit(0)
m=rows[0]
print(m.get('identifier','?'), m.get('status','?'), m.get('queued',0))
" 2>/dev/null
}

cmd_who() {
  local target="${1:-all}"

  _who_lms() {
    printf '%s' "${C_BLU}==> LMS${C_RST}"
    if ! lms_up 2>/dev/null; then
      printf '  %s(not running)%s\n' "${C_DIM}" "${C_RST}"; return
    fi

    local ps_info; ps_info=$(_lms_ps_info)
    local model="" mstatus="" mqueued=""
    [ -n "$ps_info" ] && read model mstatus mqueued <<< "$ps_info"

    if [ -n "$model" ]; then
      local status_col="$C_DIM"
      [ "$mstatus" = "PROCESSINGPROMPT" ] && status_col="$C_YEL"
      [ "$mstatus" = "READY" ]            && status_col="$C_GRN"
      printf '  %s — %s%s%s' "$model" "$status_col" "$mstatus" "${C_RST}"
      [ "${mqueued:-0}" -gt 0 ] && printf '  %s(queued: %s)%s' "${C_DIM}" "$mqueued" "${C_RST}"
      printf '\n'
    else
      printf '  %s(no model loaded)%s\n' "${C_DIM}" "${C_RST}"
    fi

    local clients; clients=$(_port_clients 1234)
    if [ -n "$clients" ]; then
      printf '  %sclients on :1234%s\n' "${C_DIM}" "${C_RST}"
      while IFS= read -r line; do
        local pid cmd conn
        read pid cmd conn <<< "$line"
        printf '    %-12s %-6s  %s\n' "$cmd" "$pid" "$conn"
      done <<< "$clients"
      if [ "$mstatus" = "PROCESSINGPROMPT" ]; then
        printf '\n  %sTip:%s model is busy — kill the client to unblock:\n' "${C_YEL}" "${C_RST}"
        while IFS= read -r line; do
          local pid cmd
          read pid cmd _ <<< "$line"
          printf '    kill %s    %s# %s%s\n' "$pid" "${C_DIM}" "$cmd" "${C_RST}"
        done <<< "$clients"
      fi
    else
      printf '  %s(no external clients on :1234)%s\n' "${C_DIM}" "${C_RST}"
    fi
  }

  _who_ollama() {
    printf '%s' "${C_BLU}==> Ollama${C_RST}"
    if ! _ollama_up; then
      printf '  %s(not running)%s\n' "${C_DIM}" "${C_RST}"; return
    fi

    local loaded; loaded=$(_ollama_loaded)
    if [ -n "$loaded" ]; then
      local csv; csv=$(echo "$loaded" | tr '\n' ',' | sed 's/,$//' | sed 's/,/, /g')
      printf '  %sloaded:%s %s\n' "${C_DIM}" "${C_RST}" "$csv"
    else
      printf '  %s(no model loaded)%s\n' "${C_DIM}" "${C_RST}"
    fi

    local clients; clients=$(_port_clients 11434)
    if [ -n "$clients" ]; then
      printf '  %sclients on :11434%s\n' "${C_DIM}" "${C_RST}"
      while IFS= read -r line; do
        local pid cmd conn
        read pid cmd conn <<< "$line"
        printf '    %-12s %-6s  %s\n' "$cmd" "$pid" "$conn"
      done <<< "$clients"
    else
      printf '  %s(no external clients on :11434)%s\n' "${C_DIM}" "${C_RST}"
    fi
  }

  case "$target" in
    lms)    _who_lms ;;
    ollama) _who_ollama ;;
    all)    _who_lms; echo; _who_ollama ;;
    *)      die "unknown who target: $target (valid: lms ollama all)" ;;
  esac
}

_strip_ctrl() {
  # Remove control chars but preserve ESC (octal 033 = decimal 27) which is needed for ANSI color codes
  tr -d '\000-\010\013-\032\034-\037\200-\237' \
    | sed 's/[⠁⠂⠄⠈⠐⠠⡀⢀⠃⠅⠆⠉⠊⠌⠑⠒⠔⠘⠡⠢⠤⠨⠰⡁⡂⡄⡈⡐⡠⢁⢂⢄⢈⢐⢠⣀⠇⠋⠍⠎⠓⠕⠖⠙⠚⠜⠣⠦⠩⠪⠬⠱⠲⠴⠸⡃⡅⡆⡉⡊⡌⡑⡒⡔⡘⡡⡢⡤⡨⡰⢃⢅⢆⢉⢊⢌⢑⢒⢔⢘⢡⢢⢤⢨⢰⣁⣂⣄⣈⣐⣠]//g'
}

cmd_log() {
  local n="${1:-40}"
  local log; log=$(_latest_bench_log)
  [ -z "$log" ] && die "no bench logs found (run a bench first)"
  local rel="${log#$HERE/}"
  # Show adapter/model/case from path: sandbox/<adapter>/<model>/<case>/.bench.log
  local case_label; case_label=$(echo "$rel" | sed -E 's|.*/sandbox/||' | awk -F/ '{print $1" | "$2" | "$3}')
  info "$case_label"
  tail -"$n" "$log" | _strip_ctrl
}

_metrics_display() {
  # Unified metrics view: shows live results.csv with colors and formatting
  # CSV fields: adapter,model,case,pass,total,score,seconds,status,trials,runtime
  local csv="$1"
  local run_json="$2"

  # Extract run metadata
  local runtime model_list adapter_list case_list
  runtime=$(jq -r '.runtime' "$run_json" 2>/dev/null || echo "?")
  model_list=$(jq -r '.axes.models | join(", ")' "$run_json" 2>/dev/null || echo "?")
  adapter_list=$(jq -r '.axes.adapters | join(", ")' "$run_json" 2>/dev/null || echo "?")
  case_list=$(jq -r '.axes.cases | length' "$run_json" 2>/dev/null || echo "?")

  # Print header with metadata
  printf '\n%s\n' "${C_BLU}╭─ UNIFIED METRICS VIEW ${C_DIM}(live)${C_RST}${C_BLU} ─${C_RST}"
  printf '%s\n' "${C_BLU}├─ Runtime${C_RST} $runtime  ${C_DIM}| Models${C_RST} $model_list  ${C_DIM}| Adapters${C_RST} $adapter_list  ${C_DIM}| Cases${C_RST} $case_list"
  printf '%s\n' "${C_BLU}├─${C_RST}"
  printf '%s\n' "${C_BLU}├─ Adapter  Model              Case                          Pass  Score Status${C_RST}"
  printf '%s\n' "${C_BLU}├${C_RST}─────────────────────────────────────────────────────────────────────────"

  # Tail CSV and format rows with color coding (skip header, show only recent changes)
  (
    tail -f "$csv" 2>/dev/null | awk -F, '
    NR > 1 {
      adapter=$1; gsub(/^ +| +$/, "", adapter)
      model=$2;   gsub(/^ +| +$/, "", model)
      case=$3;    gsub(/^ +| +$/, "", case)
      pass=$4;    gsub(/^ +| +$/, "", pass)
      total=$5;   gsub(/^ +| +$/, "", total)
      score=$6;   gsub(/^ +| +$/, "", score)
      status=$8;  gsub(/^ +| +$/, "", status)

      row_key = adapter ":" model ":" case
      if (!(row_key in seen)) {
        seen[row_key] = 1

        # Format score as percentage
        score_pct = int(score * 100) "%"

        # Color codes
        if (status == "pass")       color = "\033[32m"  # green
        else if (status == "stall") color = "\033[33m"  # yellow
        else if (status == "fail")  color = "\033[31m"  # red
        else                        color = "\033[2m"   # dim

        printf "  %-8s %-18s %-28s %3s/%-3s %4s %s%s\033[0m\n", \
          adapter, model, case, pass, total, score_pct, color, status
        fflush()
      }
    }
    '
  ) &
  local tail_pid=$!

  # Show live aggregates every 2 seconds
  (
    while true; do
      sleep 2
      if [ -f "$csv" ]; then
        printf '\n%s\n' "${C_BLU}├─ AGGREGATES ${C_DIM}(updated every 2s)${C_RST}"

        # Parse CSV and compute aggregates
        awk -F, 'NR > 1 {
          if ($8 == "pass") pass++
          else if ($8 == "stall") stall++
          else if ($8 == "fail") fail++
          else other++
          total++
          score_sum += $6
        }
        END {
          if (total > 0) avg = score_sum / total
          else avg = 0
          printf "  \033[36m├─\033[0m ✓ Passed: \033[32m%3d\033[0m  \033[36m├─\033[0m ⏸ Stalled: \033[33m%3d\033[0m  \033[36m├─\033[0m ✗ Failed: \033[31m%3d\033[0m\n", pass+0, stall+0, fail+0
          if (other > 0) printf "  \033[36m├─\033[0m ⋯ Other: \033[2m%3d\033[0m\n", other
          printf "  \033[36m├─\033[0m Avg Score: \033[36m%.2f\033[0m\n", avg
          printf "  \033[36m╰─\033[0m Total: \033[2m%d/%d\033[0m\n", pass+0, total
        }' "$csv"
      fi
    done
  ) &
  local agg_pid=$!

  # Background jobs ignore SIGINT by default in non-interactive scripts, so
  # Ctrl-C would otherwise leave the tail/awk pipeline and the aggregates
  # loop running after this function returns. Explicitly tear them (and
  # their children, e.g. the `tail -f` under $tail_pid) down on interrupt.
  local _cleanup_done=0
  _metrics_cleanup() {
    [ "$_cleanup_done" = 1 ] && return
    _cleanup_done=1
    pkill -P "$tail_pid" 2>/dev/null || true
    pkill -P "$agg_pid" 2>/dev/null || true
    kill "$tail_pid" "$agg_pid" 2>/dev/null || true
  }
  trap '_metrics_cleanup; exit 130' INT TERM
  trap '_metrics_cleanup' RETURN EXIT

  # Wait for user interrupt
  wait $tail_pid 2>/dev/null
  _metrics_cleanup
}

cmd_watch() {
  local n="${1:-40}"
  local show_metrics=0

  # Check for --metrics flag
  [ "$n" = "--metrics" ] && { show_metrics=1; n=40; }

  # Reject unknown flags
  if [[ "$n" == --* ]] && [ "$n" != "--metrics" ]; then
    die "unknown flag: $n  (use --metrics for unified view, or N for line count)"
  fi

  # Find the latest run directory
  local run; run=$(ls -1dt "$HERE"/results/*/ 2>/dev/null | grep -v "_bad_runs" | head -1)
  [ -z "$run" ] && die "no bench logs found (run a bench first)"

  if [ "$show_metrics" = 1 ]; then
    # Watch metrics mode
    local csv; csv="$run/results.csv"
    local run_json; run_json="$run/run.json"

    [ ! -f "$csv" ] && die "no results.csv found in $run"
    [ ! -f "$run_json" ] && die "no run.json found in $run"

    info "unified metrics view  (Ctrl-C exits watch; tests continue)"
    _metrics_display "$csv" "$run_json"
  else
    # Original log tail mode
    # Find all .bench.log files in this run that were recently modified (active benches)
    # First try logs modified in last 5 minutes, then fall back to all logs
    local logs; logs=$(find "$run/sandbox" -name ".bench.log" -type f -mmin -5 -print0 2>/dev/null \
      | xargs -0 ls -1t 2>/dev/null)

    if [ -z "$logs" ]; then
      # Fallback: use the most recent log if nothing modified in last 5 minutes
      logs=$(_latest_bench_log)
    fi

    if [ -z "$logs" ]; then
      die "no bench logs found in $run"
    fi

    local log_count; log_count=$(echo "$logs" | wc -l)

    if [ "$log_count" -eq 1 ]; then
      # Single log: watch normally
      local log="$logs"
      local rel="${log#$HERE/}"
      local case_label; case_label=$(echo "$rel" | sed -E 's|.*/sandbox/||' | awk -F/ '{print $1" | "$2" | "$3}')
      info "watching: $case_label  (Ctrl-C exits watch; test continues)"
      tail -"$n" -f "$log" | _strip_ctrl
    else
      # Multiple logs: watch all with labels
      info "watching: $log_count concurrent tests  (Ctrl-C exits watch; tests continue)"
      # Use tail -f with label prefix for each log
      # We need a process for each log that prefixes output
      (
        echo "$logs" | while read -r log; do
          local label; label=$(echo "$log" | sed -E 's|.*/sandbox/||' | awk -F/ '{print $1" | "$2" | "$3}')
          tail -"$n" -f "$log" 2>/dev/null | sed "s/^/${C_DIM}[$label]${C_RST} /" &
        done
        wait
      ) | _strip_ctrl
    fi
  fi
}

cmd_stop() {
  local target="${1:-}"
  [ -z "$target" ] && { echo "Usage: bin/rt stop [bench|mlx|omlx|ollama|lms|litellm|all]"; exit 1; }

  case "$target" in
    bench)
      local pids; pids=$(_bench_pids)
      local cpids; cpids=$(_codex_pids)
      local all_pids="$pids $cpids"
      all_pids="$(echo $all_pids | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' ')"
      if [ -z "$(echo $all_pids | tr -d ' ')" ]; then
        info "bench: no bench process found"
      else
        info "stopping bench PIDs: $all_pids"
        kill $all_pids 2>/dev/null || true
        sleep 1
        # Force-kill any survivors
        local survivors; survivors=$(echo $all_pids | tr ' ' '\n' | while read pid; do
          kill -0 "$pid" 2>/dev/null && echo "$pid"; done | tr '\n' ' ')
        [ -n "$(echo $survivors | tr -d ' ')" ] && kill -9 $survivors 2>/dev/null || true
        ok "bench stopped"
      fi
      ;;
    mlx)
      local pid; pid=$(lsof -ti :8080 2>/dev/null | head -1)
      if [ -z "$pid" ]; then
        info "mlx: nothing on port 8080"
      else
        info "stopping MLX server (PID $pid)"
        kill "$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
        ok "MLX stopped"
      fi
      ;;
    omlx)
      # Unload resident models first so the shutdown doesn't have to reclaim
      # tens of GB under pressure, then stop via oMLX's own CLI (the app and the
      # CLI share one managed server, so killing the port would fight the app).
      if omlx_up; then
        local _m
        while IFS= read -r _m; do
          [ -z "$_m" ] && continue
          info "unloading oMLX model: $_m"
          omlx_unload_model "$_m" || warn "unload failed: $_m"
        done <<< "$(omlx_loaded_models)"
      fi
      if [ -x "${OMLX_CLI:-/Applications/oMLX.app/Contents/MacOS/omlx-cli}" ]; then
        if "$HERE/bin/omlx" stop >/dev/null 2>&1; then ok "oMLX stopped"; else info "oMLX: not running"; fi
      else
        info "oMLX: CLI not found — nothing to stop"
      fi
      ;;
    litellm)
      local pid; pid=$(lsof -ti ":$LITELLM_PORT" 2>/dev/null | head -1)
      if [ -z "$pid" ]; then
        info "litellm: nothing on port $LITELLM_PORT"
      else
        info "stopping LiteLLM proxy (PID $pid)"
        kill "$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
        ok "LiteLLM stopped"
      fi
      ;;
    ollama)
      # Unload any running models first (graceful)
      if _ollama_up; then
        local loaded; loaded=$(_ollama_loaded)
        if [ -n "$loaded" ]; then
          while IFS= read -r model; do
            info "unloading Ollama model: $model"
            if ollama stop "$model" > /dev/null 2>&1; then
              ok "unloaded: $model"
            else
              warn "ollama stop failed for: $model"
            fi
          done <<< "$loaded"
        fi
      fi
      # Kill the app — works whether launched via desktop app or brew
      local app_pid; app_pid=$(pgrep -f "Ollama.app/Contents/MacOS/Ollama" | head -1)
      local srv_pid; srv_pid=$(pgrep -f "ollama serve" | head -1)
      if [ -n "$app_pid" ]; then
        info "stopping Ollama app (PID $app_pid)"
        kill "$app_pid" 2>/dev/null && ok "Ollama stopped" || warn "kill failed — try: sudo kill $app_pid"
      elif [ -n "$srv_pid" ]; then
        info "stopping ollama serve (PID $srv_pid)"
        kill "$srv_pid" 2>/dev/null && ok "Ollama stopped" || warn "kill failed — try: sudo kill $srv_pid"
      else
        info "ollama: not running"
      fi
      ;;
    lms)
      if lms_up 2>/dev/null; then
        local loaded; loaded=$(lms_loaded_models 2>/dev/null)
        if [ -n "$loaded" ]; then
          while IFS= read -r model; do
            info "unloading LMS model: $model"
            lms unload "$model" 2>/dev/null || true
          done <<< "$loaded"
          ok "LMS models unloaded"
        else
          info "lms: no models loaded"
        fi
      else
        info "lms: server not running"
      fi
      ;;
    all)
      cmd_stop bench
      cmd_stop mlx
      cmd_stop omlx
      cmd_stop ollama
      cmd_stop lms
      cmd_stop litellm
      ;;
    *)
      die "unknown stop target: $target (valid: bench mlx omlx ollama lms litellm all)"
      ;;
  esac
}

# ── omlx subcommands (consolidates bin/omlx) ────────────────────────────────
cmd_omlx() {
  local subcmd="${1:-status}"
  shift 2>/dev/null || true
  case "$subcmd" in
    status)
      if ! omlx_up; then
        printf '%s %s\n' "${C_BLU}oMLX${C_RST}" "${C_DIM}down${C_RST} (start: bin/rt omlx start)"
        return 1
      fi
      local st served loaded
      st="$(curl -fsS --max-time 5 "${OMLX_BASE_URL%/v1}/api/status" 2>/dev/null)"
      served="$(omlx_models | wc -l | tr -d ' ')"
      loaded="$(omlx_loaded_models | paste -sd', ' - )"
      printf '%s %s  %sv%s, %s models served, %s\n' \
        "${C_BLU}oMLX${C_RST}" "${C_GRN}up${C_RST}" "${C_DIM}" \
        "$(printf '%s' "$st" | jq -r '.version // "?"')" "$served" \
        "$(printf '%s' "$st" | jq -r '.model_memory_used_formatted // "0"') resident${C_RST}"
      [ -z "$loaded" ] || printf '  %sloaded:%s %s\n' "${C_DIM}" "${C_RST}" "$loaded"
      ;;
    models)
      omlx_up || die "oMLX not reachable at $OMLX_BASE_URL"
      omlx_models
      ;;
    start|stop|restart|reload)
      die "For oMLX server control, use the oMLX.app GUI or omlx-cli directly"
      ;;
    unload)
      [ -n "${1:-}" ] || die "usage: bin/rt omlx unload <model-id>"
      omlx_unload_model "$1" && ok "Model unloaded: $1"
      ;;
    *)
      die "unknown omlx subcommand: $subcmd (valid: status, models, unload)"
      ;;
  esac
}

# ── litellm subcommands (consolidates bin/litellm-proxy) ──────────────────────
cmd_litellm() {
  local subcmd="${1:-status}"
  shift 2>/dev/null || true
  case "$subcmd" in
    proxy)
      if ! command -v uvx >/dev/null 2>&1; then
        die "uvx not found — install uv: brew install uv"
      fi
      info "Starting LiteLLM proxy on $LITELLM_BASE_URL"
      export LITELLM_LMS_BASE="${LITELLM_LMS_BASE:-$LMS_BASE_URL}"
      export LITELLM_OLLAMA_BASE="${LITELLM_OLLAMA_BASE:-$OLLAMA_BASE_URL}"
      export LITELLM_MLX_BASE="${LITELLM_MLX_BASE:-http://127.0.0.1:8080/v1}"
      export LITELLM_OMLX_BASE="${LITELLM_OMLX_BASE:-$OMLX_BASE_URL}"
      exec uvx --python 3.12 --with 'fastapi<0.116' --from 'litellm[proxy]' \
        litellm --config "$HERE/config-templates/litellm.yaml" --port "$LITELLM_PORT" --host 127.0.0.1
      ;;
    check)
      if curl -fsS -m 3 "${LITELLM_BASE_URL%/v1}/health/readiness" >/dev/null 2>&1; then
        ok "LiteLLM proxy: reachable at $LITELLM_BASE_URL"
        exit 0
      fi
      err "LiteLLM proxy: not reachable at $LITELLM_BASE_URL"
      echo "  Start it: bin/rt litellm proxy"
      exit 1
      ;;
    models)
      curl -fsS -m 15 "$LITELLM_BASE_URL/models" 2>/dev/null \
        | jq -r '.data[].id' 2>/dev/null | sort \
        || die "LiteLLM proxy not reachable at $LITELLM_BASE_URL (start: bin/rt litellm proxy)"
      ;;
    *)
      die "unknown litellm subcommand: $subcmd (valid: proxy, check, models)"
      ;;
  esac
}

# ── lms-context subcommands (consolidates bin/lmstudio-context) ───────────────
cmd_lms_context() {
  local subcmd="${1:-verify}"
  local settings_file="$HOME/.lmstudio/settings.json"

  [ -f "$settings_file" ] || die "LM Studio settings not found at $settings_file"

  case "$subcmd" in
    verify)
      local t; t="$(jq -r '.defaultContextLength.type // empty' "$settings_file")"
      if [ "$t" = "max" ]; then
        ok "LM Studio defaultContextLength.type = max (Model maximum)"
      else
        err "LM Studio defaultContextLength.type = ${t:-not set} (expected: max)"
        echo "  Models opened from the LM Studio UI will be capped at fixed context."
        echo "  Fix: bin/rt lms-context fix"
        exit 1
      fi
      ;;
    fix)
      local t; t="$(jq -r '.defaultContextLength.type // empty' "$settings_file")"
      info "Current defaultContextLength.type: ${t:-not set}"
      cp "$settings_file" "$settings_file.backup"
      ok "Backed up to $settings_file.backup"
      jq '.defaultContextLength = {"type": "max"}' "$settings_file" > "$settings_file.tmp" \
        && mv "$settings_file.tmp" "$settings_file"
      ok "Updated defaultContextLength.type: $(jq -r '.defaultContextLength.type' "$settings_file")"
      echo ""
      warn "Restart LM Studio (or: lms daemon down && lms daemon up) for this to take effect."
      ;;
    *)
      die "unknown lms-context subcommand: $subcmd (valid: verify, fix)"
      ;;
  esac
}

# ── dispatch ──────────────────────────────────────────────────────────────────

CMD="${1:-status}"
shift 2>/dev/null || true

# Allow `bin/rt -v` / `bin/rt --verbose` as shorthand for `bin/rt status -v`
[[ "$CMD" == "-v" || "$CMD" == "--verbose" ]] && { cmd_status --verbose; exit; }

case "$CMD" in
  status)  cmd_status "$@";;
  ram)     cmd_ram    "$@";;
  log)     cmd_log    "$@";;
  watch)   cmd_watch  "$@";;
  stop)    cmd_stop   "$@";;
  who)     cmd_who    "$@";;
  omlx)    cmd_omlx   "$@";;
  litellm) cmd_litellm "$@";;
  lms-context) cmd_lms_context "$@";;
  -h|--help|help)
    sed -n '2,28p' "$0"
    ;;
  *)
    die "unknown command: $CMD (run bin/rt --help)"
    ;;
esac
