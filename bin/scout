#!/usr/bin/env bash
# bin/scout — flag models present on disk (live discovery via each runtime's
# /v1/models) with no global agent config (~/.config/llmrun/agents.json) so
# adapters would run them unconfigured. Read-only: never edits
# ~/.config/llmrun/agents.json, and never deletes anything.
#
# The global-config check is the actual point: being downloaded/discoverable
# isn't "usable" — an adapter reading unset context/temperature from
# agents.json is the "why isn't this working?" trap ADAPTER-SETUP.md exists
# to prevent. bin/scout surfaces that gap; bin/sync closes it.
#
# Aimed at workshop participants and benchmarkers alike: `lms get` / `ollama
# pull` a model, then run `bin/scout` to see it's not wired up yet, and get a
# ready-to-run `bin/sync` command to fix that.
#
# Usage: bin/scout [--runtime lms,ollama] [--help]
set -uo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
source "$HERE/config.sh"; source "$HERE/lib/common.sh"; source "$HERE/bin/lib/help.sh"

RUNTIMES="lms,ollama"
# Recommended-for-local-models adapters (see docs/ADAPTER-SETUP.md) — a useful
# default set to suggest, wider than $DEFAULT_ADAPTERS (which is tuned for
# nightly bench runs, not "what should a new model be smoke-tested against").
DEFAULT_SYNC_AGENTS="${SCOUT_SYNC_AGENTS:-aider,cline,hermes,opencode,pi}"
# Per-agent PASS/FAIL/SKIP lines default to a small, fast subset (pi + opencode
# have real per-model config files worth checking on every run). Pass --agent
# to check a wider or different set, e.g. --agent aider,cline,hermes,opencode,pi.
SHOW_AGENTS="${SCOUT_SHOW_AGENTS:-pi,opencode}"

usage() {
  help_header "scout" "flag models on disk that aren't registered in the bench yet"
  help_section "USAGE"
  help_line "  bin/scout [OPTIONS]" ""
  help_section "OPTIONS"
  help_flag "--runtime" "LIST" "comma-separated: lms,ollama (default: lms,ollama)"
  help_flag "--agent" "LIST" "comma-separated agents to show per-agent checks for (default: pi,opencode)"
  help_flag "-h, --help" "" "show this help and exit"
  help_section "WHAT IT CHECKS"
  help_line "  no config   model discovered live (lms ls / ollama list) but has no entry" ""
  help_line "              in ~/.config/llmrun/agents.json -> prints a bin/sync command" ""
  help_line "              (adapters would run it with unset context/temperature)" ""
  help_line "  per-agent   for every discovered model, one PASS/FAIL/SKIP line per agent" ""
  help_line "              checking the actual config file it reads at launch" ""
  help_section "EXAMPLES"
  help_line "  bin/scout" ""
  help_line "  bin/scout --runtime lms" ""
  help_line "  bin/scout --agent aider,cline,hermes,opencode,pi" ""
}

while [ $# -gt 0 ]; do
  case "$1" in
    --runtime)       RUNTIMES="$2"; shift 2;;
    --agent)         SHOW_AGENTS="$2"; shift 2;;
    -h|--help)       usage; exit 0;;
    *) err "unknown option: $1"; echo; usage; exit 1;;
  esac
done

runtime_enabled() { [[ ",$RUNTIMES," == *",$1,"* ]]; }

# ── global agent config (~/.config/llmrun/agents.json) ──────────────────────
# Keyed by exact model id, same ids reported by each runtime's /v1/models.
# A model with zero keys set here is unconfigured — adapters fall back to
# their own defaults (often wrong context/temperature for that model).
CONFIG_STORE="${LLMRUN_AGENTS_STORE:-$HOME/.config/llmrun/agents.json}"
mapfile -t CONFIGURED_MODELS < <(
  [ -f "$CONFIG_STORE" ] && jq -r 'keys[]' "$CONFIG_STORE" 2>/dev/null
)
has_config() {
  local model="$1"
  printf '%s\n' "${CONFIGURED_MODELS[@]}" | grep -qxF "$model"
}

# ── per-agent model registration ─────────────────────────────────────────────
# Same config files bin/agents-config writes to. pi/caveman share a schema
# (providers.<runtime-key>.models[].id); opencode.jsonc is JSONC, read via the
# same node helper agents-config uses. aider/hermes/cline take --model
# directly at launch — no per-model list to check, so they're reported n/a.
OPENCODE_CFG="${OPENCODE_CFG:-$HOME/.config/opencode/opencode.jsonc}"
[ -f "$OPENCODE_CFG" ] || [ ! -f "${OPENCODE_CFG%.jsonc}.json" ] || OPENCODE_CFG="${OPENCODE_CFG%.jsonc}.json"
PI_LIVE_CFG="${PI_LIVE_CFG:-$HOME/.pi/agent/models.json}"
CAVEMAN_LIVE_CFG="${CAVEMAN_LIVE_CFG:-$HOME/.cave/agent/models.json}"

runtime_key() { [ "$1" = "ollama" ] && echo "ollama" || echo "lmstudio"; }

verbose_line() {
  local status="$1" model="$2" agent="$3" detail="$4"
  local color="$C_GRN"
  [ "$status" = "FAIL" ] && color="$C_RED"
  [ "$status" = "SKIP" ] && color="$C_DIM"
  printf '%s[%s]%s model: %-40s agent: %-10s %s\n' "$color" "$status" "$C_RST" "$model" "$agent" "$detail"
}

check_models_json_agent() {
  local agent="$1" cfg="$2" runtime="$3" model="$4"
  local rt_key; rt_key="$(runtime_key "$runtime")"
  if [ ! -f "$cfg" ]; then
    verbose_line "FAIL" "$model" "$agent" "config file missing: $cfg"
    return
  fi
  if jq -e --arg k "$rt_key" --arg m "$model" \
      '[.providers[$k].models[]?.id] | index($m) != null' "$cfg" >/dev/null 2>&1; then
    verbose_line "PASS" "$model" "$agent" "exists in $cfg"
  else
    verbose_line "FAIL" "$model" "$agent" "missing from $cfg (run: bin/sync ... --agent $agent)"
  fi
}

check_opencode_agent() {
  local runtime="$1" model="$2"
  local rt_key; rt_key="$(runtime_key "$runtime")"
  if [ ! -f "$OPENCODE_CFG" ]; then
    verbose_line "FAIL" "$model" "opencode" "config file missing: $OPENCODE_CFG"
    return
  fi
  local existing
  existing="$(node "$HERE/bin/lib/patch-jsonc-models.mjs" read "$OPENCODE_CFG" lmstudio ollama 2>/dev/null)"
  if printf '%s' "$existing" | jq -e --arg k "$rt_key" --arg m "$model" 'has($k) and (.[$k] | has($m))' >/dev/null 2>&1; then
    verbose_line "PASS" "$model" "opencode" "exists in $OPENCODE_CFG"
  else
    verbose_line "FAIL" "$model" "opencode" "missing from $OPENCODE_CFG (run: bin/sync ... --agent opencode)"
  fi
}

check_agent_registration() {
  local runtime="$1" model="$2"
  local agent
  IFS=',' read -ra _agents <<< "$SHOW_AGENTS"
  for agent in "${_agents[@]}"; do
    case "$agent" in
      pi)       check_models_json_agent pi "$PI_LIVE_CFG" "$runtime" "$model";;
      caveman)  check_models_json_agent caveman "$CAVEMAN_LIVE_CFG" "$runtime" "$model";;
      opencode) check_opencode_agent "$runtime" "$model";;
      *)        verbose_line "SKIP" "$model" "$agent" "no per-model list — launched with --model directly";;
    esac
  done
}

NOCONFIG_COUNT=0

note_no_config() {
  local runtime="$1" model="$2"
  ((NOCONFIG_COUNT++)) || true
  printf '%s# NOTE: no global config for %s (%s) — adapters will use unset context/temperature%s\n' "$C_YEL" "$model" "$runtime" "$C_RST"
  printf '%sbin/sync --provider %s --model %s --agent %s%s\n\n' \
    "$C_GRN" "$runtime" "$model" "$DEFAULT_SYNC_AGENTS" "$C_RST"
}

check_lms() {
  command -v lms >/dev/null 2>&1 || { warn "lms: not found, skipping"; return; }
  mapfile -t downloaded < <(lms ls --json 2>/dev/null | jq -r '.[].modelKey' 2>/dev/null)
  [ "${#downloaded[@]}" -gt 0 ] || { warn "lms: no models reported by 'lms ls --json' — is LM Studio running?"; }

  for m in "${downloaded[@]}"; do
    [ -n "$m" ] || continue
    has_config "$m" || note_no_config "lms" "$m"
    check_agent_registration "lms" "$m"
  done
}

check_ollama() {
  command -v ollama >/dev/null 2>&1 || { warn "ollama: not found, skipping"; return; }
  mapfile -t downloaded < <(runtime_models "$OLLAMA_BASE_URL")
  [ "${#downloaded[@]}" -gt 0 ] || { warn "ollama: no models reported — is the daemon running?"; }

  for m in "${downloaded[@]}"; do
    [ -n "$m" ] || continue
    has_config "$m" || note_no_config "ollama" "$m"
    check_agent_registration "ollama" "$m"
  done
}

runtime_enabled lms    && check_lms
runtime_enabled ollama && check_ollama

echo
info "per-agent checks shown for: $SHOW_AGENTS (rerun with: bin/scout --agent aider,cline,hermes,opencode,pi)"
info "$NOCONFIG_COUNT missing global config"
[ "$NOCONFIG_COUNT" -eq 0 ] || exit 1
exit 0
