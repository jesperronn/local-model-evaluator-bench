#!/usr/bin/env bash
# bin/lint-adapters — static checks for all adapter scripts.
#
# Checks:
#   1. Bash syntax (bash -n)
#   2. Bypass flags only inside non-interactive branches
#      Bypass flags that must never appear at top-level (outside [ ! -t 0 ]):
#        --yes-always, --dangerously-bypass-approvals-and-sandbox,
#        --allow-dangerously-skip-permissions, --auto-approve, --yolo,
#        --no-git, --no-auto-commits, --no-dirty-commits
#   3. Every agent with an adapter is recognized by bin/setup's --agent
#      (get_agent_cli_cmd/get_agent_install_cmd/get_agent_config_guidance)
#
# Exit 0 = all clean, exit 1 = failures found.
set -uo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
source "$HERE/lib/common.sh"
source "$HERE/bin/lib/help.sh"

BYPASS_PATTERN='--yes-always|--dangerously-bypass-approvals-and-sandbox|--allow-dangerously-skip-permissions|--auto-approve|--yolo|--no-git\b|--no-auto-commits|--no-dirty-commits|--no-ask-user|--allow-all-tools|--allow-all-paths'

show_help() {
  help_header "lint-adapters" "static checks for all adapter scripts"

  help_section "USAGE"
  help_line "  lint-adapters [OPTIONS]"

  help_section "DESCRIPTION"
  help_line "  Validates all adapter scripts in adapters/*.sh for:"
  help_line "    1. Bash syntax (bash -n)"
  help_line "    2. Bypass flags only inside non-interactive branches"
  help_line "    3. Agent registration in bin/setup's case statements"

  help_section "OPTIONS"
  help_flag "-h, --help" "" "show this help and exit"

  help_section "BYPASS FLAGS"
  help_line "  These flags are forbidden at top-level (must be inside [ ! -t 0 ] blocks):"
  help_line "    --yes-always --dangerously-bypass-approvals-and-sandbox"
  help_line "    --auto-approve --yolo --no-git --no-auto-commits --no-dirty-commits"

  help_section "EXIT CODES"
  help_line "  0  all checks passed"
  help_line "  1  one or more checks failed"
}

ok()   { printf '%s\n' "${C_GRN}[OK]${C_RST}   $*"; }
fail() { printf '%s\n' "${C_RED}[FAIL]${C_RST} $*"; }
warn() { printf '%s\n' "${C_YEL}[WARN]${C_RST} $*"; }

# Handle --help flag
for arg in "$@"; do
  case "$arg" in
    -h|--help) show_help; exit 0;;
  esac
done

failures=0

for adapter in "$HERE/adapters"/*.sh; do
  name="$(basename "$adapter")"

  # 1. Syntax check
  if ! bash -n "$adapter" 2>/tmp/lint-syntax-err; then
    fail "$name  syntax error: $(cat /tmp/lint-syntax-err)"
    failures=$((failures + 1))
    continue
  fi

  # 2. Bypass flags at top-level (outside any `if [ ! -t 0 ]` block)
  #    Strategy: strip lines inside if [ ! -t 0 ] ... fi blocks, then grep for bypass flags.
  #    We use awk: track depth when we enter/exit the non-interactive if-block.
  toplevel="$(awk '
    /if \[ ! -t 0 \]/ { depth++; next }
    depth > 0 && /^[[:space:]]*fi[[:space:]]*(#.*)?$/ { depth--; next }
    depth > 0 { next }
    { print }
  ' "$adapter")"

  if echo "$toplevel" | grep -qE -e "$BYPASS_PATTERN"; then
    bad_lines="$(echo "$toplevel" | grep -nE -e "$BYPASS_PATTERN")"
    fail "$name  bypass flag outside non-interactive branch:"
    echo "$bad_lines" | while IFS= read -r line; do
      printf '         %s%s%s\n' "${C_DIM}" "$line" "${C_RST}"
    done
    failures=$((failures + 1))
  else
    ok "$name"
  fi
done

# 3. Every agent that has an adapter must be recognized by bin/setup --agent.
#    get_available_agents() derives its list the same way (adapters/*.sh
#    filename prefix), so this only checks that bin/setup's hand-written
#    case statements haven't drifted from that list.
known_agents="$(awk '
  /^get_agent_cli_cmd\(\)/ { in_fn=1; next }
  in_fn && /^\}/ { exit }
  in_fn { print }
' "$HERE/bin/setup" | grep -oE '^[[:space:]]*[a-z0-9_-]+\)' | tr -d ') ')"

for agent in $(cd "$HERE/adapters" && ls -1 *.sh | sed -E 's/-(proxy-ollama|lms|mlx|omlx|ollama)\.sh$//; s/\.sh$//' | sort -u); do
  if ! echo "$known_agents" | grep -qxF "$agent"; then
    fail "agent '$agent' has an adapter but is missing from bin/setup's get_agent_cli_cmd/get_agent_install_cmd/get_agent_config_guidance"
    failures=$((failures + 1))
  fi
done

echo
if [ "$failures" -eq 0 ]; then
  printf '%s\n' "${C_GRN}${C_BLD}All adapters clean.${C_RST}"
else
  printf '%s\n' "${C_RED}${C_BLD}$failures adapter(s) failed.${C_RST}"
fi
exit "$([ "$failures" -eq 0 ] && echo 0 || echo 1)"
