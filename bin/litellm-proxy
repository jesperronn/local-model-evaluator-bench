#!/usr/bin/env bash
# Start a LiteLLM proxy in front of the local runtimes (lms | ollama | mlx | omlx).
#
# Optional. Adapters talk to the runtimes directly by default; this exists for
# when you want one endpoint that spans all four, e.g. pointing an external
# tool at a single URL, or A/B-ing the same model across backends.
#
#   bin/litellm-proxy            # foreground on $LITELLM_PORT (default 4444)
#   bin/litellm-proxy --check    # verify it's reachable, then exit
#
# Then route by prefixing the model id with the runtime:
#   curl "$LITELLM_BASE_URL/chat/completions" -d '{"model":"lms/ornith-1.0-9b",...}'
#   curl "$LITELLM_BASE_URL/chat/completions" -d '{"model":"omlx/Ornith-1.0-9B-4bit",...}'
#
#   bin/litellm-proxy --models   # list what the proxy currently resolves
#
# LOCAL ONLY: config-templates/litellm.yaml lists no cloud providers and no
# fallbacks. Keep it that way — a remote fallback would leak sandbox prompts and
# silently grade a different model than the result label claims.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$HERE/config.sh"

CONFIG="$HERE/config-templates/litellm.yaml"

# Point the wildcard routes at the same endpoints the adapters use, so the proxy
# and the direct path can never disagree about where a runtime lives.
export LITELLM_LMS_BASE="${LITELLM_LMS_BASE:-$LMS_BASE_URL}"
export LITELLM_OLLAMA_BASE="${LITELLM_OLLAMA_BASE:-$OLLAMA_BASE_URL}"
export LITELLM_MLX_BASE="${LITELLM_MLX_BASE:-http://127.0.0.1:8080/v1}"
export LITELLM_OMLX_BASE="${LITELLM_OMLX_BASE:-$OMLX_BASE_URL}"
export LITELLM_OMLX_KEY="${LITELLM_OMLX_KEY:-$OMLX_API_KEY}"

if [ "${1:-}" = "--check" ]; then
  if curl -fsS -m 3 "${LITELLM_BASE_URL%/v1}/health/readiness" >/dev/null 2>&1; then
    echo "litellm proxy: reachable at $LITELLM_BASE_URL"
    exit 0
  fi
  echo "litellm proxy: not reachable at $LITELLM_BASE_URL (start it with: bin/litellm-proxy)" >&2
  exit 1
fi

if [ "${1:-}" = "--models" ]; then
  # What the proxy actually resolves, grouped by route. With
  # check_provider_endpoint: true this is a live query of each backend, so a
  # missing group means that runtime is down — not that it has no models.
  curl -fsS -m 15 "$LITELLM_BASE_URL/models" 2>/dev/null \
    | jq -r '.data[].id' 2>/dev/null | sort \
    || { echo "litellm proxy: not reachable at $LITELLM_BASE_URL (start it with: bin/litellm-proxy)" >&2; exit 1; }
  exit 0
fi

command -v uvx >/dev/null 2>&1 || {
  echo "uvx not found — install uv: brew install uv" >&2; exit 1; }

# Pinned deliberately: litellm's own metadata under-constrains fastapi, and the
# default resolution imports a symbol newer fastapi dropped, so an unpinned
# `uvx litellm` dies at startup with ModuleNotFoundError: proxy_server.
exec uvx --python 3.12 --with 'fastapi<0.116' --from 'litellm[proxy]' \
  litellm --config "$CONFIG" --port "$LITELLM_PORT" --host 127.0.0.1
