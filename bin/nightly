#!/usr/bin/env bash
# bin/nightly — prepare and run nightly bench focusing on lms backend
# Usage:
#   bin/nightly                    # run with defaults (qwen3.6-35b, easy+medium cases)
#   bin/nightly --model qwen3-coder-30b
#   bin/nightly --all-cases        # include hard cases too
#   bin/nightly --devstral         # after qwen3.6-35b finishes, also run devstral2-small
#   bin/nightly --dry-run          # print commands without executing

set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$HERE/config.sh"; source "$HERE/lib/common.sh"; source "$HERE/bin/lib/help.sh"

PRIMARY_MODEL="qwen/qwen3.5-9b"
INCLUDE_DEVSTRAL=0
INCLUDE_HARD=0
DRY_RUN=0
TIER="32"

show_help() {
  help_header "nightly" "prepare and run nightly bench focusing on lms backend"

  help_section "USAGE"
  help_line "  nightly [OPTIONS]"

  help_section "DESCRIPTION"
  help_line "  Runs nightly benchmarks optimized for 32GB tier with sensible"
  help_line "  defaults and adapter presets. Results saved to results/."

  help_section "OPTIONS"
  help_flag "--model" "ID" "primary model to test (default: qwen/qwen3.5-9b)"
  help_flag "--tier" "T" "hardware tier size (default: 32)"
  help_flag "--devstral" "" "also run secondary devstral-small-2-2512 after primary"
  help_flag "--all-cases" "" "include hard cases (default: easy+medium only)"
  help_flag "--dry-run" "" "print commands without executing"
  help_flag "--help" "" "show this help and exit"

  help_section "EXAMPLES"
  help_line "  Run default nightly (qwen3.5-9b, easy+medium adapters):"
  help_line "  \$ nightly"
  help_line ""
  help_line "  Run with custom model and all difficulty tiers:"
  help_line "  \$ nightly --model meta-llama/llama-2-13b --all-cases"
  help_line ""
  help_line "  See the plan without executing:"
  help_line "  \$ nightly --dry-run"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --model) PRIMARY_MODEL="$2"; shift 2;;
    --tier) TIER="$2"; shift 2;;
    --devstral) INCLUDE_DEVSTRAL=1; shift;;
    --all-cases) INCLUDE_HARD=1; shift;;
    --dry-run) DRY_RUN=1; shift;;
    -h|--help) show_help; exit 0;;
    *) shift;;
  esac
done

echo "=== Nightly Bench Run (32GB Tier) ==="
echo "Primary model: $PRIMARY_MODEL"
echo "Time: $(date)"
echo ""

# Check if another agent is using the model (if qwen3.6-35b)
if [[ "$PRIMARY_MODEL" == *"qwen3.6-35b"* ]]; then
  if lms ps 2>/dev/null | grep -q "GENERATING"; then
    echo "⚠ WARNING: Another agent is currently using qwen3.6-35b-a3b (GENERATING state)"
    echo "   Bench will run but may slow that agent. Press Ctrl-C to abort."
    sleep 3
  fi
fi

# Build command: 32GB tier adapters (aider, cline, openhands, codex)
# Removed: caveman, copilot, goose, opencode, pi (external tools or missing deps)
# hermes requires special config — comment out if not configured
ADAPTERS="aider,cline,openhands,codex"

DIFFICULTY="easy,medium"
[ "$INCLUDE_HARD" -eq 1 ] && DIFFICULTY="easy,medium,hard"

echo "Difficulty tiers: $DIFFICULTY"
echo "Adapters: $ADAPTERS (lms backend only; skipping external tools)"
echo ""

if [ "$DRY_RUN" -eq 1 ]; then
  echo "=== Dry run plan ==="
  echo "Primary run:"
  echo "  bin/bench \\"
  echo "    --agent $ADAPTERS \\"
  echo "    --model $PRIMARY_MODEL \\"
  echo "    --difficulty $DIFFICULTY \\"
  echo "    --timeout 300 \\"
  echo "    --warmup 180 \\"
  echo "    --stall 120"
  if [ "$INCLUDE_DEVSTRAL" -eq 1 ]; then
    echo ""
    echo "Secondary run:"
    echo "  bin/bench \\"
    echo "    --agent $ADAPTERS \\"
    echo "    --model mistralai/devstral-small-2-2512 \\"
    echo "    --difficulty $DIFFICULTY \\"
    echo "    --timeout 300 \\"
    echo "    --warmup 180 \\"
    echo "    --stall 120"
  fi
  exit 0
fi

# Run primary model (qwen3.6-35b or specified)
echo "Starting primary run with $PRIMARY_MODEL..."
bin/bench \
  --agent "$ADAPTERS" \
  --model "$PRIMARY_MODEL" \
  --difficulty "$DIFFICULTY" \
  --timeout 300 \
  --warmup 180 \
  --stall 120

if [ "$INCLUDE_DEVSTRAL" -eq 1 ]; then
  echo ""
  echo "=== Secondary run: devstral-small-2-2512 ==="
  sleep 2

  bin/bench \
    --agent "$ADAPTERS" \
    --model "mistralai/devstral-small-2-2512" \
    --difficulty "$DIFFICULTY" \
    --timeout 300 \
    --warmup 180 \
    --stall 120
fi

echo ""
echo "=== Nightly bench complete ==="
echo "Results saved to results/"
ls -lth results/results.csv 2>/dev/null | head -1
