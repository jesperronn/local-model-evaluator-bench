#!/usr/bin/env bash
# bin/verify — Workshop A step-by-step: server up? models listed? model loaded? model callable?
#             — or, with --agent, is a terminal coding agent (pi, opencode) wired up?
#
# Unlike bin/doctor (full environment audit for this repo), this is a minimal,
# narrated walkthrough for workshop participants: each step prints the exact
# command before running it, then reports [PASS]/[FAIL]. Meant to be read
# along with the terminal output, not just run silently.
set -uo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
source "$HERE/config.sh"; source "$HERE/lib/common.sh"; source "$HERE/bin/lib/help.sh"

RUNTIME="lms"
VERBOSE=0
MODEL=""
AGENT=""

show_help() {
  help_header "verify" "step-by-step check: server, models, load, call — for workshop participants"
  help_section "USAGE"
  help_line "  verify [--runtime lms|ollama|mtplx] [--model ID] [--verbose]"
  help_line "  verify --agent pi|opencode [--runtime lms|ollama|mtplx] [--model ID] [--verbose]"
  help_section "OPTIONS"
  help_flag "--runtime" "lms|ollama|mtplx" "engine to verify against (default: lms)"
  help_flag "--lms" "" "shorthand for --runtime lms (default)"
  help_flag "--ollama" "" "shorthand for --runtime ollama"
  help_flag "--mtplx" "" "shorthand for --runtime mtplx"
  help_flag "--agent NAME" "" "instead of the raw engine, verify an agent CLI: pi | opencode"
  help_flag "--model ID" "" "model to load/call (default: small qwen3.5-9b for lms, qwen2.5-coder:7b for ollama)"
  help_flag "--verbose" "" "print each command before running it"
  help_flag "-h, --help" "" "show this help and exit"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --runtime) RUNTIME="$2"; shift 2;;
    --lms) RUNTIME="lms"; shift;;
    --ollama) RUNTIME="ollama"; shift;;
    --mtplx) RUNTIME="mtplx"; shift;;
    --agent) AGENT="$2"; shift 2;;
    --model) MODEL="$2"; shift 2;;
    --verbose) VERBOSE=1; shift;;
    -h|--help) show_help; exit 0;;
    *) err "unknown option: $1"; echo; show_help; exit 1;;
  esac
done

case "$RUNTIME" in lms|ollama|mtplx) ;; *) die "unknown --runtime: $RUNTIME (valid: lms, ollama, mtplx)";; esac

if [ "$RUNTIME" = "lms" ]; then
  BASE_URL="$LMS_BASE_URL"
  MODEL="${MODEL:-qwen/qwen3.5-9b}"
elif [ "$RUNTIME" = "mtplx" ]; then
  BASE_URL="$MTPLX_BASE_URL"
  MODEL="${MODEL:-}"
else
  BASE_URL="$OLLAMA_BASE_URL"
  MODEL="${MODEL:-qwen2.5-coder:7b}"
fi

# Print the command (if --verbose), then run it. Keeps the narration and the
# execution in lockstep so participants can follow along in the terminal.
run() {
  [ "$VERBOSE" -eq 1 ] && printf '%s $ %s\n' "${C_DIM}»${C_RST}" "$*" >&2
  "$@"
}

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then C_ORG=$'\033[38;5;208m'; else C_ORG=; fi
step() { echo; printf '%s\n' "${C_BLU}==>${C_RST} ${C_BLD}${C_ORG}Step $1/$STEP_TOTAL: $2${C_RST}"; }

if [ -n "$AGENT" ]; then

  case "$AGENT" in
    pi|opencode) ;;
    *) die "unknown --agent: $AGENT (expected: pi | opencode)";;
  esac

  ADAPTER="$HERE/adapters/${AGENT}-${RUNTIME}.sh"
  [ -f "$ADAPTER" ] || die "no adapter for $AGENT + $RUNTIME: $ADAPTER"

  STEP_TOTAL=4
  N=0
  next_step() { N=$((N + 1)); step "$N" "$1"; }

  # ── Step: CLI installed ─────────────────────────────────────────────────────
  next_step "check $AGENT is installed"
  if run command -v "$AGENT" >/dev/null 2>&1; then
    ok "$AGENT found: $(command -v "$AGENT")"
  else
    err "$AGENT not found on PATH"
    case "$AGENT" in
      pi) err "install with: npm install -g @earendil-works/pi-coding-agent";;
      opencode) err "install with: npm install -g opencode-ai";;
    esac
    exit 1
  fi

  # ── Step: config on disk ─────────────────────────────────────────────────────
  # Neither pi (~/.pi/agent/models.json) nor opencode
  # (~/.config/opencode/opencode.json(c)) create or point their own config at
  # your local server — without it they fail with an opaque "unknown provider"
  # or UnknownError instead of a clear connection error. Seed/patch it via
  # bin/agents-config before ever invoking the adapter. Matters most in a
  # fresh environment (e.g. the Docker container) with no prior agent config.
  next_step "ensure $AGENT config points at $RUNTIME"
  case "$AGENT" in
    opencode)
      OPENCODE_CFG_JSON="$HOME/.config/opencode/opencode.json"
      OPENCODE_CFG_JSONC="$HOME/.config/opencode/opencode.jsonc"
      if [ ! -f "$OPENCODE_CFG_JSON" ] && [ ! -f "$OPENCODE_CFG_JSONC" ]; then
        info "no opencode config found — seeding one at $OPENCODE_CFG_JSON"
        mkdir -p "$HOME/.config/opencode"
        cp "$HERE/config-templates/opencode.json" "$OPENCODE_CFG_JSON"
      fi
      ;;
    pi)
      PI_LIVE_CFG="$HOME/.pi/agent/models.json"
      if [ ! -f "$PI_LIVE_CFG" ]; then
        info "no pi config found — seeding one at $PI_LIVE_CFG"
        mkdir -p "$(dirname "$PI_LIVE_CFG")"
        cp "$HERE/config-templates/pi-agent-models.json" "$PI_LIVE_CFG"
      fi
      ;;
  esac
  # --settings-only: only patch the endpoint/API-key, don't re-sync the model
  # list from `lms ls`/`ollama list` — those native CLIs aren't available in
  # every environment (e.g. inside the Docker container), and re-syncing with
  # no CLI to query wipes the model list to empty, which pi then reports as
  # an unknown provider instead of a clear error.
  printf '%s $ %s\n' "${C_DIM}»${C_RST}" "bin/agents-config --write --settings-only --agent $AGENT" >&2
  if "$HERE/bin/agents-config" --write --settings-only --agent "$AGENT" >/tmp/.verify-agent-config.log 2>&1; then
    ok "$AGENT config written to disk"
  else
    err "failed to write $AGENT config — see /tmp/.verify-agent-config.log"
    exit 1
  fi

  # ── Step: try it interactively ──────────────────────────────────────────────
  next_step "try $AGENT interactively (do this yourself in another terminal)"
  case "$AGENT" in
    pi) INTERACTIVE_CMD="pi --provider lmstudio --model $MODEL";;
    opencode) INTERACTIVE_CMD="opencode --model lmstudio/$MODEL";;
  esac
  printf '%s $ %s\n' "${C_DIM}»${C_RST}" "$INTERACTIVE_CMD"
  info "opens the $AGENT TUI against your loaded model — poke around, ask it to explain a file, Ctrl-C to quit"
  ok "example printed — run it yourself, then continue"

  # ── Step: automated smoketest (simplified project case) ────────────────────
  next_step "run smoketest: $AGENT writes hello.txt from a one-line task"
  SANDBOX="$(mktemp -d)"
  trap 'rm -rf "$SANDBOX"' EXIT
  TASK_FILE="$HERE/cases/smoke-00-hello/task.md"
  [ -f "$TASK_FILE" ] || die "missing case: $TASK_FILE"
  info "task (from cases/smoke-00-hello/task.md):"
  sed 's/^/    /' "$TASK_FILE"
  printf '%s $ %s\n' "${C_DIM}»${C_RST}" "cat cases/smoke-00-hello/task.md | MODEL_ID=$MODEL $(basename "$ADAPTER")"
  ( cd "$SANDBOX" && MODEL_ID="$MODEL" run_timeout 120 "$ADAPTER" <"$TASK_FILE" >/tmp/.verify-agent.log 2>&1 )
  if [ -f "$SANDBOX/hello.txt" ] && grep -qx "OK" "$SANDBOX/hello.txt"; then
    ok "$AGENT created hello.txt with the right content"
  else
    err "$AGENT did not produce the expected hello.txt — see /tmp/.verify-agent.log"
    exit 1
  fi

  echo
  ok "$AGENT verified against $RUNTIME + $MODEL — try it on your own project next"
  exit 0
fi

STEP_TOTAL=4

# ── Step 1: server responds ──────────────────────────────────────────────────
step 1 "verify $RUNTIME server responds"
if run curl -fsS --max-time 5 "$BASE_URL/models" >/tmp/.verify-models.json 2>&1; then
  ok "server reachable at $BASE_URL"
else
  err "server not reachable at $BASE_URL"
  if [ "$RUNTIME" = "lms" ]; then err "start it with: lms server start"
  elif [ "$RUNTIME" = "mtplx" ]; then err "start it with: mtplx quickstart --port 8001 --model <model>"
  else err "start it with: ollama serve"
  fi
  exit 1
fi
[ "$RUNTIME" = "mtplx" ] && [ -z "$MODEL" ] && die "--model is required for --runtime mtplx (no default model)"

# ── Step 2: list models ──────────────────────────────────────────────────────
step 2 "list available models"
if [ "$RUNTIME" = "lms" ]; then
  run lms ls
else
  run curl -fsS "$BASE_URL/models" | jq -r '.data[].id'
fi
ok "models listed"

# ── Step 3: load a model ─────────────────────────────────────────────────────
step 3 "load model: $MODEL"
if [ "$RUNTIME" = "lms" ]; then
  [ "$VERBOSE" -eq 1 ] && printf '%s $ %s\n' "${C_DIM}»${C_RST}" "lms load $MODEL --yes" >&2
  lms load "$MODEL" --yes 2>&1 | tr '\r' '\n' | grep -v '^Loading' >&2
  if [ "${PIPESTATUS[0]}" -eq 0 ]; then
    ok "$MODEL loaded"
  else
    err "failed to load $MODEL"; exit 1
  fi
elif [ "$RUNTIME" = "mtplx" ]; then
  # MTPLX is a multi-model server addressed like oMLX — no separate load step.
  ok "$MODEL is served by MTPLX (no separate load step)"
else
  # Ollama loads a model into memory on first use; a tiny generate call warms it.
  if run curl -fsS "$BASE_URL/../api/generate" -d "{\"model\":\"$MODEL\",\"prompt\":\"hi\",\"stream\":false}" >/dev/null; then
    ok "$MODEL loaded"
  else
    err "failed to load $MODEL — try: ollama pull $MODEL"; exit 1
  fi
fi

# ── Step 4: call the model ───────────────────────────────────────────────────
step 4 "call the model (streaming HTTP request)"
CHAT_BODY="{\"model\": \"$MODEL\", \"messages\": [{\"role\": \"user\", \"content\": \"Ping\"}], \"stream\": true}"
printf '%s $ %s\n' "${C_DIM}»${C_RST}" "curl -fsS -N $BASE_URL/chat/completions -H 'Content-Type: application/json' -d '$CHAT_BODY'" >&2

GOT_CONTENT=0
while IFS= read -r LINE; do
  LINE="${LINE#data: }"
  [ "$LINE" = "[DONE]" ] && break
  [ -z "$LINE" ] && continue
  CHUNK=$(printf '%s' "$LINE" | jq -r '.choices[0].delta.content // empty' 2>/dev/null) || continue
  if [ -n "$CHUNK" ]; then
    [ "$GOT_CONTENT" -eq 0 ] && { ok "model responding"; GOT_CONTENT=1; }
    printf '%s%s%s' "$C_DIM" "$CHUNK" "$C_RST"
  fi
done < <(curl -fsS -N "$BASE_URL/chat/completions" \
  -H "Content-Type: application/json" \
  -d "$CHAT_BODY")

echo

if [ "$GOT_CONTENT" -eq 0 ]; then
  err "no response from model"; exit 1
fi

echo
ok "all steps passed — $RUNTIME + $MODEL ready for agentic clients"
