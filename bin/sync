#!/usr/bin/env bash
# bin/sync — register one downloaded model with the bench.
#
# The one-liner bin/scout prints for every "not registered globally" model.
# Meant for workshop participants and benchmarkers alike. Registration only —
# no model load, no smoke test (that's a deliberate separate step, since it's
# slow and not everyone wants it right away). See the "Next step" it prints.
#
# Usage: bin/sync --provider lms --model <id> [--agent opencode,pi] [--dry-run]
set -uo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
source "$HERE/config.sh"; source "$HERE/lib/common.sh"; source "$HERE/bin/lib/help.sh"

PROVIDER=""; MODEL=""; AGENTS="${DEFAULT_ADAPTERS:-pi}"; DRY_RUN=0

usage() {
  help_header "sync" "register a downloaded model with the bench"
  help_section "USAGE"
  help_line "  bin/sync --provider lms --model <id> [--agent a,b] [--dry-run]" ""
  help_section "OPTIONS"
  help_flag "--provider" "NAME" "lms | ollama (required)"
  help_flag "--model" "ID" "exact model id, as shown by 'lms ls' / 'ollama list' (required)"
  help_flag "--agent" "a,b" "adapters to suggest for the next-step smoke test (default: \$DEFAULT_ADAPTERS = $DEFAULT_ADAPTERS)"
  help_flag "--dry-run" "" "print what would happen, change nothing"
  help_flag "-h, --help" "" "show this help and exit"
  help_section "WHAT IT DOES"
  help_line "  1. Seeds ~/.config/llmrun/agents.json with recommended settings for this model" ""
  help_line "     (via bin/suggest-tuning | llmrun agents config apply --write; needs a model" ""
  help_line "     card under docs/models/ to have anything to suggest — best-effort)" ""
  help_line "  2. Runs bin/agents-config --write --agent <agents> so pi/opencode/caveman" ""
  help_line "     actually list this model in their own config (the file each agent reads" ""
  help_line "     at launch — this is the step bin/scout's per-agent check verifies)" ""
  help_line "  Does NOT load the model or run a smoke test — that's slow, so it's a" ""
  help_line "  separate next step this command prints for you." ""
  help_section "EXAMPLES"
  help_line "  bin/sync --provider lms --model qwen/qwen3.5-9b --agent opencode,pi" ""
}

while [ $# -gt 0 ]; do
  case "$1" in
    --provider) PROVIDER="$2"; shift 2;;
    --model)    MODEL="$2"; shift 2;;
    --agent)    AGENTS="$2"; shift 2;;
    --dry-run)  DRY_RUN=1; shift;;
    -h|--help)  usage; exit 0;;
    *) err "unknown option: $1"; echo; usage; exit 1;;
  esac
done

[ -n "$PROVIDER" ] || die "--provider is required (lms or ollama)  (tip: run bin/scout to discover unregistered models)"
[ -n "$MODEL" ]    || die "--model is required  (tip: run bin/scout to discover unregistered models)"
case "$PROVIDER" in
  lms|ollama) ;;
  *)      die "unknown --provider: $PROVIDER (valid: lms, ollama)";;
esac

info "provider=$PROVIDER model=$MODEL agent(s)=$AGENTS"

# ── 1. seed global agent config (context/temperature/etc, best-effort) ──────
if command -v llmrun >/dev/null 2>&1; then
  if [ "$DRY_RUN" = "1" ]; then
    info "[dry-run] would run: bin/suggest-tuning '$MODEL' | llmrun agents config apply <plan> --write"
  else
    _plan="$(mktemp)"
    "$HERE/bin/suggest-tuning" "$MODEL" > "$_plan" 2>/dev/null
    if [ -s "$_plan" ] && llmrun agents config apply "$_plan" --write >/dev/null 2>&1; then
      ok "seeded ~/.config/llmrun/agents.json for $MODEL"
    else
      warn "could not seed agents.json (non-fatal, continuing)"
    fi
    rm -f "$_plan"
  fi
else
  warn "llmrun not on PATH — skipping agents.json seeding (run bin/build-llmrun first)"
fi

# ── 2. write per-agent config (pi/opencode/caveman model lists) ─────────────
# This is the actual registration step bin/scout's per-agent check verifies —
# without it, agents.json can be up to date while pi/opencode still have no
# idea the model exists.
if [ "$DRY_RUN" = "1" ]; then
  info "[dry-run] would run: bin/agents-config --write --agent $AGENTS"
  exit 0
fi

info "running bin/agents-config --write --agent $AGENTS"
"$HERE/bin/agents-config" --write --agent "$AGENTS" >/dev/null 2>&1 \
  && ok "synced pi/opencode/caveman config for installed models" \
  || warn "bin/agents-config reported an issue — run it directly to see details"

ok "$MODEL is registered"
echo
info "Next step — prove it actually works (loads the model, takes a bit):"
echo "  bin/smoke --runtime $PROVIDER --model $MODEL --agent $AGENTS"
